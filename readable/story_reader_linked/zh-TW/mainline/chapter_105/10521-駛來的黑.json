  "segments": [
    {
      "script_id": "100530",
      "internal_title": "第五章5-21",
      "items": [
        {
          "kind": "title_card",
          "text": "駛來的黑"
        },
        {
          "kind": "dialogue",
          "speaker": "星銻",
          "text": "維爾汀，你終於出來了！"
        },
        {
          "kind": "dialogue",
          "speaker": "星銻",
          "text": "重塑之手的歹徒突然像地鼠一樣層出不窮，我和紅弩箭沒法把他們全攔下來！"
        },
        {
          "kind": "dialogue",
          "speaker": "星銻",
          "text": "如果不是你叮囑我不能主動攻擊，我早就動手了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一個發狂的門徒尖叫著撲來，被紅弩箭結結實實地放倒在地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他的四肢抽搐著，很快變得乾癟下去。"
        },
        {
          "kind": "dialogue",
          "speaker": "紅弩箭",
          "text": "該死，這些傢伙寧可被吸乾血液也要攻擊，已經完全瘋了！"
        },
        {
          "kind": "dialogue",
          "speaker": "紅弩箭",
          "text": "還在廣場盯梢時我就告訴過十四行詩，別信什麼所謂的和平協定，那些滿口數字的幾何腦袋和腦門流油的重塑之手總有一個會先開始發瘋。"
        },
        {
          "kind": "dialogue",
          "speaker": "紅弩箭",
          "text": "至少他們做數學題時看著還算正常——天殺的！"
        },
        {
          "kind": "dialogue",
          "speaker": "紅弩箭",
          "text": "你們在地下到底發生了什麼？！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……這個地下洞穴就是免疫“暴雨”的關鍵。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "這個島嶼擁有和箱子一樣的遺跡，重塑之手是為了搶奪這個基地而來的！"
        },
        {
          "kind": "dialogue",
          "speaker": "星銻",
          "text": "什麼！？可是——"
        },
        {
          "kind": "dialogue",
          "speaker": "紅弩箭",
          "text": "可是那傢伙不也戴上石環了嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "紅弩箭",
          "text": "就算她自己有遮罩石環的辦法，也不可能一直讓手下做自殺式襲擊！"
        },
        {
          "kind": "dialogue",
          "speaker": "紅弩箭",
          "text": "既然她也簽署了永不開戰的和平協定，又要怎麼從阿派朗學派手裡搶走基地？！"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "維爾汀。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "背上的37睜開了眼睛。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她伸出一根手指，指向遠方的天空。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在那永恆超驗的天幕之上，亮起了一排過分明亮的耀星。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "……那是什麼？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "傳道者之廳內萬籟俱寂。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "只有訪客還在翻閱著古老的書籍。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "……您在這裡逗留太久了，阿爾卡納小姐。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "即使您給予過學派很多幫助，也請您注意訪客的立場。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "請放心，我從不想挑起無謂的紛爭……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "只是想要請教一個簡單的問題。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她輕輕地合上了書頁。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "偉大的智者們……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "你們奉行古老的智慧，遵循先賢的教導，堅守高貴的品德。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "數千年來，置身事外，離群索居。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "不被人類理解，也不尋求理解。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "……我很喜歡這個洞穴的寓言。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "但您是否想過……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾卡納",
          "text": "是誰把我們放逐進了洞穴之中？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "耀星不斷逼近。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "井然有序，如雨燕回巢。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "這是什麼……？我從來沒有見過。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "為什麼它會出現在這裡？"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "這樣的東西，不應該存在於這個島上。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "——37！不！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "永恆回歸的洋流被阻斷了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在那恪守緘默的海面上……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一艘黑色軍艦正劃破海浪，朝島嶼駛來。"
        },
        {
          "kind": "dialogue",
          "speaker": "蘇菲亞",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "蘇菲亞",
          "text": "……十四行詩。"
        },
        {
          "kind": "dialogue",
          "speaker": "蘇菲亞",
          "text": "你們把人類的軍隊帶到了這裡？"
        },
        {
          "kind": "title_card",
          "text": "THE END"
        }
      ]
    }
  ],
  "fallback_fields": []
}