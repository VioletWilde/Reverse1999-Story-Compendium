  "segments": [
    {
      "script_id": "100518",
      "internal_title": "第五章5-12.1",
      "items": [
        {
          "kind": "title_card",
          "text": "雀鳥的行徑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "學派成員陸陸續續地進入到會場內。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "被告人與辯護人也早已在各自的位置上落坐。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……"
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "……你還好嗎？",
          "edge_label": "…大丈夫？",
          "branch": []
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……請不用擔心，司辰，我會為自己辯護。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她臉色蒼白，但仍堅定地目視前方。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "在基金會，我曾贏下一場類似的公開辯論……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "這都是我的責任，我不會讓它影響到司辰的調查。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "十四行詩……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行詩沉默著低下頭，毅然走向傳道廳的中央。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "——一如她曾經歷的某時某刻。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "廳堂之中，法官端坐其上。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "……按理來說，我們應該直接賜予十四行詩小姐一杯鴆酒，讓她永遠保持沉默。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "但蘇菲亞提出了異議。仔細斟酌後，我認為有必要召開一次公民大會，做出民主表決。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "同意處死破戒者的人，什麼都不用做；同意減刑的人，請把卵石丟進大廳中央的石甕。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "現在，十四行詩小姐，維爾汀小姐，你們可以提交證明了。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "——直至這個沙漏流盡。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "是的，這不是一場沒有把握的戰爭。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "放輕鬆，深呼吸。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "像訓練的那樣。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我是來自聖洛夫基金會的十四行詩。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我懇請諸位基於人道主義的原則，聆聽我的請求——"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "你是什麼數字？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一聲尖銳的質問從台下傳來。"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "請辯護人回答，你的具體數字是什麼？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "什麼……我？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "不，我還沒有自己的數字……"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "無需再聽了，沒有數字之人無法踏入真理的殿堂！"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "她的一切發言已形同無效！應當直接判處死刑！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人群發出一片贊同聲。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "法官敲響了石鐘。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "42的證明有效。辯護人，有什麼要反駁的嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……什麼，有效？！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行詩的臉色無比蒼白。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "所有的形式正義、程式公平、類比練習在這一刻都失效了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "這是她從未涉足過的領域。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "我反對！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一個嬌小的身影從台下站了起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "按照記載，學派上次動用極刑是在1980年，賜死一個吃豆子的外來者。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "他食用了吃豆子的卡邦克魯，因此按照集合論，他被賜死了！"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "在所有教典裡，吃豆子都是最大、最壞的惡行。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "如果打破緘默也要被賜以死刑，那吃豆子的罪惡不就被降級了嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "我主張減輕對十四行詩的刑罰！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人群發出一片喧嘩聲。"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅱ",
          "text": "……她選了一個很聰明的切入點……"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "37的證明有效，辯論繼續。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "37志得意滿地坐下。隨即，一個懶洋洋的高大身影站了起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "210",
          "text": "我反對。"
        },
        {
          "kind": "dialogue",
          "speaker": "210",
          "text": "吃豆子的極刑是將罪人丟入永恆回歸的戈爾貢洋流中，而打破緘默的極刑則是賜予鴆酒讓其永保沉默。"
        },
        {
          "kind": "dialogue",
          "speaker": "210",
          "text": "在所有刑罰裡，沒有任何一項比前者更加可怖。"
        },
        {
          "kind": "dialogue",
          "speaker": "210",
          "text": "因為我們瞭解最少的是永恆和無限，因此一切刑罰中最恐怖的也是永恆和無限。"
        },
        {
          "kind": "dialogue",
          "speaker": "210",
          "text": "賜予鴆酒並不會讓吃豆子的罪惡下降，37的辯論無效。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "石鐘未被敲響，反對就先聲而至。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "反對！這二者在參考系裡的落點等同，都是死亡！"
        },
        {
          "kind": "dialogue",
          "speaker": "210",
          "text": "反對！你的說法違背最基礎的不可通約性！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "辯論逐漸白熱化。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人群也愈發躁動起來，石甕裡已經有了不少卵石。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……怎麼回事……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我……完全理解不了這場……非理性的辯論，我……"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……我明白了，原來是這樣。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……司辰？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "不用擔心，我會幫你的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "平復呼吸，抬起右手。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "這是抽象的論戰。無關乎現實，無關乎正義，無關乎理性。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "只關乎贏。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我——反對！"
        }
      ]
    },
    {
      "script_id": "100519",
      "internal_title": "第五章5-12.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "排中律……出色的詭辯，你竟然能揪著一句話製造出悖論。"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "但很可惜，你犯了一個致命的錯誤。"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "你接受了我的觀點，作為一切辯護的基礎：沒有數字之人無法踏入真理的殿堂。"
        },
        {
          "kind": "dialogue",
          "speaker": "教眾Ⅰ",
          "text": "你也沒有數字，外來者小姐。根據這句基本前提，我可以視你剛剛的所有發言為無效！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
