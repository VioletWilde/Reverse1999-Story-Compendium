{
  "episode_id": 10817,
  "chapter_id": 108,
  "chapter_title": "憂鬱的熱帶",
  "display_label": "",
  "title": "離群的黑羊",
  "subtitle": "寧願逃入荒野，也不要回到淒冷的羊群。",
  "trails": [
    {
      "element_id": 1081701,
      "owner_episode_id": 10817,
      "trigger_episode_id": null,
      "title": "往日的分徑-天使娜娜",
      "description": "",
      "action": "",
      "unlock_condition": "EpisodeFinish=817",
