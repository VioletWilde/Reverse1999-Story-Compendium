  "segments": [
    {
      "script_id": "100829",
      "internal_title": "第八章8-19.1",
      "items": [
        {
          "kind": "title_card",
          "text": "賭局"
        },
        {
          "kind": "title_card",
          "text": "悲傷聖母教堂"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "莊園之主嘆息著。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我等著和芝諾握手言歡，消除今天這個小小的誤會。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "傷害您對我沒有任何益處，就像聖保羅這座城市，像這個終將被“暴雨”沖刷而去的虛假的時代。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我希望能夠和平地把您交還給您的朋友，正如他們也會和平地把我的朋友還給我。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "對不信者，我們有耐心，他們只是沒意識到自己是被天光照耀的孩子。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "終有一天，他們會棄暗投明，如同不久前加入我們的芝諾朋友。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "而背信者……啊，背信者必須死。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "異端與棄誓之人最為可恨。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "但我很好奇，是什麼人攻擊了莊園？"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "是誰打擾了天使兄弟會與偉大重塑之手的使者會面？"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "還在這裡……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他踢開腳下的碎石。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "抓走了我的朋友。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "魔藥將盲眼女士的喉嚨鎖住，讓她出不了聲。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "馬坎多或許會把貧民區的事情搞砸，我毫不懷疑，但無妨。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他轉過身去，留給醫生一個背影。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "只要他能招來源源不斷的年輕人，只要神秘學家同胞們依然願意走向我們。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "馬坎多這樣的人就有用處。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "在他被“暴雨”吞沒前，物盡其用。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "芝諾不也是這樣使用他們的“貨幣”——可憐的士兵們的嗎，醫生？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不願被白白消耗的硬幣逃離了賭桌，卻又滾向另一張桌子。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "這世界不過是一座巨大的賭場，除了上桌，籌碼別無選擇。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他望向醫生。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "至少，重塑之手會許諾給他們未來，真正的未來。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "“受苦者”必將重生。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "天使兄弟會將隨我駛向南方，成為祂的信眾，接受祂的試煉，承蒙祂的恩典。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他貼近盲眼女士，在其耳旁低語。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "無論這張牌桌被清洗多少次，我們都會在祂的庇護下屹立。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我們是不朽的。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "此即昨日，女士。"
        },
        {
          "kind": "title_card",
          "text": "上校莊園"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "孤身潛入莊園的洛佩拉觀察著莊園守衛的動向，發現人比預想中更少。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "七八個人，沒法闖過去，可惡……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身後傳來腳步聲，像穿過草叢的蛇蟒，小心翼翼向她靠近。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "什麼人——？！"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "聖母在上，可算找到了，哈哈，沒想到是我吧！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一個意料之外的夥伴。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "鄧肯？但你怎麼知道我在這裡……"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "噓，別出聲。榮軍院的朋友都跟我說了。"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "你的司辰朋友送來聯絡，說你一個人被安排來了莊園。"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "啊，看看這裡，多美的綠色啊。你的目標是那座教堂嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "綠影之外，教堂矗立在荒涼的日光之下。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "如果醫生就在那裡的話，我得闖進去看看。"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "怎麼打算？在這裡等援軍嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "援軍？不，當然是給老爹和司辰一個驚喜。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "巡邏的守衛看護著通往教堂的路。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "老夥計，你敢跟我一起上嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老夥計用行動做出了答覆。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他轉下墨鏡，舉起吹管——"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "給我兩根吹箭。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "好，你弄開守衛，我去教堂看看。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "煉金師顛顛坩堝，神秘術驅動的爐火開始燃燒，倒出幾根細針般的毒箭，遞給老夥計。"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "我去那邊，你盯緊機會過去，對面的林子能藏住你。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老人蹲下身子，對準一個倒楣守衛的脖子——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "咻——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中箭的小子立刻倒下。"
        },
        {
          "kind": "dialogue",
          "speaker": "兄弟會守衛",
          "text": "林子裡有人！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "警報聲隨之響起。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "把他們往河邊帶。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老鄧肯接過同伴遞來的煙霧爆彈。"
        },
        {
          "kind": "dialogue",
          "speaker": "鄧肯先生",
          "text": "小夥子們，來點刺激的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "爆彈在空中劃出一道弧線，老鄧肯的吹箭刺破了這顆灰色小球。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "幹得漂亮！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "守衛被引開後，她舉著槍，走近莊園中央的廢棄教堂……"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "啊，有人來救您了，女士。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "這並不讓我意外。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "莊園之主注視著被吊起的盲眼女士。在他手中，捏著一個小小的、不起眼的控制按鈕。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他不介意將這裡化成一片真正的瓦礫堆。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "醫生——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "營救者的呼喊迴盪在教堂高高的屋頂之下。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "喔？是你？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "那位在船上有過一局之緣的小賭徒。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "在船上的時候我就該一槍把你腦袋開洞。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "你走到了一張錯誤的賭桌上。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "哼，怎麼，贏家會得到德洛絲醫生嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她走向佈道臺上的敵人。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "莊園之主張開雙臂——"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "不，什麼也不會得到。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我們都是風中的塵土。"
        }
      ]
    },
    {
      "script_id": "100830",
      "internal_title": "第八章8-19.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "洛佩拉打空了子彈，卸掉左輪槍，衝上去徒手追擊受傷的對手。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "看來贏的還是我。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她踢倒已經無力的桑托斯，扼住脖子，另一隻拳頭停在空中——"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "是的，你贏了賭局。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他倒在瓦礫堆中，嘴角流血，面對洛佩拉即將落下的拳頭，卻微笑起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "但賭桌呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "別了，小賭徒。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "什麼？！"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "如果你覺得，我比你那位盲眼的朋友更重要的話……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "桑托斯按響按鈕，爆炸聲與震落的牆磚一同襲來。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "只是對手的一瞬遲疑，桑托斯奮盡力氣，踢開洛佩拉。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隨後便在爆炸的混亂中，自告解室隱匿而去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "留下聖像倒塌，燭火熄滅。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "該死的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她忍住疼痛，咬牙跑向佈道台，救下被綁著的盲眼醫生。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "醫生試圖開口，但魔藥的效力依然封鎖著她的喉嚨。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "有話回去再說。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她背起醫生，艱難穿過碎石與爆炸引起的濃煙，撤出正在崩塌的教堂。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}