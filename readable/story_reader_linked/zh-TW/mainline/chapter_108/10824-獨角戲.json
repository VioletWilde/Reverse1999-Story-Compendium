      "content": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "它的主人暫未想出更為高明的取勝方式。但，至少它有效提供了詭計成功時的竊喜情緒。"
        }
      ],
      "link_source": "supplement_episode_id"
