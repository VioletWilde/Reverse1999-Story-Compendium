  "segments": [
    {
      "script_id": "100837",
      "internal_title": "第八章8-24",
      "items": [
        {
          "kind": "title_card",
          "text": "獨角戲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她撿起槍，撿起子彈，一一填入彈巢。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "一，二，三。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "這裡沒有敵人，沒有目標，也沒有對手。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她從沒有如此茫然地舉起過槍。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "如同置身荒原的獵人，她無處可去，也無家可歸。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "中靶。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "三顆子彈，留下標靶上的一個孔洞。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "一，二，三。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彈殼退下，子彈裝填。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "一，二，三。"
        },
        {
          "kind": "title_card",
          "text": "基金會客房"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一個“千瘡百孔”的房間。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一位手指麻木的少女，機械性地扣動扳機。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "槍管沒有反應。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "謊言。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "欺瞞。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "背叛。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "她鬆開手，左輪槍落到腳邊。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "從一開始你們就把我支走，對嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "一個沒有將她納入謀劃的謀劃。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "還是說，從一開始你們就沒有相信過我。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "這只是一場家家酒嗎，姐姐？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“獵人”丟下槍，看著眼前沒有邊際的曠野。這裡只有風，吹過無花果樹的風。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她靠上牆壁，抱緊自己。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "為什麼……"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "同一個岔口。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "暖陽變寒冷。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "樹葉垂落，一個吻。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "烈火無法。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "將過去化為塵埃。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "直到現在。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "在憂鬱的熱帶，我們道別。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "我望著你眼中低語。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "在憂鬱的熱帶，我們吻別。"
        },
        {
          "kind": "dialogue",
          "speaker": "天使娜娜",
          "text": "而你將與一生所愛相遇。"
        },
        {
          "kind": "title_card",
          "text": "THE END"
        }
      ]
    }
  ],
  "fallback_fields": []
}