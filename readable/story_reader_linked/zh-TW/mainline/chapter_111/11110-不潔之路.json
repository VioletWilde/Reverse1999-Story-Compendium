{
  "episode_id": 11110,
  "chapter_id": 111,
  "chapter_title": "行於漫漫長路上",
  "display_label": "",
  "title": "不潔之路",
  "subtitle": "溫柔的聲音，刺耳的聲音。風的聲音，草的聲音。",
  "trails": [],
  "segments": [
    {
      "script_id": "101113",
      "internal_title": "第十一章11-10",
      "items": [
        {
          "kind": "title_card",
          "text": "不潔之路"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "裝甲車的殘骸中噴湧出濃烈刺鼻的煙霧。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "——咳咳。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪爾紗從一堆碎石中撐起身子，肩頭出現了輕微的撕裂感。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "結束了……似乎是誰幫了我們……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "帕……帕拉維揚，你還好嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她望向道路另一頭，不遠處，青年被壓在一塊沉重的屋樑之下。"
        },
        {
          "kind": "dialogue",
          "speaker": "“警官”",
          "text": "不要亂動，瑪爾紗——你的傷口還在流血。"
        },
        {
          "kind": "dialogue",
          "speaker": "“警官”",
          "text": "我馬上——馬上就能出來。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "帕拉維揚費盡全身力氣，也無法讓粗大的木料移動半分。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "敵方……已無威脅，我可以來……幫你。"
        },
        {
          "kind": "dialogue",
          "speaker": "“警官”",
          "text": "沒關係，我只是被壓住了。你先別動——你的頭和肩膀還在流血！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "嗯？我……受傷了嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪爾紗搖搖晃晃地站起身來。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "唉，有些頭暈，不會吧——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她伸手摸向自己的頭頂。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "噢……果然，我在……我在流血——糟了，應該留下一點疼痛感……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "也許是一個……彈……彈片——沒有關係，很快就能恢復……"
        },
        {
          "kind": "dialogue",
          "speaker": "“警官”",
          "text": "先為自己止血，瑪爾紗。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "……好。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "受傷的騎士坐在一塊倒塌的牆磚上，低垂著眼，看向自己腳尖的那一小塊地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "……我休息一會就好了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她看見一雙靴子。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "接著，是一柄碩大的反坦克步槍。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "這是——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她抬起頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "……是你…………"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她掙扎著想要站起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "坐好。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "哦……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她跌落回去，仰著頭，表情有些呆滯。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "是你……救了我們，謝謝。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "為什麼在這裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "重塑之手……我們在尋找蹤跡……"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "你知道自己會面對什麼危險嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她搖晃著腦袋。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "瘋了。\n簡直就是來送死。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "別纏著我！"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "——？"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "還有人？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“哨兵”轉過身，在裝甲車留下的濃煙後看見一道黑影。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "放開——放開！你會害死我的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在他腳邊，躺著一名和他穿著相同制服的傷患。"
        },
        {
          "kind": "dialogue",
          "speaker": "傷患",
          "text": "不——施特林……求求你——"
        },
        {
          "kind": "dialogue",
          "speaker": "傷患",
          "text": "——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "傷患被殺死在原地，不再哀嚎。\n施特林抬起滿是血絲的眼睛，與摧毀了坦克的狙擊手對上目光。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "該死的！"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一顆子彈擊中石像鬼的腹部。\n中彈者身軀輕顫，彈著點崩出一縷伴著碎石的煙塵，卻沒有流出鮮血。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "媽的——他媽的，怪物！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "施特林轉過身，向著村莊外亡命奔逃。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "呵。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“哨兵”沒有急於追逐，她先是走向帕拉維揚，掀開壓住他的屋樑。"
        },
        {
          "kind": "dialogue",
          "speaker": "“警官”",
          "text": "咳……咳咳——"
        },
        {
          "kind": "dialogue",
          "speaker": "“警官”",
          "text": "……謝謝你，請問我該怎麼……稱呼？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "青年抬起頭，看見濃重的陰雲在女人的眉間湊集。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "你留下來，替瑪爾紗止血。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "我去解決重塑之手。"
        },
        {
          "kind": "title_card",
          "text": "風車原野"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "呼……呼！"
        },
        {
          "kind": "dialogue",
          "speaker": "歐根",
          "text": "只有我們逃——逃出來了嗎？科爾騰呢，你沒有把他帶出來？"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "別管他！他死了！"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "她出現了，她來了——朝她開槍！歐根！"
        },
        {
          "kind": "dialogue",
          "speaker": "歐根",
          "text": "我——我看不見她——我們到底在往哪裡跑？！"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "前面有座風車，我們躲進去截住她——別停下，蠢豬！"
        },
        {
          "kind": "dialogue",
          "speaker": "歐根",
          "text": "我看見她了，看見她了——"
        },
        {
          "kind": "dialogue",
          "speaker": "歐根",
          "text": "去……去死！"
        },
        {
          "kind": "dialogue",
          "speaker": "歐根",
          "text": "呃——！"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "白癡……白癡！"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "啊……啊啊——！我的手——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "逃亡者距離風車的掩護只有數步之遙。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "……呃——呵……呵……"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "你無路可走了。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "子彈射向她的肩膀，再次無力地彈開。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "為什麼，殺不死你——你這個……怪物、惡魔……"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "我？"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "那你又是什麼？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "難道他們不是我們的兄弟、姐妹嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "圖謀奸惡，播散紛爭——你又是什麼呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她逼近一步。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "也許我們沒有多大區別。所以，我會給你懺悔的機會。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "土地從我們的手中接受親族的血。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "退、退後——！"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "……我不是為了殺戮而來。施特林是你的名字，對嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "啊啊啊——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "從現在起，你要受到永遠的詛咒。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "可你必須要先懺悔……告訴我……"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "你在說什麼——你想幹什麼？！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "土地不再為我們效力。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "咳……"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "終於，追隨重塑之手的士兵絕望地跪倒在地。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "告訴我……重塑之手究竟為何想要世界陷入——戰火。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "復甦之母，引導之人……"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "怪異的名諱。"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "……請求您垂憐卑微的僕從，我向您祈求奇跡，賜我永恆的生命——"
        },
        {
          "kind": "dialogue",
          "speaker": "施特林",
          "text": "我將絕望的生命……獻與您……永恆的國度，美好的時代——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "我們終身操勞，終生流離飄蕩在世上……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他將最後一顆子彈留給了自己。"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "“哨兵”",
          "text": "無可救藥的……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "等等——"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾紗",
          "text": "——哨兵！"
        }
      ]
    }
  ],
  "fallback_fields": []
}