{
  "episode_id": 11017,
  "chapter_id": 110,
  "chapter_title": "復樂園",
  "display_label": "",
  "title": "密涅瓦的侍女",
  "subtitle": "她想在永恆的光中醒著。",
  "trails": [],
  "segments": [
    {
      "script_id": "101021",
      "internal_title": "第十章10-16.1",
      "items": [
        {
          "kind": "title_card",
          "text": "密涅瓦的侍女"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "你的同伴，不會再從門裡走出來了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒沉浸在人類破碎的理智中，愉悅地瞇上了眼睛。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在神秘術的控制下，黑袍信徒們仍維持著靜止。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "——司辰，“最佳時機”就是現在！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "三個人飛速從廣場側翼衝出。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "Slæstu   í   djúpan   dvala."
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“無名者”率先從信徒群中衝出，扇面飛出的咒語讓門前使徒產生了片刻失神，她趁機回頭向落後的二人伸出手。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "趁現在穿過神殿之門，司辰！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "不能放著諾諦卡不管，十四行詩！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "Ed   è   subito   sera——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隨著咒語從筆杖中射出，束縛著諾諦卡的桎梏徐徐鬆開。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "探險家終於抬起了頭，失焦的目光卻無論如何都沒法在同伴身上停留。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "“門”只在接受祭品時會短暫開啟——咳咳。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "時間必須卡得剛剛好！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "重塑之手的神秘術沒能困住使徒太久，阿尼姆斯在幾息之間回過了神。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "諾諦卡，我們先走！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "恍惚的人類探險家被闖入者牽向神聖的大門，目光聚焦之處，領頭人頸間藍色的飄帶被風吹起。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵！我就知道……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她冷笑了一聲。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "她必定教會我生，或教我死。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·信徒",
          "text": "ㄞ——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "——？！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "原本雕塑般靜立門兩側的信徒突然動了起來，巨錘橫在了門前，擋住了即將衝進門內的步伐。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "卑賤而天真的灰鼠呵……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "情況似乎遭遇了滑鐵盧，陷入了進退兩難之地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒一邊擦拭著長弓，一邊緩緩踱步走來。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "我很好奇，你們那愚昧的腦袋裡有沒有考慮過哪怕一秒？"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "護衛聖所，籌謀儀式，被復甦之母託付以至高使命的我——真的會放任蠅營狗苟之輩在眼皮下亂跑嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "從始至終，你們都是透明的——無所不在的眼睛早已捕捉到了你們的一舉一動！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她振臂一呼，更多信徒紛紛從恍惚中甦醒，一擁而上包圍了眾人，更有信徒在她的示意下鉗住了闖入者的雙手。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隔著黑袍信徒組成的人牆，阿尼姆斯斜視著“無名者”。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "“淑女格蕾絲”，我一直想問你一個問題……"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "長者越走越近，最終她停在了闖入者面前，長弓點在“無名者”腳邊。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "你脖子上綁著一條迷人的縊索，它提醒著你自己的如履薄冰……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "尤其是颳風的時候，它勒得更緊，更令人喘不上氣，一定很難受吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "如今，你終於能鬆開這條縊索了，對嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "您真是會開玩笑……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“無名者”抬手撩了撩碎髮，一隻蛾子隨之從她的耳側無聲無息地飛出，向光的方向振動雙翅。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "——咳！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "蛾子被長者兩指拈住，碾成了細碎的閃光粉末。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "蛾子，神秘的輝光之下，人們很難注意到一隻微不足道的蛾子……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "你是何時加入我們的？"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "又是如何設計爬上光榮的“使徒”之位的？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在信徒巨大鼓槌的掩護下，長者繞著“無名者”徐徐踱步。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "籌備得如此嚴密的計畫，卻正好在你成為“使徒”後頻頻受阻……我虔誠的眼睛，不會錯判任何一名不誠者。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "你的運氣不錯。靠著籌備儀式的功勞，頂上了因煉金術事故而離開聖地的勿忘我，得以觀禮這場偉大的儀式……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "但你也油盡燈枯了吧？"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "引導之人的試煉一勞永逸，如祂的存在本身一般永遠高懸於我們的靈魂之上……面具的餘音隨時準備著蠶食不誠者的大腦。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "為了維持神智而竭盡全力，醜相百出……可不見半點“淑女”之相，格蕾絲。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“無名者”抬手撫過自己的髮髻，動作間落下更多細碎的鱗粉。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "只可惜，你燃盡自己換來的這些情報只是微枝末節，基金會的蟲豸根本無法與阿爾卡納女士忠誠的孩子們抗衡。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "你們的兵力被困海上，登陸遙遙無期，而你等來的唯一幫手只有幾個可憐的小女孩……噢，其中甚至還有人類。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在長者來回走動的身影之間，兩位基金會的闖入者緊張地互相交換著眼神。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "最終，她們的眼神一起來到“無名者”的身上。而後者，在眾目睽睽中垂下眼皮。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "您說笑了，阿尼姆斯大人。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "我的病根是在“自由海風號”上落下的，您也知道，基金會的司辰……可是一條爪牙鋒利的鷹犬。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "——！？"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "大名鼎鼎的司辰，乘坐我們留給烏蘇懷亞的船隻，並被我留下的線索一路指引來到聖所……"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "我將她帶到了您的面前。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "這是我一開始就做出的選擇，是我帶給您與引導之人的禮物。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她輕輕拍了拍面前信徒的手臂。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·信徒",
          "text": "ㄡ……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "信徒舉著武器的手臂被慢慢按下。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飾蛾的女士信步向前，在阿尼姆斯身旁停下。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她跪下身，低頭，親吻長者枯萎的手背。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "您看，要怎麼處理她們？"
        },
        {
          "kind": "dialogue",
          "speaker": "無線電小姐",
          "text": "你——你從最開始就在騙我們？！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "……呵。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "長者的目光停留在“無名者”年輕的臉上，審視著她的效忠。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "想要證明你的虔誠，你要做的還遠不止這些。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "長者繞到飾蛾的女士身後，遞出長弓，引著她的手搭上弓弦。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "何不現在就立一個頭功，你知道的——偉大的女士會樂意見到如此的故事橋段。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "二人一同面朝著幾位闖入者。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "瞄準眼珠，那是我最喜歡的部位。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飾蛾的女士架起鉛製細箭，準心指向面前人鉛灰色的眼睛。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "司辰——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "第一助手試圖脫困，卻被兩位信徒架著動彈不得，持筆杖的手幾乎要被反向折斷。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人類探險家雖然未被挾持，但她只是垂著頭喃喃自語，目光呆滯，似乎早已深陷譫妄中無法自拔。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消瘦蒼白的雙手搭起了箭。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "沉默地抬起頭，鉛灰色的眼眸迎上了箭尖的寒光。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "司辰，注意風向。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一瞬間，廣場突然刮起雪暴，飛舞的、折射著光斑的白遮蔽了所有人的視線。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·門徒Ⅰ",
          "text": "ㄕㄣㄇㄚ"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·門徒Ⅱ",
          "text": "ㄗㄣㄇㄜㄏㄨㄟㄕ"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·門徒Ⅰ",
          "text": "ㄕㄒㄩㄝㄅㄠㄇㄚ"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "門徒，別讓她們跑了！"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·信徒",
          "text": "ㄠㄠ——？"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·信徒",
          "text": "ㄞ——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "迷人眼目、遮天蔽日的蛾群籠罩了廣場，落在每一副面具上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在飛蛾的懷抱中，“無名者”看向基金會的“同僚”，露出一絲欣慰的微笑。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "“最佳時機”……司辰。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "十四行詩，就是現在！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瞬間反應過來的第一助手趁著信徒的一時不察，掙脫了桎梏。筆杖射出的咒語擊退了同伴身邊的敵人。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "——該死！看住她們！你們這幫蠢貨！！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "長者的嘶叫在蛾群中翻飛。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "無數對翅膀扇動著，反射著腹地的不落日光，將世界染成純白。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·門徒Ⅰ",
          "text": "ㄨㄛㄨㄛㄎㄢㄅㄨㄐㄧㄢㄌㄜ"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·門徒Ⅱ",
          "text": "ㄨㄛㄧㄝㄎㄢㄅㄨㄐㄧㄢㄌㄜ ㄊㄚㄇㄣㄗㄞㄋㄚㄌㄧ"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一時間，神殿門前的廣場陷入了瘋狂無序的吼叫中。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·信徒",
          "text": "ㄞ——！ㄞㄞ——！！！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "那副殘軀還能施展如此大型的神秘術？你究竟還留了什麼基金會的後手——!"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“無名者”並未應答，她一點一點地、慢慢地倒在了地上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飛蛾一一落在她靜止的身體上，很快將她裹成了一個無法自如行動的繭。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而長者暴怒的余光中，忽然掠過三個身影。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "強光之下，手挽手的女孩們已然快要躍進黑暗的門洞——"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "三、二、一，一起跳進去！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "三！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "二！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "——你們是不可能通過的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鉛箭穿透了血肉。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "——呃！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "諾諦卡？！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鮮血溢出厚實的褲腳，探險家踉蹌著撲倒在了神殿之門前。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "重塑使徒的術法擊落了大片飛蛾，越來越多的信徒聚集了過來。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "留下司辰，處理掉其他人。"
        }
      ]
    },
    {
      "script_id": "101022",
      "internal_title": "第十章10-16.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "棘手的蟲豸，打不死的灰老鼠，褻瀆的不誠者……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵，還有那狂妄自大、自以為是的“傳道者”……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "阿尼姆斯瞇起眼睛看著頑強抵抗的眾人，臉上突然露出玩味的笑容。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "走吧！血與肉的孩子們，無須再與愚者糾纏，祂可等不了這麼久。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "長弓點地，神秘術的光芒將廣場照成了一片藍。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隨著長者的號令，重塑信徒們像流動的山一般層層靠近、收攏，卻無人再對幾名闖入者投來關注。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "眾信徒簇擁著阿尼姆斯，後者用蔑視的眼神看著闖入者們。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "然後，她一腳跨入了神殿之門內。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "永別了，螻蟻。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "強光過後，廣場上已無人煙——信徒們追隨使徒而去，前往了“門”的對側。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "神殿之門……關閉了？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“無名者”長長呼出一口氣。"
        },
        {
          "kind": "dialogue",
          "speaker": "“無名者”",
          "text": "我們錯過了“最佳時機”。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "所有人望向廣場前一片冷清的狼藉。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "這也就是說……"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……只有又一次活人的獻祭，才能讓門再次打開。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}