  "subtitle": "內省者手持狂人的名片，狂人頭戴內省者的面紗。",
  "trails": [
    {
      "element_id": 101009,
      "owner_episode_id": 11009,
      "trigger_episode_id": null,
      "title": "忠誠的尺度",
      "description": "",
      "action": "",
      "unlock_condition": "EpisodeFinish=1009",
