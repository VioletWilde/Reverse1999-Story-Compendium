        "dialog"
      ],
      "content": [
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "回過頭，捂住口鼻。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "如果你沒有做好心理準備，我不建議你親自檢查這裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "一群業餘人士把這裡弄得一團糟。"
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "為我描述這裡",
          "edge_label": "",
          "branch": [
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "隱喻並不是我的本行，不過算了。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "幾塊奶油蛋糕被糊在牆上，野狗撕碎的麵包撒了滿地。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "還有草莓果醬。草莓果醬和辣椒醬到處都是，該死，我好像踩到了一顆爛葡萄。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "那麼如你所見，這裡有過不止一個人。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "但現在誰也說不清到底有過幾個人。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "稍有正義感的人都不會允許這種事發生。"
            },
            {
              "kind": "choice",
              "speaker": "",
              "text": "你在諷刺誰？",
              "edge_label": "",
              "branch": [
                {
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "我只是個服從命令的士兵，沒資格用善惡觀去諷刺誰，不過我可以就忠誠心發表些看法。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "保持忠誠在指揮官英明神武時並不難，大部分士兵都能做到。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "相對的，指揮官越是無能或難以理解，忠誠就越是難得。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "要炫耀自己的忠誠，就應當忠於一個瘋狂、愚蠢、不可理喻的指揮官，並清楚自己的行為。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "而那名中尉，她離絕對忠誠還差得遠。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "她看到這些時一定強忍著吐意。"
                },
                {
                  "kind": "dialogue",
                  "speaker": "？？？",
                  "text": "呵，年輕人。"
                }
              ]
            }
          ]
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "我必須親眼看到",
          "edge_label": "",
          "branch": []
        }
      ],
      "link_source": "supplement_episode_id"
    }
  ],
  "segments": [
    {
      "script_id": "101011",
      "internal_title": "第十章10-08.1",
      "items": [
        {
          "kind": "title_card",
          "text": "愚人與女祭司"
        },
        {
          "kind": "title_card",
          "text": "前芝諾近衛團某駐地"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉握著通訊器時的神情，比擒獲俘虜時要更加緊張。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "是，是。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "鑑於直升機的故障，非緊急關頭，我們不會使用它進行轉移。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "物資和糧食儲備充足，我們做好了持久戰的準備。"
        },
        {
          "kind": "dialogue",
          "speaker": "對講機",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "似乎碰上了一個難以回覆的問題，持通訊設備的軍官沉默了片刻後，朗聲作答。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……暫無任何基金會的武裝勢力出現。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "鑑於此，我懷疑喬治五世海岸不是他們首選的登陸地。"
        },
        {
          "kind": "dialogue",
          "speaker": "對講機",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "維多利亞地嗎？那不是正好靠近……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她的疑問被對方打斷。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "——是，是。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "我們會嚴陣以待，不放過任何可疑目標。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "莫莉德爾收起通訊器。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "平穩流動著的磁流體同它的護衛兵一起被縛，盤坐在駐紮地的角落。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "以“是”開頭，以“是”結束，但是你省略了最需要報備的資訊——我。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "武裝已經被我們解除，沒有定位器，沒有可預見的增援。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "你們只是一個意外。這樣的多餘資訊，父親不需要聽到。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "多餘的、無用的資訊，就像恩尼格瑪密碼機三轉子組成的上億可能性之一，在破譯出最後的密碼之後，它們就毫無用處了。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "所以一點談判的可能性都沒有了嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "拉普拉斯組長舉起被銬牢的雙手示意。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "子彈上膛。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一個行為，直接證實了至少這片營地上，話語權的歸屬在哪裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "提條件不是俘虜該做的事。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "烏爾里希沉默片刻。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "軍人的立場無堅不摧……對嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "那麼，為什麼要投靠重塑之手？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雲翳從山巔傾斜而下，時間在這裡同化石一起被凍結。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "就同你此行的目的一樣，這個問題是沒有答案的。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "那麼是否所有人都同意這一決定？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "我瞭解了，黨同伐異的結果。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "磁流體不吝在語氣中加入了一些譏諷。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "表示出忠心的追隨者將無知的人排除在外，得以留下最可靠的選項。但同時，你們的兵力一定出現了折損。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "“無知的人。”"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "莫莉德爾操起通訊器。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "來聽歌，對吧？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "父親會非常喜歡這枚唱片的——鑑於你身上除了各式探險裝備外就只剩下它。我猜，這一定與你來此的目的有關。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "看來拉普拉斯科算中心又誕生了新成果，然而這成果的背後，又有多少不計其數的犧牲呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "這些犧牲換來的是一個圓滿的成功課題，還是一個不期的失敗推演？我倒是頗為拭目以待。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "前芝諾中尉的手指輕輕敲打著通訊器，用好整以暇掩飾著某種怒火。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "磁流體並未如期被激怒，只是在玻璃缸內變換閃爍不定。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "而你們又能精準地推演出，你們所有行為的後果嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "撥通通訊器的手指停下。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "戴上面具成為瘋子，大喊大叫著把眼珠子扣出來。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "還是說，你的目的就是幫助重塑之手誘發一場又一場“暴雨”，直到你把所有曾經得罪過你的人都丟進“暴雨”裡滅口？"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "所以得罪她不是我們現在的首要任務——老闆！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "你們走在了親手推翻過往一切努力的道路上。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "我對軍隊紀律不甚瞭解，但以一個研究員的立場來說，我絕對不會這麼做。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "如果我的實驗方法被證實是錯的，那麼我會在嘗試所有變數後，改變實驗路徑，而不是徹底推翻我的課題。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "我很喜歡科算中心一位新職員帶來的箴言：世界上不存在錯誤的課題，只有未被找到可復現道路的規律。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "任何研究員都不會逃避失敗，我們被現實短暫擊倒後，就會爬起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "還是說，聽從軍令對你來說本身就是一種逃避？可以逃避承擔決策的風險。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "就像你們現在躲在這片海岸一樣。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "完了……老闆，這下應該是真的得罪她了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉下意識側身面向海岸，回避了所有人的視線。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她深深呼吸，思緒卻莫名飄忽。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……喬治五世海岸，難攻易守。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "情報已證實了戰艦從羅斯海海域駛來，從交戰情況來看，那邊是戰事中心……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "應該立刻奔赴維多利亞地進行增援。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "儘管只有一架堪堪可用的運輸直升機，但對一支訓練有素的部隊來說，路途並不遠……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "可是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "父親沒有下達這樣的指示。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他只是讓孩子們留在遠離戰場的冰架邊緣，繼續待命。"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "好吧，任務要以最壞的方式失敗了。"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "那……我想申請再吃一塊巧克力口味的軍糧——你要來一塊嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "……謝謝，“咀嚼”這個動作在執行層面無法做到。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "——烏爾里希組長。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉從自己的思緒中抽離，目光如炬地回頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "你對重塑之手想要在南極進行的活動瞭解多少？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "話鋒一轉的詢問令組長狐疑起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "我們似乎並沒有達成任何共識，芝諾軍備學院的套話技巧未免顯得太薄弱了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉收回落在俘虜身上的目光。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "很薄弱，我向來不精於此——但在把你倒入特拉諾瓦灣前，我必須知道你背後代表著什麼樣的資訊。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "……等、等等？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "磁流體瘋狂閃爍，軀殼的電路劈啪作響。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "情況似乎沒有轉機。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "白手套隊長、弗雷希特曼隊長。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隨著中尉的呼喚，兩位隊長分站在她身側。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "把它帶回那處考察站的舊建築，那裡是更為合適的審訊地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "前芝諾中尉伸出雙指示意，磁流體被兩位隊長一人架著一隻胳膊強行帶離。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "——等等，你們根本不知道自己在做什麼！這是一個絕對的錯誤！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "兩位步兵隊長無動於衷，只提溜著意識喚醒者向目的地走去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉走在最前方，她軍靴上的金色穗條在空中飄蕩。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "哈啊……我就知道，我真的不擅長做演講，特別是臨場狀態下。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "談判破裂了，護衛兵！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飛刀快速地劃開了縛手的綁帶。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "護衛兵脫困的雙手立刻搭上了被光學神秘術藏起來的手槍。"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "小心腳下。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雪灰飛揚而起，槍彈從白霧中穿出。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……嘖，一個棘手的護衛。"
        }
      ]
    },
    {
      "script_id": "101012",
      "internal_title": "第十章10-08.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "俘虜被押解上路，在雪上留下一深一淺的足印。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在他們的前方，中尉昂首闊步，目不斜視。"
        },
        {
          "kind": "title_card",
          "text": "南極平原"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "老闆，目前情況較為危急，是否允許我使用……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "竊竊私語傳進前方帶隊的中尉耳中。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……看上去你們並不在意自己是否死到臨頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "護衛兵彈了一下自己胸前的對講機。"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "戰時特權，這個對講機直連軍事部長官。雖然這意味著行動失敗，但只要我摁下它，就能直接向長官發送我們的座標定位……"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "作為叛軍，你比我更清楚你的下場。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在前方帶隊的中尉並未回頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "……那麼您在等待什麼？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "直接撥通，我們早已做好準備。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉推開了考察站的門。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "微弱的、此起彼伏的呻吟聲從門內傳出。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "白手套隊長、弗雷希特曼隊長，你們在外面等我。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "我想要好好和這兩位客人聊聊。"
        },
        {
          "kind": "title_card",
          "text": "臨時駐地救護站"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隨著陳舊開關被按下的脆響，一盞盞昏暗的燈逐一亮起。"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "光線一點點驅散黑暗，呻吟的源頭也一個個出現在了眼前。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "——這是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "考察站被改造成了野戰醫院，每一張床鋪上都躺著一個虛弱的病患。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "——這是重塑之手遺留的罪孽。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉的臉被白熾燈照亮了一半。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "他們在南極屠戮了數個考察站，一些人已經遇難，還有一些人被帶去了他們的駐地，原因不詳。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "而剩下一息尚存的……我們沿路救下後，全部安置在這裡了。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "……他們都是人類？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "憤怒的波動在磁流體的閃爍中清晰可見。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "大多是的——當然其中也有我們的同僚。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉走到一張床鋪邊，輕輕將病患放在被子外的手塞進溫暖的被褥裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "抵達南極後，部分隊員在重塑之手駐地外受到了某種影響……有人長久地迷失在了暴雪裡，等被我們找到時，已經精神崩潰。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "父親曾向我們承諾一個“保護”……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "但安德烈小隊全員都已經失去了堅定的意志，他們脫離了我們的隊伍，成為了面具之下的狂熱追隨者。"
        },
        {
          "kind": "dialogue",
          "speaker": "護衛兵",
          "text": "……我知道失去戰友是什麼感受。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "似乎有更多隱情，護衛兵最終選擇沉默。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "巡查過所有病患的情況後，中尉最終停在一張方桌前。暖色的檯燈將她的身影描出一輪金邊。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "我向你們攤牌。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "面前的現狀對你我都不利。"
        },
        {
          "kind": "dialogue",
          "speaker": "烏爾里希",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德爾",
          "text": "想要破局，唯有進行一些互利的資訊交換。"
        }
      ]
    }
  ],
  "fallback_fields": []
}