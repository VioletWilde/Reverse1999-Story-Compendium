{
  "episode_id": 11021,
  "chapter_id": 110,
  "chapter_title": "復樂園",
  "display_label": "",
  "title": "朝聖於來時路",
  "subtitle": "血與淚交融在一起，那魂靈倒在地上，無聲啜泣。",
  "trails": [],
  "segments": [
    {
      "script_id": "101027",
      "internal_title": "第十章10-20.1",
      "items": [
        {
          "kind": "title_card",
          "text": "朝聖於來時路"
        },
        {
          "kind": "title_card",
          "text": "火山神殿·祭壇"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伴隨著教徒的吟誦聲，漆黑的肉團如心臟般不斷跳動著，湧動的墨色液體淌入井中那些沒有質量，亦沒有濕度的雨。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "那是……阿爾卡納？！"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "我紡織的線連向了井底……為什麼？這些線的使命不該流向那裡……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "盲眼者試圖扶住飛轉的紡輪，指尖卻被擦出一道金色的傷痕。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "紡車也無法停下……"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "維爾汀，快走——"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "天真。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒揮動權杖，漆黑的黏膩液體化作繩索將二人牢牢束縛在原地。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "儀式已經開啟，復甦之母即將降臨，休想褻瀆這神聖的時刻！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒緩緩走近。吟誦聲中，她自水中拾起一塊白骨。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "看看這些骨殖，如此蒼白冷峻……堪稱典雅、神聖。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "這是不屬於被竊奪之世的造物，唯有被抹去的空白時代才能孕育。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "而現在，我們終於等到奇跡之卵顯現，復甦之母將這已逝的時代帶回給了我們——"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "祂已重臨！與生俱來的枷鎖於今破去，過往的榮光再度照耀！"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "空白時代？帶回已逝的時代？……不，時代應該要向前走的。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵，尚處於愚昧中的人啊，看在你為我們開啟儀式的份上，我將原諒你的冒犯。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "即便你對此一無所知，但你的貢獻會被銘記。在新世界裡，或許還會被授予聖名。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "不、不……"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "不對，不能讓紡車再轉下去……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "盲眼的女士渾身顫抖著又一次伸出手，試圖停下那轉動不息的紡車。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "——快停下！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "做夢！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒的長弓猛地敲擊地面，整座神殿微微顫動起來。絲線在刹那間繞上兀爾德的身體，向盲眼者汲取著最後的力量。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛絲醫生",
          "text": "唔……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "儀式的光輝更甚，而盲眼者的臉色逐漸慘白。金光散去，她暈倒在了翻湧的霧氣中。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呼……呵呵，我還以為又會像1999年那般……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "可惜，你已經不再有過往的力量了。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "仁慈的復甦之母已經攜來偉大的奇跡！任何人都休想阻止你們可悲命運的降臨！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒揮動權杖，墨色的黏液包裹住盲眼者的身體，將她與紡車一同沉入黑暗。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "德洛絲女士！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "別著急，維爾汀。很快，無論是你還是兀爾德，都會與偉大的復甦之母融為一體。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "謙卑地領受這無上的榮譽吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒回身看向周圍的教眾，他們泣血泣歌，任水上湧，淹過他們的身體。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "——緩緩流動著的水，沒有水的重量，也沒有水的濕度。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身後正欲啟動的神秘學道具被猛地擊落。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "收起那些小伎倆，它只會徒增你的可笑。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵，無論是你，還是那個撞開門的卑下小蟲子——都是一樣愚蠢。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "不過她已經意識到了自己的無知，最終奉獻了自身血肉和靈魂，重歸復甦之母。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "如果你願如她一般領受這份恩典，便奉獻吧！仁慈的復甦之母也會吸納你所有的悲苦，賜予你享受不盡的來日恩典。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "你錯了。諾諦卡進入門中的原因絕非如此——她有自己的信念。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵……那你就自己去向她索要答案吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "束縛的繩索猛地收緊。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "領受這份榮光吧。你的血肉將歸於復甦之母，鋪就祂降臨之路！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "幾近被完全覆蓋的視野中，黏稠的“門中之手”順著冗長的甬道捲入山體內，急速靠近。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "窒息感迅速襲來。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "噓——噓————"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "遙遠的風聲從神殿的巨口中傳出。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "奉獻吧！當你擁抱那寬仁的母親，回饋你的必是無窮的大能。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "咳、咳咳！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "視線中開始出現血色。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "唔……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "溫暖的地方，像是在母親的懷中。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "睜開眼吧，這裡會將夢延續。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "別緊張，維爾汀。現在還不是最高興的時候！"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "等我們呼吸上第一口真正的空氣……等我們在外面胡吃海喝……等我們回到我們自己的國家……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我們有的是值得顫抖的好事！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "是“圈環”的聲音……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "向著聲音的來處走去，試圖聽得更清楚一些。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "是你嗎，“圈環”？"
        },
        {
          "kind": "dialogue",
          "speaker": "學生Ⅰ",
          "text": "來，我們一起開門吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "學生Ⅱ",
          "text": "三，二，一——"
        },
        {
          "kind": "dialogue",
          "speaker": "伊莎貝拉",
          "text": "願自由與我們同在！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "伊莎貝拉、“便士”……大家都在這裡嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "學生Ⅰ",
          "text": "衝啊——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "伊莎貝拉",
          "text": "維爾汀……！快出來啊！！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "大家……等等我……"
        },
        {
          "kind": "dialogue",
          "speaker": "斯奈德",
          "text": "那來聽聽大家的願望，怎麼樣？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "斯奈德……？"
        },
        {
          "kind": "dialogue",
          "speaker": "斯奈德",
          "text": "老爺居然這樣毫無防備地躺著……呵呵。"
        },
        {
          "kind": "dialogue",
          "speaker": "斯奈德",
          "text": "我們呀，可陪著老爺折騰了好久……不要點獎勵，那怎麼行呢……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "輕柔、帶著一些沙啞的聲音，像是一片羽毛般飄走了。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾塔",
          "text": "我也不知道我該去往何處。因此，我想請您為我解答疑惑。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "瑪爾塔女士？不，那是……"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "……瑪爾塔女士，我能回答您的並不多。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "但我想——命運比我們更清楚自己的命運。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾塔",
          "text": "……感謝您的解答。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪爾塔",
          "text": "如此，我明白了。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "不，別走——"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……為什麼……"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "為什麼……總是這樣？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "看啊，你失去的那些都在這裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "向前一步吧，回到你的朋友們身邊，回到那些溫暖的懷抱之中。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "腳步不由自主邁向聲音的來處，卻又停下。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……不，不是那裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "那是我的來時路。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我還有應盡的使命，有要求的答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我該去的地方是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "回身，另一邊隱約有聲音傳來。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……維……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "於是堅定地向去路邁步。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……維爾汀……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……維爾汀！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "這裡是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "離開朦朧的幻夢，映入眼簾的是無盡的黑暗。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑暗的四壁是蠕動的肌理，腳下是沾染著血肉的白骨與由血漿、體液混雜而成的液體。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空間間歇性地鼓動，不時向著黑暗的盡頭噴發一陣陣令人作嘔的惡臭。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "這就是……“門”內真正的景象嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "“門”把被投入的祭品都……唔！"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "小心，如果滑倒的話，就會和他們一樣了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "帶著哭腔的稚嫩聲音響起，那是黑暗中唯一微弱的光源。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……這就是這裡的“現實”。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "你是誰？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我也不知道我是誰……我什麼都不記得了。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我只是覺得自己還不想和他們一樣，所以留在了這裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "但你……你好像都還記得。你為什麼會來到這裡？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……我被作為儀式的祭品投了進來。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我必須儘快出去。你知道離開這裡的方法嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我不明白你所說的，我什麼都想不起來了……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "或許我可以幫你引路。但你必須告訴我，你想去哪裡？為什麼一定要去那裡？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……我要離開這裡，去到“門”的外面。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "為了尋求一個答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "“答案”。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "那個“答案”，也是你來到這裡的理由嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……或許確實如此。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "它值得你如此追尋嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我不知道。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "那你有沒有想過，要是這個“答案”根本就不存在，要是你追尋的道路盡頭根本就一無所有……又該怎麼辦呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……我想過很多次。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我甚至想過，現在所走的每一步可能都踩在一條不存在的道路之上。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "但一路以來經歷的種種讓我明白了，那也沒關係。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "為什麼？明明之前的一切努力都白費了。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "為此付出的那些犧牲和血汗，又要以什麼來為它們作答呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "那些努力並沒有白費。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "往昔的一幕幕如在眼前。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "那些犧牲，那些掙扎，那些構成了前行意義的人們。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我會記得他們。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他們真實存在過。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "所以，縱使道路盡頭是虛無……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "“我也要走下去。”"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "光點搖晃著，輕聲而又堅定地吐出這句話。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……啊，是的。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "沒錯，我想聽到的就是這個回答。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "微弱的光點閃爍著，逐漸變得明亮。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我好像想起來了。你所說的那些，也是我曾經抱有的信念。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "所以我還在這裡。留在這裡的情感不是後悔，也不是空虛。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我是“滿足”的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "光點——不，現在應該稱之為“光團”了。它躍動著靠近，散發著溫暖的光。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "——握住我的手！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "你的手？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "深入我的心臟，那裡應該留下了什麼！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "將手伸入光團的中央，舒適而柔和的觸感落在手心。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "是布料？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "不、不是這裡。應該是被保護在更深處的地方，嗯……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "對了，就在那裡！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "攤開手，手心裡躺著一個吊墜，裡面的小小晶體反射著不存在的光。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "就是這個。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我留下的……答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一點點熟悉的溫度通過吊墜傳來，上面刻著熟悉的姓氏。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“阿蒙森”。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "你是……諾諦卡？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "是的。“諾諦卡”，我的名字。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "謝謝你，維爾汀。我終於找回了我的名字！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "血肉自光團處再度生長。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一雙無形的手拉住了自己。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "“歸鄉的路與姓名相連。迷途的孩子，思念會牽你回家。”"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隨著她一字一句道出話語，周圍的場景逐漸開始變幻、溶解。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "雖然“地母”不在這裡，但我的確夢見了她——她為我指出了離開的路。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "來吧，維爾汀。我會帶你出去！"
        }
      ]
    },
    {
      "script_id": "101028",
      "internal_title": "第十章10-20.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "緊握住諾諦卡的手。儘管身處地獄，這雙纖細的手卻依舊充滿力量。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身體逐漸溶解，視野逐漸變黑，如同這個世界在否定這份意志。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但彼此的雙手依舊在末日緊緊相握。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "失去視力，我依舊可以向前走；失去雙腳，我也可以爬行著前進。就算失去身體……"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "也可以用血肉鑄就新的身體。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "——因為我也不會放棄尋找“答案”，尋找我的“好消息”。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "啊……"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "維爾汀！我們做到了——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "世界的新生由風而起。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我們現在……在神殿的空中？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "諾諦卡，你的樣子！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑色黏液自她的體內伸展，化為骨骼，而潔白的布料構成了羽翼。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓聲似從遠方隱隱響起，她的翅膀是最高昂的旗幟，宣告迎風招展的勝利。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "很像……"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "這和我夢中“地母”的樣子很像！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她驕傲地抬著下巴，踏碎神殿的巨石，跳躍間帶起一陣陣風。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "下一刻，她踏風而動，擺脫無數雙手的束縛，衝向天際。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "太好了，這樣一來，我就可以帶你們回家了！"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "危險，諾諦卡！"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "巨獸揮動著新生的羽翼躲開飛來的碎石，看向危險來源的方向。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "神殿深處正傳來陣陣顫動。"
        },
        {
          "kind": "dialogue",
          "speaker": "諾諦卡",
          "text": "那、那是什麼？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……阿爾卡納……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓動的不定形黑色肉團伸出無數雙手，緊緊融在了石壁上，整座神殿瞬間如活過來了一般吐息著。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "如果“門”是嘴，那麼我們先前或許就是被困在了胃袋中……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "風自神殿內穿過，撞在黑色肉團上，發出呢喃一般的呼喚聲。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "是的……整座遺跡就像有生命一般活著。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "而阿爾卡納……她……也許就是其中的“心臟”。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "恐怕很快……她就會完全復活。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}