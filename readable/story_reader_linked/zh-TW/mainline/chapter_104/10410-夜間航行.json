  "segments": [
    {
      "script_id": "100412",
      "internal_title": "第四章4-10.1",
      "items": [
        {
          "kind": "title_card",
          "text": "夜間航行"
        },
        {
          "kind": "title_card",
          "text": "基金會客房"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "銀質的占卜台、白色的絲綢、浸過夜露的珍珠……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "嗯，月亮材料還缺什麼呢……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "噢！檢查一下乳香和沒藥還有多少……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "很好，沒問題，分量剛剛好。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪蒂爾達在桌前忙活著。她反復確認窗簾的位置，確保月光能無誤地映照在晶球上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "細小的騷動在不遠處的容器中響起。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但她無心留意。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "很好，都齊全了。香料皿，我的香料皿……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪蒂爾達轉過身來。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "呀啊——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一旁的香料皿落到地上，在對稱結編織的地毯上發出聲響。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "～♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "香料皿後面露出尖尖的小耳朵。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "怎麼又是你們！煩人的占卜妖精！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "我這次絕對不會再允許你們偷走我的道具了！"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "～♪～♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "透明的小生物並不關心她的慌張。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "它們與那些成群結隊的魔精不同，僅是一兩隻，就能給人們帶來極大的麻煩。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "細長的小手攥住銀製的香料皿邊沿，向窗外飛去。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "嘿！你們想把我的東西偷到哪裡去？快給我住手！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她撲上窗臺，緊緊地抓住銀皿的另一邊。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "呼……看來不好好懲罰你們一下，你們、你們是不會知道教訓的！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "等著吧，我馬上就會讓你們知道，得罪瑪蒂爾達·布翁尼小姐，是個什麼下場！"
        }
      ]
    },
    {
      "script_id": "100413",
      "internal_title": "第四章4-10.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "銀皿摔到地上，撞出一個陷坑。"
        },
        {
          "kind": "dialogue",
          "speaker": "占卜妖精",
          "text": "×……×！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "妖精們在窗前軟軟地爬行，看起來受了不小的衝擊。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪蒂爾達拾起香料皿，擦了擦上面的灰。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "哼，看看是誰笑到了最後～！是我，是我！"
        },
        {
          "kind": "dialogue",
          "speaker": "占卜妖精",
          "text": "♮♭♮♯♭♯♮♯♭！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "它們爆發出一陣難以聽懂的咒駡，垂著翅膀從窗外逃走了。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "啊……真是的，累死我了。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "現在多少點了……哦！還好，還沒有錯過潮汐時間！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她手忙腳亂地收拾起桌面上的道具。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "趕緊把東西擺好……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "不能再被打攪了，占卜需要全神貫注，凝聚所有的能量……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "門外卻響起輕輕的叩門聲。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "咳咳！月球潮汐就要到來了，我看看，預測出現的時間是20點45分。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "還有三分鐘。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "漲潮的同時要淨化水晶球，確保獲得的占卜知識準確無誤……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "敲門聲再次響起。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪蒂爾達皺起了眉頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "冷靜，冷靜。這可是最關鍵的時刻……不管是誰，都別來影響我！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "嗯……不要分神，不要分神。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "閉上雙眼……集中精神……想像身體正在月亮的祝福下，伴隨著潮汐起伏……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "而她將在和諧的對岸……等候著我去尋找方向……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "是時候焚燒香料了……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "於水晶中顯現形象吧，十四行……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "瑪蒂爾達，你在屋裡嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……？！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "這是怎，怎……怎麼回事？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "抱歉，但我似乎聽到你的聲音了。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我有事……想請你幫忙。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她的聲音聽起來有些變化，帶著被磨損後的顆粒感。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "我……我馬上就來！不對，你先等一會兒！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "我現在、忙著呢，你——你給我等好了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她慌裡慌張地掀起水晶球下的絲綢，將它們塞到沙發的角落。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "門開了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她們站在門口，前進，後退，如同在進行尷尬的方步練習。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "最後，十四行詩被瑪蒂爾達迎了進來。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "說出你的請求吧！你深夜來找聰明伶俐的瑪蒂爾達小姐，是……是來做什麼！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行詩臉上擠出一個笑容。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "能請你為我占卜一下嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪蒂爾達在她的臉上看到了從未見過的景象。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她們在水晶球旁邊坐下了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "沒藥在一旁靜靜地焚燒著。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "嗯，現在是一個適合向月亮求助的時間……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "在銀盆中洗淨雙手，再放到我的手掌上。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "好了，請坐到我的對面，凝視著水晶球。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "好的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行詩照做了。她看到水晶球裡是一片澄澈的空白。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "你是來告解，釋夢，還是來尋求水晶的預言？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我來告解……也來尋求預言。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "跟我說說積蓄於你心中的畫面吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "畫面嗎……？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "嗯……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她望著水晶球。球體在她眼中逐漸模糊。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "看到自己在不斷地下墜……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "有兩塊碎裂的甲板……它們原本是一體的。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "每當我靠近一塊甲板時，另一塊就會沉入水中。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "上面的人們也隨之一同墜落。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我能感受到深水處的冰冷，也能感到掙扎時的疼痛。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "你對此感到悲傷嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……我……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我感到恐懼。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "嗯……你的直覺想要靠近哪一塊甲板？上面的人影你能看清楚嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "那塊甲板上有明亮的東西，就像是……司辰和槲寄生她們……那裡很溫暖。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……你不自覺地受它的吸引。它賦予了你心靈的指引。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "另一塊甲板呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "另一塊甲板……讓我感到舒適。仿佛我在那裡度過了漫長的歲月。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我能在那裡找到我每一步的軌跡。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "那或許象徵了你的理性。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "十四行詩，你在面臨什麼抉擇嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "我看到你的直覺與理性處於矛盾的……角度。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "聽說你今天也參與了委員會的會議。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "發生了什麼事嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我說錯了話。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我沒有做好充足的準備……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我沒有幫上司辰和槲寄生她們的忙，反而加大了彼此的誤解。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我該如何選擇……才能解決他們的矛盾？這樣的僵持……讓我感到很害怕。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪蒂爾達一時不知道怎麼回答。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她只是呆呆地將手掌蓋在對方手腕上。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "那塊明亮的甲板……似乎距離你更近，也更大一些。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "你有沒有考慮過傾聽心靈的指引？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "十四行詩，或許你可以嘗試一次，跟隨著直覺採取行動。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "也許會發生意想不到的事情哦。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我嘗試過。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "——在四年前。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我放了他們離開……那是我做過最錯誤的決定。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行詩重新握住了水晶球。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我準備好了。請幫我占卜出正確的選擇吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……好。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "混沌的雪花消失後，球體重新變得朦朧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而視野中浮現出隱約的晶體。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "它們層層搭建出一艘對稱而均衡的小船。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一切都有跡可循，有理可依。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "“實相已顯現。”"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "“步入已步入之道，行進已行進之徑。”"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "“聽從腦內的聲音將于你有益，因為泊船的時刻未到。”"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "聽從腦內的聲音……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我明白了。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "我不該猶疑的。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "謝謝你，瑪蒂爾達。你的占卜對我很有幫助……我現在清醒多了。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "謝……哈，你當然應該謝謝我——！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "現在才知道瑪蒂爾達·布翁尼小姐的神通廣大實在是太晚了。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "要知道，平時找我占卜的人，如果沒有提前十五天預約，本小姐可是見都不會見的！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "哈哈。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "你占卜的時候很認真……語氣都與平時不一樣了。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "不過，我還是更習慣你現在的說話方式……這會讓我想到我們在校的時光。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "瑪蒂爾達呆若木雞地站著。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行詩揮了揮手，走出了房間。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "謝謝你專門為我騰出時間，瑪蒂爾達。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "下次有需要我幫忙的地方，請一定要告知我。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行詩",
          "text": "晚安。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "門被輕輕帶上了。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "！%￥#……&*……"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
