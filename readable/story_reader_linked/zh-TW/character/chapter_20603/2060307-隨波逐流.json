{
  "episode_id": 2060307,
  "chapter_id": 20603,
  "chapter_title": "第一千夜",
  "display_label": "",
  "title": "隨波逐流",
  "subtitle": "",
  "trails": [],
  "segments": [
    {
      "script_id": "309507",
      "internal_title": "【2.0】环状水星玩法剧情07",
      "items": [
        {
          "kind": "title_card",
          "text": "弗雷斯諾，街道"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "感謝您的順風車，再見！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡和環狀水星從一輛轎車中鑽了下來。"
        },
        {
          "kind": "dialogue",
          "speaker": "司機Ⅱ",
          "text": "週末快樂，小妞們！"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "呼……弗雷斯諾，我們終於到這裡了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡像是一個沒了氣卻能橫穿大西洋的神奇氣球一般飄在人行道上。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "我不敢讓我的腳後跟碰到地面……我一定會馬上痛得叫出來。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "這裡正好有一家餐廳。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "沒有什麼更好的選擇了，我的腳太痛了……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一邊被環狀水星攙扶著，一邊忍受著水泡的痛苦，比安卡踮著腳挪進了餐廳裡。"
        },
        {
          "kind": "title_card",
          "text": "臭鼬莎莎餐廳"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "店裡的客人還不多，因此二人剛坐下，便有服務員來進行點餐的工作。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "兩份牛肉塔可，一份玉米片……我可以拿一份幸運餅乾嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "店員",
          "text": "當然可以，祝你好運。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "店員收到菜單後，便回到了後廚。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而環狀水星也立刻離座跟了上去。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "嗯？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡停下了掰開幸運餅乾的手，通過遞餐的窗口看著環狀水星與店內的經理在後廚進行什麼交流。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "二人看似達成了某種約定後，環狀水星便走了回來。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她剛剛落座，比安卡便按耐不住好奇的心。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "你們認識？"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "剛剛認識。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "那你們剛才在聊什麼？"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "我的工作。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "工作？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡疑惑地四處看了看。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "但我在這裡並沒有感覺到什麼異樣。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "作為服務員的工作。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "服務員……？"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "是的，剛到新城市落腳，第一件事便應該是找份工作。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡難以置信地看著環狀水星。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "你不回去了嗎？也……也不繼續做精神療癒師了？"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "我會在這裡停留一陣子，就像我剛到舊金山時那樣……精神療癒師也並不是我唯一的職業，我只是要先落個腳。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "啊……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "驚訝之下，比安卡不小心掰開了她的幸運餅乾。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "這麼輕易嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "環狀水星輕輕地點點頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "那……德克斯特的項鍊呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "你可以帶回去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "環狀水星平靜地回答道。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "你一開始便是這麼打算的？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "環狀水星點點頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "這就是我的生活。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "是的，如此自由的環狀水星。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡向手中的紙條看去，上面印著“你的身邊永遠有真正的朋友”。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "放屁。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡將紙條揉成了一團。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "我想起來了，你走的時候，已經把東西都分給大家了。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "我早該想到你不會回去。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "但是你會。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“咔嚓”。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "索拉亞，她又在哪個城市裡做著什麼樣的事呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "我？我也不一定會回去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "因為我渴望環狀水星的自由。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“咔嚓”。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "這樣嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“為什麼當時沒有走呢？”"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "因為我做不到。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "嗯。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“小比安卡，來爸爸這裡。”"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不管嚮往的心有多麼強烈，儘管我已經走到這裡了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "每當我要真正啟程時，我總是邁不出那一步。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "邁不出對於環狀水星來說這麼輕巧的一步。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "是的，就是這樣。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“咔嚓”。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "比安卡。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "環狀水星握住了比安卡的手，她手裡的幸運餅乾已經被捏得粉碎。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "不，現在別對我使用你的神秘術。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "往日令她平靜的那股精神波動現在竟如毒蛇吐信一般讓她心生避讓。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡掙脫了環狀水星的手，看著視線中環狀水星水濛濛的臉，她才意識到自己紅了眼眶。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "從來都沒覺得心情寧靜是一件如此可惡的事。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "環狀水星的手還停留在原處，但比安卡看不清她的表情。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "如果沒有朋友們的離開，比安卡不會意識到自己已經被完全地鎖在了舊金山。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "爸爸……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她恨他，是因為她曾經見過那個威風無比的他，也是那個他狠狠地鉗制住了現在的比安卡。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但這並不是唯一的理由。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "索拉亞……"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "是的，你終將回去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一陣宣洩過後，比安卡逐漸地冷靜了下來。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "環狀水星坐在對面，看著比安卡為了消解情緒而百無聊賴地在桌子上彈玉米片。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "由於長途跋涉和某個不可說的原因，她毫不客氣地搶走了環狀水星那份塔可，連著自己那份一起吃了下去。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "你心情看上去好多了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡點點頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "謝謝你，這一路很愉快，我現在就像是……宿醉了一天以後剛醒一樣。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "找回了德克斯特的項鍊，買到了喜歡的裙子，真正地流浪一次。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "我……我想我還是沒有勇氣這麼果斷地在另外一個地方重新開始，環狀水星，這是只屬於你的特異功能。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "這與勇氣無關，比安卡，我只是這麼活著而已。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "我生來無家。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "現在，我可以握住你的手了嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "環狀水星的手仍停留在那裡，比安卡點點頭，將自己手放到了環狀水星的掌心處。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但比安卡沒有感覺到那股心靈的暖流，環狀水星就只是握住她的手而已。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "謝謝你，你讓我知道了平靜並不一定都會帶來好的結果。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡撇撇嘴。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "那，作為一場夢的終結，我們是不是應該為它劃上一個完滿的句號？"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "你想做什麼？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "我還沒有見過自己穿裙子跳舞時的樣子。"
        },
        {
          "kind": "dialogue",
          "speaker": "環狀水星",
          "text": "我們走吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡和環狀水星在弗雷斯諾中漫步著，她們只為音樂停留。"
        },
        {
          "kind": "dialogue",
          "speaker": "流浪歌者",
          "text": "♪搭上這趟快車。♪"
        },
        {
          "kind": "dialogue",
          "speaker": "流浪歌者",
          "text": "♪除了這張車票，我擁有的也不多。♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "流浪歌者的聲音像漂流瓶一般在喧鬧的大街中沉浮著，比安卡和環狀水星便就此追尋而來。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "那是一名老成的歌者，他慵懶沙啞的聲音中是足跡萬千的歲月。"
        },
        {
          "kind": "dialogue",
          "speaker": "流浪歌者",
          "text": "♪離開家鄉，踏上旅途。♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他彈著那把已經被磨得油亮的吉他，隨意地坐在紙箱與塑膠袋堆疊成的座墊上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "指縫黝黑，卻不妨礙他彈出美妙的音樂。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡脫下雨靴，赤著腳在歌者旁起舞，人們紛紛為這一襲紅裙而駐足。"
        },
        {
          "kind": "dialogue",
          "speaker": "流浪歌者",
          "text": "♪也許我會跟著你，也許我會跟著自己。♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "隨著比安卡的節拍，環狀水星也情不自禁地開始舞動。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "這將是弗雷斯諾今夜最美的場景。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一紅一白的身影罔視周身一切的車水馬龍，用舞蹈表現著自己的生命力。"
        },
        {
          "kind": "dialogue",
          "speaker": "流浪歌者",
          "text": "♪下次再見，下次再見。♪"
        },
        {
          "kind": "dialogue",
          "speaker": "塔羅師比安卡",
          "text": "♪下次再見，下次再見。♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡忘情地唱著，不要月落，不要日出，不要完結這場自由的夢。"
        },
        {
          "kind": "dialogue",
          "speaker": "流浪歌者",
          "text": "♪明天一定會比現在更好。♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她情願相信明天會比現在更好。"
        }
      ]
    }
  ],
  "fallback_fields": []
}