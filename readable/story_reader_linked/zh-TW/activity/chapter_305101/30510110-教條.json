  "segments": [
    {
      "script_id": "2030517",
      "internal_title": "【S01】翡冷翠之春10.1",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "血。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人們說，佛羅倫斯是一片浸潤榮耀與鮮血的土地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "這裡流淌著羅馬人的血，聖徒的血，圭爾夫與吉伯林的血，麥地奇與帕齊的血……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "以及那些為自由而戰的人的血。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "聖殿騎士Ⅵ",
          "text": "別做無意義的抵抗了，這次我們幾乎投入了全城的兵力。"
        },
        {
          "kind": "dialogue",
          "speaker": "聖殿騎士Ⅵ",
          "text": "教皇下達的指令除了帶回遺物與金蘋果以外，還有一條同等重要的……"
        },
        {
          "kind": "dialogue",
          "speaker": "聖殿騎士Ⅵ",
          "text": "那就是殺死刺客埃齊歐·奧迪托雷。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我們可以配合你打開密室。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "維爾汀！我們不應該——等等，你怎麼會知道如何開啟密室？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "阿爾貝托滿意地鼓起掌來。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "很好。是時候讓你的小小秘密從塵封中解脫了～"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "維爾汀……"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "沒關係，我們先看看畫。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "篤定的語氣稍稍抑止了不安情緒的蔓延。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "還記得那句拉丁文謎語嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "當然。它是一切故事的起點。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "消隱的終點啊！它們在夕光中交融。"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "我和李奧納多他們認為“消隱的終點”就是消失點的意思。而“交融”則是指將消失點都連接起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "連接起來，然後得到交點？那麼下一句“在夕光中交融”……"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "在黃昏的時候，將我，也就是濾光器放在它們的交點上？"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "沒錯。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "很好，我順從的羔羊們……你們已經完成了自己的使命。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "接下來就是一些乏味的收尾工作了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "香爐吐出縷縷白色的薄霧。它們延展、侵佔，漫無邊際地流淌著。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "APPLe某這是入了天堂嗎？似乎有些頭暈……"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "煙裡有毒，快屏住呼吸！"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "屏住……屏住……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "時間彷彿停止了流動。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空氣裡瀰漫著莨菪鹼與阿托品的快活氣息。它們篡改顏色，扭曲線條，毫無芥蒂地將一切物理法則拋諸腦後。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "嗯哼……上如其下，下如其上～"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "天真的孩子，你以為你是在為你的同伴們爭取時間……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "眼前的身影不斷傾斜、彎曲，只剩唇部一張一合，是無比聒噪的黑色烏鴉。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "一切都無濟於事。當你們背離了秩序，世界也會將你們遺棄在無盡的荒蕪之中……"
        },
        {
          "kind": "dialogue",
          "speaker": "維爾汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "老鷹……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "杳遠的鷹鳴聲將意識略微拉回。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "像是突然想到了什麼，神父快步走到窗前，神色也變得和緩。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "噢，我的記性還是這樣差。已經臨近黃昏，他們一定解決了……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "蒙塵的彩色玻璃與鮮血交織成一片動人的弧光海洋。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "阿爾貝托跪倒在薄暮的光中，從另一雙眼中窺見自己將死的面容。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "埃齊歐？這怎麼可能……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空氣中瀰漫著淡淡的腥氣，血與塵土將灰白色的衣袍層層浸染。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他剛從另一個戰場奔赴而來。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "你想讓世界屈服於你，但很遺憾……"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "世界有它自己的規則。"
        }
      ]
    },
    {
      "script_id": "2030518",
      "internal_title": "【S01】翡冷翠之春10.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一場以少勝多的戰役。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "落敗的神父仰躺在地，蒼白衰老的面容在血泊中逐漸模糊。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "咳咳。埃齊歐……你可真是條陰魂不散的惡犬。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "刺客從不會跟丟他的目標。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "我們部署了那麼多兵力……你是怎麼逃出來的？"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "聖殿騎士Ⅵ",
          "text": "我們部署了這麼多兵力，你早已無路可逃。"
        },
        {
          "kind": "dialogue",
          "speaker": "聖殿騎士Ⅵ",
          "text": "跪下迎接你的命運吧——秩序的意志不可違抗。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "街旁的門窗早已緊緊關閉。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "四下寂靜無聲，就連風也屏息著，似在等待一場殘酷的處刑表演。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "你們認為可以通過數目來扭轉一切。但請記住——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伴隨話語落下，更多同伴悄然走出陰影。"
        },
        {
          "kind": "dialogue",
          "speaker": "聖殿騎士Ⅵ",
          "text": "——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "聖殿騎士Ⅵ",
          "text": "你們是什麼時候……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人群不斷圍攏在埃齊歐身後。他們身手如影，幽靈一般出現，有的從屋頂躍下，有的從巷弄裡潛行而來。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "每個人都沉默著，眼神卻很透亮，彷彿說盡了一切——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "行於黑暗，侍奉光明。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "我們是刺客。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "人們向我伸出了援手——情況就是這樣。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "不……這不可能……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "埃齊歐半跪下身體，望向神父因痛苦而不斷顫動的雙眼。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "或許你們能調動全城的兵力。但刺客擁有的，可遠不止於此。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鋒刃乾脆俐落地貫穿心臟。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "不……這不該是終結……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他不斷咳嗽著，又神經質地笑了起來。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "呵……刺客，一群被虛妄理想驅使的傀儡。我詛咒你們……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿爾貝托",
          "text": "你們的每一次刺殺，都將離黑暗更近一步……"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "如你所願。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "離黑暗近一步，更近一步——這並非詛咒，而是所有刺客命定的歸途。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "刺客從不畏懼黑暗，正如鷹從不畏懼天空。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "信仰應帶來自由，而非仇恨。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他輕輕闔上阿爾貝托的雙眼。"
        },
        {
          "kind": "dialogue",
          "speaker": "埃齊歐",
          "text": "安息吧。"
        }
      ]
    }
  ],
  "fallback_fields": []
}