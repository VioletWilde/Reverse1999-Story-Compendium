  "chapter_title": "長夜鳴笛",
  "display_label": "",
  "title": "不歸者",
  "subtitle": "他們的影子被剪除。家人替他們哀悼，在無人歸來的夜晚。",
  "trails": [
    {
      "element_id": 3110110,
      "owner_episode_id": 3110113,
      "trigger_episode_id": null,
      "title": "抵達終點之前",
      "description": "唯一的終點，一萬種的途徑。",
      "action": "",
      "unlock_condition": "EpisodeFinish=3110113",
      "content_hints": [
