  "segments": [
    {
      "script_id": "200310",
      "internal_title": "【1.3】印度观星-9.1",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人們聚在院子裡的大陶缸前。"
        },
        {
          "kind": "dialogue",
          "speaker": "鬃毛沙礫",
          "text": "你確定……你要用這個東西嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "怎麼了嗎？這罐子裡的水剛剛好……我也正好能夠進去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鬃毛沙礫看著破敗的陶缸與其中混沌成一片的落葉與髒汙，沉默了片刻。"
        },
        {
          "kind": "dialogue",
          "speaker": "鬃毛沙礫",
          "text": "唔，你對實用性的追求比我想像的高。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "對了，還有……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伽菈波那將那枚毗濕奴神像交給了瑪蒂爾達。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "咦？伽菈波那小姐，你不帶著它嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "不……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她搖了搖頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "鬃毛沙礫先生說過的話……不無道理。這是我們的底牌，它離庫瑪爾越遠越好。"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "唔……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "那伽菈波那小姐，你帶上這個！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "遞過來的礦石晶瑩剔透，仿佛一顆剛摘下來的星星。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……這不是你的……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "我的靈擺！我珍藏的、純度極高的珍品！這樣好的水晶，我自己總共都沒有幾顆……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "我發現你所說的冥想理論，一定程度上和水晶占卜的某些理論根源非常相似～所以如果有水晶幫助你平衡磁場、引導靈知的走向……想必一切都會順利很多——"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "你……"
        },
        {
          "kind": "dialogue",
          "speaker": "瑪蒂爾達",
          "text": "哼哼，不用驚訝，這是天才基本的反應速度！"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……謝謝。"
        },
        {
          "kind": "dialogue",
          "speaker": "鬃毛沙礫",
          "text": "很好，看來不能理解“在水裡冥想”這個行為的人只有我一個——但沒辦法，山岩就是多姿多樣……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伽菈波那迅速地將腿探入陶缸內，如同感覺不到冰冷一般。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "好的……靈擺，還有足夠多的液體……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "現在，只需要……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "——想著庫瑪爾。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "卸掉雙腿支撐的力，伽菈波那放任自己的身體滑入水中。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "聲音迅速地遠離了她的世界。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "寒意沒過頭頂，自四面八方侵襲而來。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "哈啊……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "或真或假，亦虛亦實，世界重新浮現於眼前。"
        },
        {
          "kind": "title_card",
          "text": "？？？"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……果然，會是這裡。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "我們第一次見面的地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "眼前熟悉的石階比記憶中的要長得多。粗礪的紅色磚瓦，精心計算的圓弧，簡塔·曼塔天文臺每一處都有著獨屬於它的美感。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "呵，看來庫瑪爾為這場會面下足了心思。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "竟然在幻境裡還原出了這些……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在頂端終點靜立的身影就像一個黑色的奇點。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她知道那是誰。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "我心中的幻影，罷了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "左腳踏上了第一層臺階。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "意料之中的困難出現在眼前。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "看來她把我小時候的樣子記得很清楚。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "攔在面前的身影，與她小時候的模樣相差無幾，總是緊攥著拳頭，臉上的表情永遠像是在對抗著什麼。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而現在，“她”的憤怒或許來自於這場不請自來的入侵。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“她”朝伽菈波那奔去，靈活地揮動著拳頭。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "唔，好疼……！"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "我小時候的拳頭，有這麼堅硬嗎？"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "出去，這不是你該來的地方！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“她”驅趕著伽菈波那，體態明顯受過嚴格的訓練。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "啊……是的。媽媽曾教過我……對付那些壞小子的招數。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "離開！"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……呃唔，真是……好奇怪的感覺。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "是庫瑪爾讓你在這裡的嗎？讓你保護著……這段時間的回憶？"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "看來必須過了你這一關，才能前往我想要到達的地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "面對過去的幻影吧。"
        }
      ]
    },
    {
      "script_id": "200311",
      "internal_title": "【1.3】印度观星-9.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "啊……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "幻影消散了，又重新在遠處聚攏。與此不同的是，“她”這次不再帶有那樣強烈的憤慨。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "呵呵……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "天文臺的光影使“她”逐漸模糊，聲音也更加飄遠。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "從過去，到現在，到未來……"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "你所要執著的，追逐的，面對的……是什麼……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伽菈波那低下頭，看了看自己的手掌。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "你還是像以前一樣，總是問一些沒有答案的問題。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "你認為我追逐的“應該”是什麼呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她收起手指，將手輕輕握起。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "別想誤導我，庫瑪爾。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "天文學這條路，從那天之後我就沒有放棄過。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空曠的空間裡，除了回音，什麼也沒有留下。幻影已經離開了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她抬起頭，看著幾乎望不到頂的天階。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……繼續前進吧。"
        },
        {
          "kind": "title_card",
          "text": "3#8"
        }
      ]
    }
  ],
  "fallback_fields": []
}