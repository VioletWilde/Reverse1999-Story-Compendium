      "element_id": 1132201,
      "owner_episode_id": 11322,
      "trigger_episode_id": null,
      "title": "순백색 서류철",
      "description": "인간은 근심 속에서 살아가는 데 익숙해졌다.",
      "action": "",
      "unlock_condition": "EpisodeFinish=11322",
      "content_hints": [
