{
  "episode_id": 11021,
  "chapter_id": 110,
  "chapter_title": "复乐园",
  "display_label": "",
  "title": "朝圣于来时路",
  "subtitle": "血与泪交融在一起，那魂灵倒在地上，无声啜泣。",
  "trails": [],
  "segments": [
    {
      "script_id": "101027",
      "internal_title": "第十章10-20.1",
      "items": [
        {
          "kind": "title_card",
          "text": "朝圣于来时路"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-祭坛-差分1-阿尔卡纳肉球+信徒（无洪水）"
        },
        {
          "kind": "title_card",
          "text": "火山神殿·祭坛"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伴随着教徒的吟诵声，漆黑的肉团如心脏般不断跳动着，涌动的墨色液体淌入井中那些没有质量，亦没有湿度的雨。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "那是……阿尔卡纳？！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "闪回"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "闪回2"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "恢复"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "我纺织的线连向了井底……为什么？这些线的使命不该流向那里……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "盲眼者试图扶住飞转的纺轮，指尖却被擦出一道金色的伤痕。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "纺车也无法停下……"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "维尔汀，快走——"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "天真。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "攻击"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒挥动权杖，漆黑的黏腻液体化作绳索将二人牢牢束缚在原地。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "仪式已经开启，复苏之母即将降临，休想亵渎这神圣的时刻！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒缓缓走近。吟诵声中，她自水中拾起一块白骨。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "看看这些骨殖，如此苍白冷峻……堪称典雅、神圣。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "这是不属于被窃夺之世的造物，唯有被抹去的空白时代才能孕育。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "而现在，我们终于等到奇迹之卵显现，复苏之母将这已逝的时代带回给了我们——"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "祂已重临！与生俱来的枷锁于今破去，过往的荣光再度照耀！"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "空白时代？带回已逝的时代？……不，时代应该要向前走的。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵，尚处于愚昧中的人啊，看在你为我们开启仪式的份上，我将原谅你的冒犯。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "即便你对此一无所知，但你的贡献会被铭记。在新世界里，或许还会被授予圣名。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "不、不……"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "不对，不能让纺车再转下去……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "盲眼的女士浑身颤抖着又一次伸出手，试图停下那转动不息的纺车。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "——快停下！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "特效"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "做梦！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒的长弓猛地敲击地面，整座神殿微微颤动起来。丝线在刹那间绕上兀尔德的身体，向盲眼者汲取着最后的力量。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "唔……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "仪式的光辉更甚，而盲眼者的脸色越发惨白。金光散去，她晕倒在了翻涌的雾气中。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呼……呵呵，我还以为又会像1999年那般……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "可惜，你已经不再有过往的力量了。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "仁慈的复苏之母已经携来伟大的奇迹！任何人都休想阻止你们可悲命运的降临！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒挥动权杖，墨色的粘液包裹住盲眼者的身体，将她与纺车一同沉入黑暗。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "德洛丝女士！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "别着急，维尔汀。很快，无论是你还是兀尔德，都会与伟大的复苏之母融为一体。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "谦卑地领受这无上的荣誉吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "使徒回身看向周围的教众，他们泣血泣歌，任水上涌，淹过他们的身体。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "——缓缓流动着的水，没有水的重量，也没有水的湿度。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "受击"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身后正欲启动的神秘学道具被猛地击落。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "收起那些小伎俩，它只会徒增你的可笑。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵，无论是你，还是那个撞开门的卑下小虫子——都是一样愚蠢。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "不过她已经意识到了自己的无知，最终奉献了自身血肉和灵魂，重归复苏之母。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "如果你愿如她一般领受这份恩典，便奉献吧！仁慈的复苏之母也会吸纳你所有的悲苦，赐予你享受不尽的来日恩典。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "你错了。诺谛卡进入门中的原因绝非如此——她有自己的信念。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵……那你就自己去向她索要答案吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "束缚的绳索猛地收紧。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "领受这份荣光吧。你的血肉将归于复苏之母，铺就祂降临之路！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "变暗"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "几近被完全覆盖的视野中，粘稠的“门中之手”顺着冗长的甬道卷入山体内，急速靠近。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "窒息感迅速袭来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "嘘——嘘————"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "遥远的风声从神殿的巨口中传出。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "奉献吧！当你拥抱那宽仁的母亲，回馈你的必是无穷的大能。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "咳、咳咳！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "视线中开始出现血色。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "唔……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "温暖的地方，像是在母亲的怀中。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "睁开眼吧，这里会将梦延续。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-白色背景 睁眼特效"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "死海1"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "死海2"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "停顿"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "死海4"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "别紧张，维尔汀。现在还不是最高兴的时候！"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "等我们呼吸上第一口真正的空气……等我们在外面胡吃海喝……等我们回到我们自己的国家……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我们有的是值得颤抖的好事！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "是“圈环”的声音……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "向着声音的来处走去，试图听得更清楚一些。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "是你吗，“圈环”？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "死海4"
        },
        {
          "kind": "dialogue",
          "speaker": "学生Ⅰ",
          "text": "来，我们一起开门吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "学生Ⅱ",
          "text": "三，二，一——"
        },
        {
          "kind": "dialogue",
          "speaker": "伊莎贝拉",
          "text": "愿自由与我们同在！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "伊莎贝拉、“便士”……大家都在这里吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "死海4"
        },
        {
          "kind": "dialogue",
          "speaker": "学生Ⅰ",
          "text": "冲啊——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "伊莎贝拉",
          "text": "维尔汀……！快出来啊！！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "大家……等等我……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "死海4"
        },
        {
          "kind": "dialogue",
          "speaker": "斯奈德",
          "text": "那来听听大家的愿望，怎么样？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "斯奈德……？"
        },
        {
          "kind": "dialogue",
          "speaker": "斯奈德",
          "text": "老爷居然这样毫无防备地躺着……呵呵。"
        },
        {
          "kind": "dialogue",
          "speaker": "斯奈德",
          "text": "我们呀，可陪着老爷折腾了好久……不要点奖励，那怎么行呢……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "轻柔、带着一些沙哑的声音，像是一片羽毛般飘走了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "死海4"
        },
        {
          "kind": "dialogue",
          "speaker": "玛尔塔",
          "text": "我也不知道我该去往何处。因此，我想请您为我解答疑惑。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "玛尔塔女士？不，那是……"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "……玛尔塔女士，我能回答您的并不多。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "但我想——命运比我们更清楚自己的命运。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛尔塔",
          "text": "……感谢您的解答。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛尔塔",
          "text": "如此，我明白了。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "不，别走——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "停顿"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……为什么……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "为什么……总是这样？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "看啊，你失去的那些都在这里。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "向前一步吧，回到你的朋友们身边，回到那些温暖的怀抱之中。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "脚步不由自主迈向声音的来处，却又停下。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……不，不是那里。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "那是我的来时路。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我还有应尽的使命，有要求的答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我该去的地方是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "独白黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "回身，另一边隐约有声音传来。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……维……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "于是坚定地向去路迈步。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……维尔汀……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-黑色背景"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……维尔汀！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "这里是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "离开朦胧的幻梦，映入眼帘的是无尽的黑暗。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑暗的四壁是蠕动的肌理，脚下是沾染着血肉的白骨与由血浆、体液混杂而成的液体。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空间间歇性地鼓动，不时向着黑暗的尽头喷发一阵阵令人作呕的恶臭。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "这就是……“门”内真正的景象吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "“门”把被投入的祭品都……唔！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鬼火"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "小心，如果滑倒的话，就会和他们一样了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "带着哭腔的稚嫩声音响起，那是黑暗中唯一微弱的光源。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……这就是这里的“现实”。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "你是谁？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我也不知道我是谁……我什么都不记得了。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我只是觉得自己还不想和他们一样，所以留在了这里。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "但你……你好像都还记得。你为什么会来到这里？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……我被作为仪式的祭品投了进来。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我必须尽快出去。你知道离开这里的方法吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我不明白你所说的，我什么都想不起来了……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "或许我可以帮你引路。但你必须告诉我，你想去哪儿？为什么一定要去那里？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……我要离开这里，去到“门”的外面。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "为了寻求一个答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "“答案”。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "那个“答案”，也是你来到这里的理由吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……或许确实如此。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "它值得你如此追寻吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我不知道。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "那你有没有想过，要是这个“答案”根本就不存在，要是你追寻的道路尽头根本就一无所有……又该怎么办呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……我想过很多次。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我甚至想过，现在所走的每一步可能都踩在一条不存在的道路之上。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "但一路以来经历的种种让我明白了，那也没关系。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "为什么？明明之前的一切努力都白费了。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "为此付出的那些牺牲和血汗，又要以什么来为它们作答呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "那些努力并没有白费。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "往昔的一幕幕如在眼前。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "那些牺牲，那些挣扎，那些构成了前行意义的人们。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我会记得他们。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他们真实存在过。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "所以，纵使道路尽头是虚无……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "“我也要走下去。”"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "光点摇晃着，轻声而又坚定地吐出这句话。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……啊，是的。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "没错，我想听到的就是这个回答。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鬼火2"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "微弱的光点闪烁着，逐渐变得明亮。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我好像想起来了。你所说的那些，也是我曾经抱有的信念。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "所以我还在这里。留在这里的情感不是后悔，也不是空虚。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我是“满足”的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "光点——不，现在应该称之为“光团”了。它跃动着靠近，散发着温暖的光。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "——握住我的手！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "你的手？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "深入我的心脏，那里应该留下了什么！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "将手伸入光团的中央，舒适而柔和的触感落在手心。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "是布料？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "不、不是这里。应该是被保护在更深处的地方，嗯……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "对了，就在那里！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "复活"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消特效"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗道具-吊坠"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "摊开手，手心里躺着一个吊坠，里面的小小晶体反射着不存在的光。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "就是这个。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我留下的……答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一点点熟悉的温度通过吊坠传来，上面刻着熟悉的姓氏。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“阿蒙森”。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "你是……诺谛卡？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗道具收起"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "是的。“诺谛卡”，我的名字。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "谢谢你，维尔汀。我终于找回了我的名字！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "血肉自光团处再度生长。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一双无形的手拉住了自己。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "“归乡的路与姓名相连。迷途的孩子，思念会牵你回家。”"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "随着她一字一句道出话语，周围的场景逐渐开始变幻、溶解。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "虽然“地母”不在这里，但我的确梦见了她——她为我指出了离开的路。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "来吧，维尔汀。我会带你出去！"
        }
      ]
    },
    {
      "script_id": "101028",
      "internal_title": "第十章10-20.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "紧握住诺谛卡的手。尽管身处地狱，这双纤细的手却依旧充满力量。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身体逐渐溶解，视野逐渐变黑，如同这个世界在否定这份意志。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但彼此的双手依旧在末日紧紧相握。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "失去视力，我依旧可以向前走；失去双脚，我也可以爬行着前进。就算失去身体……"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "也可以用血肉铸就新的身体。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "——因为我也不会放弃寻找“答案”，寻找我的“好消息”。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "变身开启"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "变身结束（爆炸闪光"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图-诺谛卡抱着维尔汀"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "啊……"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "维尔汀！我们做到了——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "世界的新生由风而起。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我们现在……在神殿的空中？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "诺谛卡，你的样子！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑色粘液自她的体内伸展，化为骨骼，而洁白的布料构成了羽翼。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓声似从远方隐隐响起，她的翅膀是最高昂的旗帜，宣告迎风招展的胜利。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "很像……"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "这和我梦中“地母”的样子很像！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她骄傲地抬着下巴，踏碎神殿的巨石，跳跃间带起一阵阵风。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "下一刻，她踏风而动，摆脱无数双手的束缚，冲向天际。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "太好了，这样一来，我就可以带你们回家了！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "危险，诺谛卡！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "快黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "快亮"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "动作"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "巨兽挥动着新生的羽翼躲开飞来的碎石，看向危险来源的方向。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "收翅膀"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消人"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-祭坛-差分1-阿尔卡纳肉球+信徒（无洪水）"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "震"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "神殿深处正传来阵阵颤动。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "那、那是什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……阿尔卡纳……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓动的不定形黑色肉团伸出无数双手，紧紧融在了石壁上，整座神殿瞬间如活过来了一般吐息着。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "如果“门”是嘴，那么我们先前或许就是被困在了胃袋中……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "风自神殿内穿过，撞在黑色肉团上，发出呢喃一般的呼唤声。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "是的……整座遗迹就像有生命一般活着。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "而阿尔卡纳……她……也许就是其中的“心脏”。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "恐怕很快……她就会完全复活。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}