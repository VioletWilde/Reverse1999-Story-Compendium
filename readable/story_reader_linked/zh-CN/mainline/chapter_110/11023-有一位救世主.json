      ],
      "content": [
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "永不间断的大雨会导致大洪水，一个显而易见的结果。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "这是最后的报告了——人和飞鸟的时代已经结束，接下来将是鱼的时代。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "不过鱼还要再等等，因为你，世界毁灭被推迟了大约一小时。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "现在全世界的人都欠你一小时，直径多大的功勋章才配得上你？"
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "一定还有办法",
          "edge_label": "",
          "branch": [
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "是的，就算雨伞不管用，你也还有一艘方舟。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "像以往保存有生力量时那样，让有资格的动物乘上方舟。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "你就还可以继续战斗下去。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "请让我完成我最后的任务，即使你不愿意听。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "得益于万有引力，地势较高处的居民可以在洪水中存活久一些。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "你还有时间抱着橙色小狗叙叙旧，看着世界末日从一个极点漫向另一个极点。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "或者……你可以像个军人一样，遵守命令直到最后一刻。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "“找到那个作家。”"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "这个任务的重要性已经不言而喻了。"
            }
          ]
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "快闭嘴吧",
          "edge_label": "",
          "branch": []
        }
      ],
      "link_source": "supplement_episode_id"
    }
  ],
  "segments": [
    {
      "script_id": "101031",
      "internal_title": "第十章10-22.1",
      "items": [
        {
          "kind": "title_card",
          "text": "有一位救世主"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-祭坛-差分2-完全体阿尔卡纳（有洪水版）"
        },
        {
          "kind": "title_card",
          "text": "火山神殿·祭坛"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "啊啊……竟能有幸亲眼目睹……何其荣幸，何其光耀！至高无上的神秘学圣母啊——"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "您卑微的信众渴望您的引导！请显示您的大能，席卷一切，重塑一切，带我们回归最初的乐园！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "阿尔卡纳……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "复活的神祇抬起无尽之手中的一肢，在空中轻点。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "井中涌出的液体骤然激荡，将没过的一切事物吞噬殆尽。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "那是……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "小心避开那些液体！那不是普通的水！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "井中涌出的那些水……你们在制造“暴雨”？！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "“暴雨”？呵呵……哈哈哈哈！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "可悲的羔羊，你对祂的伟大一无所知。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "这并非那徒有表象的“暴雨”。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "复苏之母、秘之教诲者将带给我们的——"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "——是一场真正的、将一切带往过去的“洪水”！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "主角看手表1",
          "text": "SPINE动画-维尔汀查看手上的计时器"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-南极海域"
        },
        {
          "kind": "title_card",
          "text": "南极海域"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅰ",
          "text": "舰长！报、报告舰长！水……有水在升上来——！"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅰ",
          "text": "甚至已经没过甲板……升到脚边了……"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "只是船舱进水，不用惊慌，通知损管排查漏水源头！"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅰ",
          "text": "不，那不是海水，而是……"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅱ",
          "text": "报告舰长！"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "又发生什么事了？！"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅱ",
          "text": "是重塑之手！他们突然停止了攻击，好像在吟唱什么咒语……"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "咒语？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "移动"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "吟诵声隐约从冰封的海岸上传来。"
        },
        {
          "kind": "dialogue",
          "speaker": "众教徒",
          "text": "千百万潮水，皆遵循潮汐奔流"
        },
        {
          "kind": "dialogue",
          "speaker": "众教徒",
          "text": "以亵渎不洁的姿态，玷污天幕"
        },
        {
          "kind": "dialogue",
          "speaker": "众教徒",
          "text": "破除枷锁者，主宰一切的复苏之母"
        },
        {
          "kind": "dialogue",
          "speaker": "众教徒",
          "text": "于今降下，至高福祉"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "船舱内"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "警报"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "各单位保持冷静！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "舰长小心翼翼地走近从内舱突然涌出的洪水边缘。"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅰ",
          "text": "舰长！这些水有问题——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "舰长的鞋子已经没进水中。"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "……什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "我的脚……消失了？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-南极海域-差分1-洪水上涨扭曲版"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浸入水中的部分迅速溶解、消逝，化为万千洪水中的一滴。身体沿着接触面被整齐地切断，没有流血，也没有痛感，仿佛本就不存在。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "眼前的一片汪洋并未倒映出任何画面，而是呈现着十年前、百年前、千万年前的废墟景象。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "万千水鸟疯狂地齐聚、扎堆、俯冲入水，就像火化般被洪水烧熔，消失在漫天遍地的水中。"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅱ",
          "text": "……呜啊啊啊啊啊！！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "第一声惊叫爆发，来自一位弱小的士兵，他抱头鼠窜，企图跑向高处躲避。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "然而在他还未发出第二声呼救时，却已经完全被洪水吞没了。"
        },
        {
          "kind": "dialogue",
          "speaker": "众教徒",
          "text": "来日的恩典即将显现，吾等信徒将于今日蒙福"
        },
        {
          "kind": "dialogue",
          "speaker": "众教徒",
          "text": "愿您至高无上之躯，再度降下——"
        },
        {
          "kind": "dialogue",
          "speaker": "众教徒",
          "text": "以无穷大能，重塑应许之地！"
        },
        {
          "kind": "dialogue",
          "speaker": "军舰士兵Ⅰ",
          "text": "——舰长！！"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "这不是正常的洪水，而是刻雷乌斯长官所说过的……"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "快联系索姆将军！全员将平衡伞打起来！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一只只伞柄被飞快举起，伞罩中闪烁出强有力的光芒。"
        },
        {
          "kind": "dialogue",
          "speaker": "舰长Ⅱ",
          "text": "平衡伞能够抵挡“暴雨”，那么也一定可以抵挡……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "然而话音未落之际，洪水已然将人连同平衡伞一起吞噬。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一顶顶伞以及一个个举着伞的人瞬间融化在水中。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "士兵的呼救声与重塑海兽的咆哮声不绝于耳，而下一瞬，一切声音都化为空寂。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-伊戈尔军驻地"
        },
        {
          "kind": "title_card",
          "text": "前芝诺近卫团某驻地"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "……99年的一切又一次重演了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "将军眺望着远方舰队的沉没。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "对于下达指令的人来说，他们不过是沙盘上的数字，棋盘里的棋子。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "相对即将发生的灾难，他们的力量微乎其微。然而他们不曾知晓这点，而知晓这点的人并不在乎他们的生命。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "那些曾被不断投入的生命和热情，最终也只是归于一片空白。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "海平面飞速上升，远方的陆缘冰已经不见踪影。整个世界只剩下一片洁白如新的洪水，像透明的纱布，将所有杂质抹去。"
        },
        {
          "kind": "dialogue",
          "speaker": "托勒密",
          "text": "父亲，我们已经和姐姐的队伍完成会合了。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "人数清点完毕了吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "托勒密",
          "text": "包括受到重塑之手影响的病患在内都确认完毕了，与名单一致，只差丹尼洛夫机长和……"
        },
        {
          "kind": "dialogue",
          "speaker": "托勒密",
          "text": "姐姐，她不在这里。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "我明白了。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "准备动身吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "托勒密",
          "text": "我们要去哪里？"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "去一片能自洪水中庇护我们的奇迹之地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗道具-黑色盒子“小奇迹”浮在半空发光"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "将军从怀中掏出那个黑色的盒子。它浮于半空，在将军手上缓缓旋转起来，隐约向外辐射着一圈圈金光。"
        },
        {
          "kind": "dialogue",
          "speaker": "托勒密",
          "text": "这就是我们和重塑之手交易的成果吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老将军点了点头。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "不再有无谓的牺牲，我们将踏上的是一条全新的道路。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗道具收起"
        },
        {
          "kind": "dialogue",
          "speaker": "托勒密",
          "text": "可姐姐她……"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "她亦有自己选择的道路。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "将军将目光投向遥远的雪山之巅，像是看着自己的来时路。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "我相信她。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-火山坡（复用2.4 覆雪丘陵）"
        },
        {
          "kind": "title_card",
          "text": "火山神殿·山坡"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "躁动的魔精、异常的海水情况、突然发生的雪崩……"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "——该死，一定是重塑之手的仪式已经开始了！我们得尽快想出对策……"
        },
        {
          "kind": "dialogue",
          "speaker": "护卫兵",
          "text": "老板！现在不是说这些的时候！！"
        },
        {
          "kind": "dialogue",
          "speaker": "嚼嚼松果",
          "text": "雪崩要来了！路线更改——各位！跟好我！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "护卫兵一把扛起还在试图分析现状的研究员，加足马力飞快地向上冲去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "震动"
        },
        {
          "kind": "dialogue",
          "speaker": "嚼嚼松果",
          "text": "糟糕，雪浪要冲下来了！"
        },
        {
          "kind": "dialogue",
          "speaker": "护卫兵",
          "text": "呃——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "护卫兵在积雪剧烈的坍塌中试图稳住身体，但雪崩的震动还是轻易击垮了渺小的两人。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雪崩"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雪崩2"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一团巨大的雪块袭来，将承载磁流体的玻璃缸击飞了出去。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "该死！"
        },
        {
          "kind": "dialogue",
          "speaker": "护卫兵",
          "text": "——老板，你的头！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "头"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图-莫莉德尔救乌尔里希头"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玻璃缸运动的抛物线止于一双稳稳的手。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "……呼，还好赶上了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "骤风中，黑色的头发从帽檐下飘飞出来。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "丹尼洛夫机长，降低高度，放下挂梯，接应他们。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "拉镜头"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "下拉"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "各位，快跳过来！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "剧烈的风声中，她的声音却显得清晰而有力。"
        },
        {
          "kind": "dialogue",
          "speaker": "嚼嚼松果",
          "text": "莫莉德尔中尉！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "抱歉，我们来迟了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "机舱"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "护卫兵连忙将意识唤醒者的身体推进机舱，在前芝诺近卫团副官的帮助下，两边的队伍终于会合。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "所幸除了组长的玻璃装置些微破损外，并无任何神秘学家和企鹅的伤亡。"
        },
        {
          "kind": "dialogue",
          "speaker": "嚼嚼松果",
          "text": "多亏您及时赶到，莫莉德尔中尉！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "客套话就不必再说了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "快切"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "水位在上升——它绝非自然的海水，其毁灭性更甚于“暴雨”。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "这场“洪水”正将所有东西冲刷殆尽。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "重塑之手的仪式已经开始了，我们必须采取行动。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "研究员将头重新固定回身体，取出了“非对称核素R”采样装置。\n烈风并未阻碍磁流体一如既往地在缸内快速流动。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "采样装置几乎在眨眼间就盛满了金色流体。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "目前空气中急剧上涨的非对称核素R浓度、以及与“暴雨”相似的一系列现象或许可以导向一个结论——"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "“洪水”与“暴雨”存在着一定关联，或者进一步猜想，“洪水”是另一种形态的“暴雨”。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "那么，你们之前所说的“星锑”唱片或许可以发挥作用？"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "你理解得很快，中尉。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "既然唱片可以延缓时代病的发展，或许也可以延缓仪式的进程。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "我们现在必须尽快播放唱片，生成稳定性磁场。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "为了让它的辐射范围能够覆盖到山中的仪式现场，我们需要抓紧时间赶往山顶！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "丹尼洛夫机长！"
        },
        {
          "kind": "dialogue",
          "speaker": "机长",
          "text": "收到！请各位坐稳！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "默契让军人之间略去了多余的指令交换，“小犬号”在螺旋桨轰鸣中倾斜着爬升。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "以目前海平面上升的速度来看，我们能来得及吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "不止有我们在试图阻止重塑之手的仪式，司辰她们也同样在努力着。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "喧嚣的风声中，磁流体的声音异常清晰坚定。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "莫莉德尔中尉，从过往无数次的科研，无数次的成功与失败中，我学会最为关键的一点就是——"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "相信我们的协作者，然后，全力以赴。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-祭坛-差分2-完全体阿尔卡纳（有洪水版）"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……水面在迅速上升。再这样下去，洪水会将一切全部吞噬。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我们必须破坏仪式，阻止洪水的上涨。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "仪式、雾气、洪水——一切都缠绕在那具诡异的庞大身躯之上。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "攻击阿尔卡纳，或许能找到破绽！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "好、好的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "攻击"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "铅箭破开浓稠的空气，钉在诺谛卡蠢蠢欲动的足爪边。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呵呵，痴心妄想。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "世界重溯是必然的结果，仅凭你们这些虫豸也想阻止？"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "所谓的现在，还有现在正发生的一切——都只是虚假根系上长出的罪恶果实，本就不该存在。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "你们将见证洪水没过一切。所有罪孽都将消失，世界会回到最初始的、它本该有的样子！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“阿尔卡纳”巨大的躯体动了动，从那模糊不清的面庞上似乎能看到熟悉的笑容。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "啊，啊！至高的圣母！我已聆听，我已明悟，我将践行您的教诲！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "请降下您仁慈的威能——将她们永远留在这里！"
        }
      ]
    },
    {
      "script_id": "101032",
      "internal_title": "第十章10-22.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-祭坛-差分2-完全体阿尔卡纳（有洪水版）"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "诺谛卡，小心那些黑色粘液的攻击！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "维尔汀，十四行诗，抓紧我！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "加速"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飞鸟伸展翅膀，迎着粘液化作的无数箭矢猛地飞去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "毒液"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "毒液"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "恢复"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "动作"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消人"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "减速（蛛丝）"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在即将与雨幕般的箭矢相撞之时，诺谛卡收起双翼，从洪水和箭雨的夹缝中穿行而过。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "呜、呼……大家没事吧？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "你的身体被灼伤了！诺谛卡，我帮你治疗一下！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "我、我还好，没关系，你们抱紧我就好！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "但我们不能一直以你的受伤为代价躲避进攻。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "……我知道了。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "告诉我要怎么做吧，维尔汀！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "我还无法熟练运用这份新的力量，但我相信，你能想出更好的办法！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "请您指挥我们进行作战吧，司辰。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "嗯，助我一臂之力吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "动作"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "加速"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "羽翼再次向天空伸展，而伙伴也坚守在地面。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "卑下的虫豸，挣扎是徒劳的！"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "“洪水”带来的空白见证者们将聆听吾辈的呼唤。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "笑声毛骨悚然。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "无论是你们，还是神殿之上试图搞小动作的那些蝼蚁，都将成为旧日复苏的奠基石！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "司辰，恐怕乌尔里希组长他们会有危险！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "冷静下来，十四行诗。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "请你尽可能攻击阿尼姆斯。如果能阻止她施展神秘术，或许能对乌尔里希组长那边有所帮助。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "还有……如果可能的话，尽可能留意德洛丝女士的踪迹。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我明白了，司辰。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消人"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "视频1"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "视频3"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "视频2"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "动作"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "加速"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "维尔汀，洪水越涨越高了，再这样下去，我们就没有空间飞行了……！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "嗯，我们必须远离洪水，创造作战空间。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "诺谛卡，你有办法破坏神殿吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "破、破坏神殿？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "没错，你刚才飞行时踏碎了侧壁的岩石，就像那样。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "向前望去，诡异神祇的庞大身躯正通过无数黑色的血管与整个神殿紧密相连。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "供能"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "神殿在为阿尔卡纳供给力量。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "如果能冲破神殿，既能削弱阿尔卡纳，创造飞行空间，又能利用落石进行攻击。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "呼、呼……我明白了，交给我吧！"
        }
      ]
    },
    {
      "script_id": "101033",
      "internal_title": "第十章10-22.3",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-山巅"
        },
        {
          "kind": "title_card",
          "text": "火山神殿·山巅"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "这里就是神殿的正上方了，乌尔里希组长！"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "海平面上升的速度很快，我们的时间不多了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "未等直升机停稳，中尉便率先跃下，接应着意识唤醒者走出了机舱。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "事不宜迟，立刻开始设置唱片机，生成稳定性磁场……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓捣"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不行"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "该死！这里的地磁情况在不停变动，唱片机无法校准至理想调校状态！"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "这与我之前的两千三百次实验的情况都不一样，大气中非对称核素R的浓度超乎想象！"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "变量太多，在这种情况下，我甚至无法确定“星锑”能否如我们所期望的那般奏效……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "磁流体混乱地将自己分散成无数小点，而后又猛烈聚拢。"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "总之先检测环境中非对称核素R的浓度，对应调整实验数值；接下来改进信号处理算法，设置防护设施；要是能推导地磁场变化规律……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓捣"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不行"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "**的[拉普拉斯脏话]——这个装置冻坏了，有人能搭把手——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "震"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "自脚下的又一次震动险些将磁流体震倒。与此同时，头顶传来了奥利图欧的啸叫。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "小心，乌尔里希组长。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉眼疾手快地扶住了研究员。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "只是被冻坏了的话，这个环境监测装置交由我修理。嚼嚼松果，排除那些干扰实验的魔物！"
        },
        {
          "kind": "dialogue",
          "speaker": "嚼嚼松果",
          "text": "中尉，那似乎不是普通的奥利图欧，那中间的是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "白骨构成的庞大生物遮蔽天空，领着疯狂的奥利图欧向山巅的众人袭来。"
        },
        {
          "kind": "dialogue",
          "speaker": "嚼嚼松果",
          "text": "哇！好一块硬骨头！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "……各位，做好战斗准备，保护组长完成实验！"
        }
      ]
    },
    {
      "script_id": "101034",
      "internal_title": "第十章10-22.4",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-山巅"
        },
        {
          "kind": "title_card",
          "text": "火山神殿·山巅"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "嚼嚼松果",
          "text": "这些该死的丑鸟越来越多了……！"
        },
        {
          "kind": "dialogue",
          "speaker": "企鹅",
          "text": "嘎啊——"
        },
        {
          "kind": "dialogue",
          "speaker": "护卫兵",
          "text": "精神错乱的程度也在加深！……哇啊！机长！别咬我的五倍压缩巧克力口味军粮！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "乌尔里希组长，你还需要多久！"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "……神秘学材料设置完毕，方位确认，环境数据确认。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓捣"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不行"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "——第二十一次实验失败！该死，磁场方位和预设值不符，唱片无法发挥作用！"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "最后一次尝试……"
        },
        {
          "kind": "dialogue",
          "speaker": "护卫兵",
          "text": "老板，我们必须得走了！——我快拉不住丹尼洛夫机长了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "松鼠中士、企鹅列兵一一被莫莉德尔甩进了机舱里。最后，她也一脚踩在了舱门的边缘上。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "乌尔里希组长，拉住我的手！"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "预设值调整，参数确认，最后一次——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中尉提起磁流体的领子飞离山巅的前一刻，磁流体终于将指针第二十二次放在了唱片之上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "移动"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图-海平面停止上升"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "地磁场的强烈波动停止了……"
        },
        {
          "kind": "dialogue",
          "speaker": "乌尔里希",
          "text": "……成功了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "拉远镜头"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "看——海平面不再上升了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "移动"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-祭坛-差分3-战后坍塌版（有洪水）"
        },
        {
          "kind": "title_card",
          "text": "火山神殿·祭坛"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "听见了吗，司辰？是星锑常听的摇滚乐！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "洪水平静下来了，看来是乌尔里希组长他们减缓了仪式的进程！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "趁不受洪水干扰的时候，诺谛卡！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伴随着摇滚的节奏，飞鸟踏碎了神殿的最后一根支柱。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "我、我做到了！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "干得漂亮，诺谛卡。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "神殿开始坍塌了，小心躲避！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "石落"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飞鸟穿过隆隆的坠石。一阵剧烈的震动后，过往的祭坛已成废墟。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "落石将一切活物掩埋，最底层的巨石下露出信徒们的黑袍一角。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "呃……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尼姆斯",
          "text": "亵渎……之人……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "石落"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "又一块石板落下，喷出一口血与气后，她再也无法发出声音。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "……这里应该安全了……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "诺谛卡小心翼翼地在没有洪水的狭窄空间内伸展翅膀，将二人安置在不受洪水与落石侵袭的安全地带。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "所有的一切……都掩埋在了废墟和洪水之下。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "但阿尔卡纳……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "崩塌"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "可怖的神祇身体逐渐溶解，化作了熟悉的人形。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "祂脚尖轻点于洪水之上，抬头仰望不断震动着、坍塌中的神殿。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "这篇终章，确实缺了一首动听的挽歌。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "嘘……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "于是碎裂的神殿静了下来，所有声音都被泯灭，唯余祂的话语在空中回响。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "当歌谣的尾音落下，洪水将再度翻涌。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "旧时代将被寻回，新秩序将要诞生。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "阿尔卡纳站在水中，对众人露出一个微笑。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "你的世界正迎来终结，“众人跟随的救世主”。可惜，你还不能停下。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "再会，维尔汀……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "在“我们的世界”。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身影消失在上涌的水中。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
