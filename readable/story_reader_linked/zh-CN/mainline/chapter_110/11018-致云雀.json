      ],
      "content": [
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "好了，我的默哀结束了。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "我不是什么虔诚信徒，也算不上无神论者，但我尊重她的牺牲。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "虽然她的行为实际上愚蠢且不知所谓。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "可正如我之前所说，忠于一些愚蠢的意志恰恰能证明一个人的忠诚。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "不论是为了家族使命，还是探索精神，或者是那个睡前童话故事。她都死得其所。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "死得愚蠢但忠实。"
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "这一切发生得太快了",
          "edge_label": "",
          "branch": [
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "你经历了这么多牺牲，居然还期望每一次都有充足的铺垫？"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "抱歉，我可不会夸奖一位多愁善感的指挥官。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "如果我是你的上级，恐怕会要求你把心挖出来，给那些老兵做个榜样。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "行了，你我都知道这里并非她的终点。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "对她这样忠于信念的人来说，赴死不过是实现永生。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "而且她可不是那群割掉舌头的盲信者，恐怕如今她正和自己的信念会谈。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "趁着门仍敞开，赶紧与她会合吧。"
            },
            {
              "kind": "dialogue",
              "speaker": "？？？",
              "text": "否则你就要被她永远甩下了。"
            }
          ]
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "你是个冷血的家伙",
          "edge_label": "",
          "branch": []
        }
      ],
      "link_source": "supplement_episode_id"
    }
  ],
  "segments": [
    {
      "script_id": "101023",
      "internal_title": "第十章10-17",
      "items": [
        {
          "kind": "title_card",
          "text": "致云雀"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "嘿……小耳朵虫……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "停顿"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "你在吗……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-环形广场"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "无线电小姐",
          "text": "司辰，你……你在说什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "……咳——呼、呼——"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "……司辰说的没错，这是进入神殿的唯一……方式……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……小耳朵虫，她们在说什么呀？"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "既然如此……咳咳……"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "我去吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "“无名者”小姐！"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "你们必须往前走，找到兀尔德女士，阻止仪式——咳……"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "而我的任务就是……把你们送进神殿，完成我的使命……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "不可能。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我们不会为了进门牺牲任何一个人。"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "……肺鱼。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "一种栖息在非洲淡水中的鱼，它的鳃萎缩到几乎失去了意义，却奇迹般演化出了肺。"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "生活在水中，却靠肺呼吸。"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "于是，它不属于陆地，可它赖以栖息的水也会杀死它。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "赖以栖息的水……"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "刚才的蛾潮，损毁了全部的蛾子……我已经失去了回到陆地上的价值。"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "唯有完成使命，才不至于白白溺毙于水中，这才是使我具有成为“我”意义的结局。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "不，“无名者”小姐。厅堂很宽广，屋檐下一定有你的一席之地。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "而我们一定还能找到其他开门的方法，或者找到其他的路。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "无线电小姐，麻烦你尝试一下能否联系上乌尔里希组长，他们那儿或许能有新的发现。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小耳朵虫，你听到了吗，她们好像在商量着什么。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "我们要去参与一下吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小耳朵虫？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "——不、不对，你怎么不回应我了？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "你的歌唱、你的颂词、地母的哼鸣，你平常都会这样回应我，给予我指引，告诉我答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "因为……你一直在骗我，是吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "诺谛卡？你还好吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "你还能走吗？对了，我这里还有些独角鲸牙糖，能抑制恐慌……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "镜头模拟主观视角晃动，推进神殿大门的一角"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "诺谛卡！你要去哪里？诺谛卡？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "对了，小耳朵虫，你知道弗里莱去哪里了吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……哦，我想起来了，她去面见“地母”了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "可是那个人说，从来就没有什么“地母”……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "那……弗里莱去哪儿了？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "下降"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗道具-诺谛卡拿着吊坠"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "弗里莱，你怎么把吊坠落下了……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这多重要呀，怎么能随便乱丢呢……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这是……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "弗里莱",
          "text": "这是一块龙涎香，罗夫伯伯。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "动作轻一些，弗里莱！龙涎香里还包裹着什么——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "随着精密切刀一点点将龙涎香的外壳割开，一老一小两双眼睛凑近一块小小的石头。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗道具-乳白色晶石"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在照明灯下，那新鲜的乳色石块散发着流动的光彩。"
        },
        {
          "kind": "dialogue",
          "speaker": "祖父",
          "text": "光泽、颜色、结构同我们之前分析过的所有岩层都不一样……无与伦比。"
        },
        {
          "kind": "dialogue",
          "speaker": "祖父",
          "text": "不是由岩浆结晶演化而来，也没有任何由生物沉积形成的特征……"
        },
        {
          "kind": "dialogue",
          "speaker": "祖父",
          "text": "诺谛卡……这是“地母”给我的“好消息”。"
        },
        {
          "kind": "dialogue",
          "speaker": "祖父",
          "text": "这是神迹。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消浮窗"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小孩胖乎乎的手轻轻握起吊坠。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "这是神迹，弗里莱。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "一定有什么秘密藏在南极，藏在这枚石头里。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雪原1"
        },
        {
          "kind": "dialogue",
          "speaker": "众科考队员",
          "text": "“富足的收成是人类的福音，盲童亦要被指引迷津。”"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "祖父没有找到的岩层，我会去找。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雪原2"
        },
        {
          "kind": "dialogue",
          "speaker": "队友Ⅰ",
          "text": "已经进入冰区了！拿上望远镜，探险家们！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "祖父没有发现的时代，我会去发现。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雪原3"
        },
        {
          "kind": "dialogue",
          "speaker": "队友Ⅰ",
          "text": "六分仪的测算准确无误，只要我们一直沿着这个方向进发……"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "祖父没有解开的南极谜团，我会去揭露——"
        },
        {
          "kind": "dialogue",
          "speaker": "队友Ⅳ",
          "text": "给，这是我最爱的奈普顿巧克力，它能让你多暖一阵子。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "长黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "进独白黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗道具-诺谛卡拿着吊坠-差分1-吊坠打开"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "嘿，小耳朵虫，这是你第一次看到这块石头吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但是对于我们来说，我、考特、奥兹、弗里莱……我们已经研究过它千遍万遍了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "我、我曾经以为，你能帮助我了解这块石头，带我找到它背后的时代。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "毕竟，你会在我害怕的时候给我颂歌，你会给我希望，给我信仰，给我探求一切可能性的勇气。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "你一直陪伴着我，就像“地母”和我说着悄悄话——我的小耳朵虫。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但现在看来，你要跟我告别了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这趟旅程不像在苔原上的远足，这次我们面临的都是最严峻的考验。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "所以，你的顾虑我可以理解，你确实有权利向我提出离队申请。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……好吧，最后一次，说声再见吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "再见了，小耳朵虫，我很高兴在南极的这段日子里认识了你。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "再见了……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "因为，我知道你本来就是不存在的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "就像……“地母”一样。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "关闭浮窗道具"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "回黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "无线电小姐",
          "text": "诺谛卡小姐？诺谛卡小姐！"
        },
        {
          "kind": "dialogue",
          "speaker": "无线电小姐",
          "text": "怎么办，她好像没有办法自主脱离谵妄……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "抑制恐慌的独角鲸牙糖已经给她嚼完了……司辰，我想尝试对她施展一次平静咒。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-环形广场（出地标）"
        },
        {
          "kind": "title_card",
          "text": "遗址城·广场"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "呜……大家都在……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "诺谛卡，你醒了？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "你刚刚似乎陷入了谵妄，我们叫了你很久，你都没有反应。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "我们现在是什么情况……？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "神殿之门关闭了，如果想要开启……我们可能无法满足条件。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "没错，我们正在尝试联系乌尔里希组长，准备制定下一步的行动计划。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "从眼神能看出，探险家的思维正逐步清明。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她望向紧闭的神殿之门，思索了一会儿。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "每座火山的山体里都存在一种特殊的结构：熔岩管。它是熔岩曾经冲出的通路，有时会像网一样遍布山体内。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "穿过熔岩管，或许就能绕过那扇门。"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "可能性……微乎其微……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "已然无法支撑自己的“无名者”，斜斜地倚靠在门边。"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "重塑将整个火山都据为己有……阿尼姆斯亲自带人踩遍了每一条通路。"
        },
        {
          "kind": "dialogue",
          "speaker": "“无名者”",
          "text": "连……咳咳……连雪地松鼠都找不到可乘之机。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“无名者”摇了摇扇子，目光再次聚焦在门上。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "走吧，我们绕着火山上行，说不定能找到被重塑遗漏的熔岩管，也能试试在高处能否联系上乌尔里希组长。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "第一助手点点头，上前搀扶起虚弱的“无名者”。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "诺谛卡，我们出发吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "探险家点点头，将吊坠挂在了自己的脖子上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "背在身后的背包被沉沉地砸在地上，而后探险家从里面掏出一顶安全帽和一副护目镜。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地质锤和钢钎也被她拿在手中。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "走吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她抬起眼睛，向前踏出一步，两步，三步。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "其他人也依次跟上，向着广场外的方向走去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "突然，她站定了身子，最后回望一眼一路走来的同伴。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她举起手，晃了晃手中的勘探锤。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而后，她吻上了挂在自己脖上的吊坠。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "切跑1放大"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "突然，脚步调转，雪地靴辗在积雪上，踏出一个深深的一百八十度拐弯的脚印。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "切跑1"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "维尔汀、十四行诗、无线电小姐！再见——！！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "切跑2"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她飞速地往回头的方向冲去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "——向着神殿大门的方向。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "切跑3"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飞跑的步子越来越快、越来越快。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她脚踩在松软的雪地上，发现自己似乎有某种飞翔的能力，在一瞬间从身体内部凶猛地爆发出来。"
        },
        {
          "kind": "dialogue",
          "speaker": "无线电小姐",
          "text": "诺谛卡小姐！你要去哪里？！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身后的同伴都在飞速地追赶自己。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "然而，她们的脚程丝毫赶不上一个探险家的决心。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "放大"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "对不起！我骗了你们！熔岩管不一定通向火山的内部——"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "但是你们总有机会进去，你们一定能进去——！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "而我，我也要用自己的方式去找到我的“好消息”——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "切跑4"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她的脚已然踩在距离神殿大门一步之遥的地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "——诺谛卡！！！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "放大"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "维尔汀、十四行诗，我的好朋友们。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "我要稍微离开一会儿。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "请不要耽误时间——继续往前走吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐白"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图-诺谛卡投门"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "诺谛卡——！不要！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "胸前的吊坠随动作前荡，凌空划出一个坚决的弧度。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人类一跃而起，向前眺望。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐白"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "这块龙涎香里裹着的到底是什么，爷爷？"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "是一块未经研究的样本，是神迹，还是什么都不是？"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "与这片冰川底下的大地相比，人类的年龄太小、能看到的东西太少。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "在这个探知的过程中，我们或许终其一生都无法理解自然界中所有的秘密。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人类垂下眼。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在凝固的光芒中微笑。"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "但是，只要我足够近——"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "只要我足够近，我就能看到足够多。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她重新抬起眼。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "那全然的、深邃的寂静，在其面前鼓动着。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消白"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐入"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "祖父，原来……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐入"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "原来那发光的未知本身——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "放大"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "竟会令我如此着迷啊……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "停顿"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "……！！！"
        },
        {
          "kind": "dialogue",
          "speaker": "诺谛卡",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一瞬间。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "世界万物一新。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "变浅"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "众人甚至未能抓住她被风扬起的衣角。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "——不要！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "变浅"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓冲"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "静得像一切都被抽干。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "没有风，岩浆静止，甚至如极昼和极夜一般漫长的缄默都没有。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐白"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "门。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "开了。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}