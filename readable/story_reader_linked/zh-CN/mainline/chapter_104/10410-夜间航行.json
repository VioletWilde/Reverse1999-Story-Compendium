  ],
  "segments": [
    {
      "script_id": "100412",
      "internal_title": "第四章4-10.1",
      "items": [
        {
          "kind": "title_card",
          "text": "夜间航行"
        },
        {
          "kind": "title_card",
          "text": "基金会客房"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "银质的占卜台、白色的丝绸、浸过夜露的珍珠……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "嗯，月亮材料还缺什么呢……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "噢！检查一下乳香和没药还有多少……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "很好，没问题，分量刚刚好。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玛蒂尔达在桌前忙活着。她反复确认窗帘的位置，确保月光能无误地映照在晶球上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "细小的骚动在不远处的容器中响起。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但她无心留意。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "很好，都齐全了。香料皿，我的香料皿……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玛蒂尔达转过身来。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "呀啊——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一旁的香料皿落到地上，在对称结编织的地毯上发出声响。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "～♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "香料皿后面露出尖尖的小耳朵。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "怎么又是你们！烦人的占卜妖精！"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "我这次绝对不会再允许你们偷走我的道具了！"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "～♪～♪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "透明的小生物并不关心她的慌张。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "它们与那些成群结队的魔精不同，仅是一两只，就能给人们带来极大的麻烦。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "细长的小手攥住银制的香料皿边沿，向窗外飞去。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "嘿！你们想把我的东西偷到哪里去？快给我住手！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她扑上窗台，紧紧地抓住银皿的另一边。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "呼……看来不好好惩罚你们一下，你们、你们是不会知道教训的！"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "等着吧，我马上就会让你们知道，得罪玛蒂尔达·布翁尼小姐，是个什么下场！"
        }
      ]
    },
    {
      "script_id": "100413",
      "internal_title": "第四章4-10.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "银皿摔到地上，撞出一个陷坑。"
        },
        {
          "kind": "dialogue",
          "speaker": "占卜妖精",
          "text": "×……×！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "妖精们在窗前软软地爬行，看起来受了不小的冲击。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玛蒂尔达拾起香料皿，擦了擦上面的灰。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "哼，看看是谁笑到了最后～！是我，是我！"
        },
        {
          "kind": "dialogue",
          "speaker": "占卜妖精",
          "text": "♮♭♮♯♭♯♮♯♭！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "它们爆发出一阵难以听懂的咒骂，垂着翅膀从窗外逃走了。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "啊……真是的，累死我了。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "现在多少点了……哦！还好，还没有错过潮汐时间！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她手忙脚乱地收拾起桌面上的道具。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "赶紧把东西摆好……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "不能再被打搅了，占卜需要全神贯注，凝聚所有的能量……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "门外却响起轻轻的叩门声。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "咳咳！月球潮汐就要到来了，我看看，预测出现的时间是20点45分。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "还有三分钟。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "涨潮的同时要净化水晶球，确保获得的占卜知识准确无误……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "敲门声再次响起。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玛蒂尔达皱起了眉头。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "冷静，冷静。这可是最关键的时刻……不管是谁，都别来影响我！"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "嗯……不要分神，不要分神。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "闭上双眼……集中精神……想象身体正在月亮的祝福下，伴随着潮汐起伏……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "而她将在和谐的对岸……等候着我去寻找方向……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "是时候焚烧香料了……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "于水晶中显现形象吧，十四行……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "玛蒂尔达，你在屋里吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……？！"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "这是怎，怎……怎么回事？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "抱歉，但我似乎听到你的声音了。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我有事……想请你帮忙。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她的声音听起来有些变化，带着被磨损后的颗粒感。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "我……我马上就来！不对，你先等一会儿！"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "我现在、忙着呢，你——你给我等好了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她慌里慌张地掀起水晶球下的丝绸，将它们塞到沙发的角落。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "门开了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她们站在门口，前进，后退，如同在进行尴尬的方步练习。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "最后，十四行诗被玛蒂尔达迎了进来。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "说出你的请求吧！你深夜来找聪明伶俐的玛蒂尔达小姐，是……是来做什么！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行诗脸上挤出一个笑容。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "能请你为我占卜一下吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玛蒂尔达在她的脸上看到了从未见过的景象。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她们在水晶球旁边坐下了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "没药在一旁静静地焚烧着。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "嗯，现在是一个适合向月亮求助的时间……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "在银盆中洗净双手，再放到我的手掌上。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "好了，请坐到我的对面，凝视着水晶球。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "好的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行诗照做了。她看到水晶球里是一片澄澈的空白。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "你是来告解，释梦，还是来寻求水晶的预言？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我来告解……也来寻求预言。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "跟我说说积蓄于你心中的画面吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "画面吗……？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "嗯……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她望着水晶球。球体在她眼中逐渐模糊。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "看到自己在不断地下坠……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "有两块碎裂的甲板……它们原本是一体的。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "每当我靠近一块甲板时，另一块就会沉入水中。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "上面的人们也随之一同坠落。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我能感受到深水处的冰冷，也能感到挣扎时的疼痛。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "你对此感到悲伤吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……我……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我感到恐惧。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "嗯……你的直觉想要靠近哪一块甲板？上面的人影你能看清楚吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "那块甲板上有明亮的东西，就像是……司辰和槲寄生她们……那里很温暖。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……你不自觉地受它的吸引。它赋予了你心灵的指引。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "另一块甲板呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "另一块甲板……让我感到舒适。仿佛我在那里度过了漫长的岁月。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我能在那里找到我每一步的轨迹。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "那或许象征了你的理性。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "十四行诗，你在面临什么抉择吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "我看到你的直觉与理性处于矛盾的……角度。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "听说你今天也参与了委员会的会议。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "发生了什么事吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我说错了话。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我没有做好充足的准备……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我没有帮上司辰和槲寄生她们的忙，反而加大了彼此的误解。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我该如何选择……才能解决他们的矛盾？这样的僵持……让我感到很害怕。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玛蒂尔达一时不知道怎么回答。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她只是呆呆地将手掌盖在对方手腕上。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "那块明亮的甲板……似乎距离你更近，也更大一些。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "你有没有考虑过倾听心灵的指引？"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "十四行诗，或许你可以尝试一次，跟随着直觉采取行动。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "也许会发生意想不到的事情哦。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我尝试过。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "——在四年前。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我放了他们离开……那是我做过最错误的决定。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行诗重新握住了水晶球。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我准备好了。请帮我占卜出正确的选择吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……好。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "混沌的雪花消失后，球体重新变得朦胧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而视野中浮现出隐约的晶体。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "它们层层搭建出一艘对称而均衡的小船。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一切都有迹可循，有理可依。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "“实相已显现。”"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "“步入已步入之道，行进已行进之径。”"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "“听从脑内的声音将于你有益，因为泊船的时刻未到。”"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "听从脑内的声音……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我明白了。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "我不该犹疑的。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "谢谢你，玛蒂尔达。你的占卜对我很有帮助……我现在清醒多了。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "谢……哈，你当然应该谢谢我——！"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "现在才知道玛蒂尔达·布翁尼小姐的神通广大实在是太晚了。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "要知道，平时找我占卜的人，如果没有提前十五天预约，本小姐可是见都不会见的！"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "哈哈。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "你占卜的时候很认真……语气都与平时不一样了。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "不过，我还是更习惯你现在的说话方式……这会让我想到我们在校的时光。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玛蒂尔达呆若木鸡地站着。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行诗挥了挥手，走出了房间。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "谢谢你专门为我腾出时间，玛蒂尔达。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "下次有需要我帮忙的地方，请一定要告知我。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "晚安。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "门被轻轻带上了。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "！%￥#……&*……"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
