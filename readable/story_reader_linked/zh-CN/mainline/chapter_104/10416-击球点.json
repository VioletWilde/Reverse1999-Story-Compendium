  "segments": [
    {
      "script_id": "100421",
      "internal_title": "第四章4-16.1",
      "items": [
        {
          "kind": "title_card",
          "text": "击球点"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "与往日不同，康斯坦丁没有坐在办公桌旁。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "房间内没有开灯。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她背对着门，正望着窗外。窗栏硬挺，日光缓慢地漏入屋中。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "我是佩德拉。"
        },
        {
          "kind": "dialogue",
          "speaker": "康斯坦丁",
          "text": "请进。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "我来汇报今日的情况。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "有部分中立的群体倒戈了。"
        },
        {
          "kind": "dialogue",
          "speaker": "康斯坦丁",
          "text": "数量有多少？"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "不多。但总数加起来，足以使我们双方的票数不相上下。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "他们一向支持基金会变革，看来代表人马克终于说服了他们。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "听说，Z女士最近也一直在各方游说。"
        },
        {
          "kind": "dialogue",
          "speaker": "康斯坦丁",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "不过，保守派的人数没有变化，这点我们可以放心。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "几天后的表决，我相信我们仍能占据上风。"
        },
        {
          "kind": "dialogue",
          "speaker": "康斯坦丁",
          "text": "那些大小不一的党团群体怎么样了？"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "都在正常运作中，没什么出格的动作。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "对了，伯纳德他们前往第一防线学校探访了，我没联系上他们。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "康斯坦丁又将椅子转向了窗外。"
        },
        {
          "kind": "dialogue",
          "speaker": "康斯坦丁",
          "text": "感谢你今日的汇报。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅰ",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "康斯坦丁",
          "text": "她从来没有这么坚持过。"
        },
        {
          "kind": "dialogue",
          "speaker": "康斯坦丁",
          "text": "你知道这次是为什么吗？佩德拉。"
        },
        {
          "kind": "title_card",
          "text": "第一防线学校运动场"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "没想到你还有空来邀请我打乒乓。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "还是说……你其实也是来游说我的？Z女士。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "呵呵，两者都有吧，卡兹。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "以前我每次离开实验室，都会喊上同学打几局乒乓。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "浑身是汗后再去冲个冷水澡……那段时光，让我记忆犹新。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "呵呵……你这话让我想起以前在乒乓球学生代表团的日子了。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "现在在这里，也就只有你能陪我练练手了。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "发球吧，Z女士。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "让我们比试一局。"
        }
      ]
    },
    {
      "script_id": "100422",
      "internal_title": "第四章4-16.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "哈哈哈……！反手削球？很好，很好。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她迅速拾起白色的小球，俯下身子。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "再来，准备好了！"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "嘿！"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "好球！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "Z女士挥动球拍，小球以极低的弧度跃过球网，撞向无人的桌角。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "卡兹迅速侧身，稳稳地回了过去。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "我们打算修订草案中的部分条款。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "什么条款？"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "加强对已登记神秘学家管制的条款。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "你说得对，我们应该提高基金会在外的信誉。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "说说看。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "我们计划将司辰的教管权力交回给教管学校与基金会。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "由基金会对神秘学家进行统一的风险评估。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "确保这支编外队伍的风险水平始终在我们的掌控之中。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "但是实际的编制仍然是归属于司辰名下吧？"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "这是我们的根本要求，这点不会变化。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "呵呵……"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "没想到你们会做出让步。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "这不是让步，卡兹。这是针对草案做出的合理的改良。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "转移管教权力，对降低预算和维尔汀的压力都有帮助。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "你的改良里甚至包含了来游说你的对手——我。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "合理的诉求不会因发声的阵营不同，便有所褪色。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "我认为基金会需要的是团结与联合，而不是对抗与斗争。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "如果这份草案注定要通过，我将尽我所能，让它满足大多数人的期望。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "如同这场乒乓球比赛一样……"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "友谊第一，比赛第二。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "位于人群之中，才是立法的根本。"
        },
        {
          "kind": "dialogue",
          "speaker": "委员Ⅱ",
          "text": "这张选票是你的了，Z女士。"
        },
        {
          "kind": "dialogue",
          "speaker": "Z",
          "text": "呵呵……我需要的，可不止是一张选票，卡兹。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}