  "chapter_title": "今夜星光灿烂",
  "display_label": "",
  "title": "空白页",
  "subtitle": "别翻到最后一页，别合上它。不要，不要。",
  "trails": [
    {
      "element_id": 100620,
      "owner_episode_id": 10622,
      "trigger_episode_id": null,
      "title": "勇士之歌",
      "description": "来自怯弱者，来自舞台上的最后一首歌。",
      "action": "交互",
      "unlock_condition": "EpisodeFinish=10622",
      "content_hints": [
