  "segments": [
    {
      "script_id": "100530",
      "internal_title": "第五章5-21",
      "items": [
        {
          "kind": "title_card",
          "text": "驶来的黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-岛屿-沙滩-夜晚（这个差分上有额外的几何体）"
        },
        {
          "kind": "dialogue",
          "speaker": "星锑",
          "text": "维尔汀，你终于出来了！"
        },
        {
          "kind": "dialogue",
          "speaker": "星锑",
          "text": "重塑之手的歹徒突然像地鼠一样层出不穷，我和红弩箭没法把他们全拦下来！"
        },
        {
          "kind": "dialogue",
          "speaker": "星锑",
          "text": "如果不是你叮嘱我不能主动攻击，我早就动手了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一个发狂的门徒尖叫着扑来，被红弩箭结结实实地放倒在地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他的四肢抽搐着，很快变得干瘪下去。"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "该死，这些家伙宁可被吸干血液也要攻击，已经完全疯了！"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "还在广场盯梢时我就告诉过十四行诗，别信什么所谓的和平协定，那些满口数字的几何脑袋和脑门流油的重塑之手总有一个会先开始发疯。"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "至少他们做数学题时看着还算正常——天杀的！"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "你们在地下到底发生了什么？！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……这个地下洞穴就是免疫“暴雨”的关键。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "这个岛屿拥有和箱子一样的遗迹，重塑之手是为了抢夺这个基地而来的！"
        },
        {
          "kind": "dialogue",
          "speaker": "星锑",
          "text": "什么！？可是——"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "可是那家伙不也戴上石环了吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "就算她自己有屏蔽石环的办法，也不可能一直让手下做自杀式袭击！"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "既然她也签署了永不开战的和平协定，又要怎么从阿派朗学派手里抢走基地？！"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "维尔汀。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "背上的37睁开了眼睛。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她伸出一根手指，指向远方的天空。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在那永恒超验的天幕之上，亮起了一排过分明亮的耀星。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "……那是什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "场景-岛屿-传道者之厅"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "传道者之厅内万籁俱寂。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "只有访客还在翻阅着古老的书籍。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "……您在这里逗留太久了，阿尔卡纳小姐。"
        },
        {
          "kind": "dialogue",
          "speaker": "6",
          "text": "即使您给予过学派很多帮助，也请您注意访客的立场。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "请放心，我从不想挑起无谓的纷争……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "只是想要请教一个简单的问题。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她轻轻地合上了书页。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "伟大的智者们……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "你们奉行古老的智慧，遵循先贤的教导，坚守高贵的品德。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "数千年来，置身事外，离群索居。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "不被人类理解，也不寻求理解。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "……我很喜欢这个洞穴的寓言。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "但您是否想过……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "是谁把我们放逐进了洞穴之中？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "耀星不断逼近。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "井然有序，如雨燕回巢。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "视频3-战争开始（资源未到）"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "这是什么……？我从来没有见过。"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "为什么它会出现在这里？"
        },
        {
          "kind": "dialogue",
          "speaker": "37",
          "text": "这样的东西，不应该存在于这个岛上。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "——37！不！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "永恒回归的洋流被阻断了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在那恪守缄默的海面上……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一艘黑色军舰正划破海浪，朝岛屿驶来。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏菲亚",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "耀星之下，她的脸色像纸一样苍白。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏菲亚",
          "text": "……十四行诗。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏菲亚",
          "text": "你们把人类的军队带到了这里？"
        },
        {
          "kind": "title_card",
          "text": "THE END"
        }
      ]
    }
  ],
  "fallback_fields": []
}