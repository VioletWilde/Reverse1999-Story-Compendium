{
  "episode_id": 10811,
  "chapter_id": 108,
  "chapter_title": "忧郁的热带",
  "display_label": "",
  "title": "圣保罗舞曲",
  "subtitle": "他用一种“圣保罗”的方式执行正义！",
  "trails": [
    {
      "element_id": 1081101,
      "owner_episode_id": 10811,
      "trigger_episode_id": null,
      "title": "往日的分径-邓肯先生",
      "description": "",
