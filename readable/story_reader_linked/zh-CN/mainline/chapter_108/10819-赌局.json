  "segments": [
    {
      "script_id": "100829",
      "internal_title": "第八章8-19.1",
      "items": [
        {
          "kind": "title_card",
          "text": "赌局"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "悲伤圣母教堂"
        },
        {
          "kind": "title_card",
          "text": "悲伤圣母教堂"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "庄园之主叹息着。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我等着和芝诺握手言欢，消除今天这个小小的误会。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "伤害您对我没有任何益处，就像圣保罗这座城市，像这个终将被“暴雨”冲刷而去的虚假的时代。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我希望能够和平地把您交还给您的朋友，正如他们也会和平地把我的朋友还给我。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "对不信者，我们有耐心，他们只是没意识到自己是被天光照耀的孩子。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "终有一天，他们会弃暗投明，如同不久前加入我们的芝诺朋友。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "而背信者……啊，背信者必须死。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "异端与弃誓之人最为可恨。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "但我很好奇，是什么人攻击了庄园？"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "是谁打扰了天使兄弟会与伟大重塑之手的使者会面？"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "还在这儿……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他踢开脚下的碎石。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "抓走了我的朋友。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "魔药将盲眼女士的喉咙锁住，让她出不了声。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "马坎多或许会把贫民区的事情搞砸，我毫不怀疑，但无妨。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "后退"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他转过身去，留给医生一个背影。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "只要他能招来源源不断的年轻人，只要神秘学家同胞们依然愿意走向我们。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "马坎多这样的人就有用处。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "在他被“暴雨”吞没前，物尽其用。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "芝诺不也是这样使用他们的“货币”——可怜的士兵们的吗，医生？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不愿被白白消耗的硬币逃离了赌桌，却又滚向另一张桌子。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这世界不过是一座巨大的赌场，除了上桌，筹码别无选择。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他望向医生。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "至少，重塑之手会许诺给他们未来，真正的未来。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "“受苦者”必将重生。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "天使兄弟会将随我驶向南方，成为祂的信众，接受祂的试炼，承蒙祂的恩典。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "靠近"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他贴近盲眼女士，在其耳旁低语。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "无论这张牌桌被清洗多少次，我们都会在祂的庇护下屹立。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我们是不朽的。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "此即昨日，女士。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "上校庄园"
        },
        {
          "kind": "title_card",
          "text": "上校庄园"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "孤身潜入庄园的洛佩拉观察着庄园守卫的动向，发现人比预想中更少。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "七八个人，没法闯过去，可恶……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "身后传来脚步声，像穿过草丛的蛇蟒，小心翼翼向她靠近。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "什么人——？！"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "圣母在上，可算找到了，哈哈，没想到是我吧！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一个意料之外的伙伴。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "邓肯？但你怎么知道我在这儿……"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "嘘，别出声。荣军院的朋友都跟我说了。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "你的司辰朋友送来联络，说你一个人被安排来了庄园。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "啊，看看这儿，多美的绿色啊。你的目标是那座教堂吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "绿影之外，教堂矗立在荒凉的日光之下。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "如果医生就在那儿的话，我得闯进去看看。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "怎么打算？在这儿等援军吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "援军？不，当然是给老爹和司辰一个惊喜。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "恢复"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "巡逻的守卫看护着通往教堂的路。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "老伙计，你敢跟我一起上吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老伙计用行动做出了答复。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他转下墨镜，举起吹管——"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "给我两根吹箭。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "好，你弄开守卫，我去教堂看看。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "炼金师颠颠坩埚，神秘术驱动的炉火开始燃烧，倒出几根细针般的毒箭，递给老伙计。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "我去那边，你盯紧机会过去，对面的林子能藏住你。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老人蹲下身子，对准一个倒霉守卫的脖子——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "咻——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "中箭的小子立刻倒下。"
        },
        {
          "kind": "dialogue",
          "speaker": "兄弟会守卫",
          "text": "林子里有人！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "警报声随之响起。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "把他们往河边带。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老邓肯接过同伴递来的烟雾爆弹。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "小伙子们，来点刺激的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "爆弹在空中划出一道弧线，老邓肯的吹箭刺破了这颗灰色小球儿。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "烟雾弹"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "干得漂亮！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "守卫被引开后，她举着枪，走近庄园中央的废弃教堂……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "横切转场2"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "啊，有人来救您了，女士。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "这并不让我意外。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "庄园之主注视着被吊起的盲眼女士。在他手中，捏着一个小小的、不起眼的控制按钮。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他不介意将这儿化成一片真正的瓦砾堆。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "医生——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "营救者的呼喊回荡在教堂高高的屋顶之下。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "喔？是你？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "那位在船上有过一局之缘的小赌徒。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "在船上的时候我就该一枪把你脑袋开瓢。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "你走到了一张错误的赌桌上。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "哼，怎么，赢家会得到德洛丝医生吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她走向布道台上的敌人。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "庄园之主张开双臂——"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "不，什么也不会得到。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "我们都是风中的尘土。"
        }
      ]
    },
    {
      "script_id": "100830",
      "internal_title": "第八章8-19.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "子弹掉落"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "丢枪"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "拳打"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "洛佩拉打空了子弹，卸掉左轮枪，冲上去徒手追击受伤的对手。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "右移"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "打拳"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "左移"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "打拳"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "看来赢的还是我。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "靠近"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "踢"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "跌倒"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "勒住"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她踢倒已经无力的桑托斯，扼住脖子，另一只拳头停在空中——"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "是的，你赢了赌局。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他倒在瓦砾堆中，嘴角流血，面对洛佩拉即将落下的拳头，却微笑起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "但赌桌呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "别了，小赌徒。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "什么？！"
        },
        {
          "kind": "dialogue",
          "speaker": "桑托斯",
          "text": "如果你觉得，我比你那位盲眼的朋友更重要的话……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "操作"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "爆炸"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "爆炸消除"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "桑托斯按响按钮，爆炸声与震落的墙砖一同袭来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "只是对手的一瞬迟疑，桑托斯奋尽力气，踢开洛佩拉。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "随后便在爆炸的混乱中，自告解室隐匿而去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "留下圣像倒塌，烛火熄灭。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "该死的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她忍住疼痛，咬牙跑向布道台，救下被绑着的盲眼医生。"
        },
        {
          "kind": "dialogue",
          "speaker": "德洛丝医生",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "医生试图开口，但魔药的效力依然封锁着她的喉咙。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "有话回去再说。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
