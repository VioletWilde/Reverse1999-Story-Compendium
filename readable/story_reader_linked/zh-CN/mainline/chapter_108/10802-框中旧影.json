{
  "episode_id": 10802,
  "chapter_id": 108,
  "chapter_title": "忧郁的热带",
  "display_label": "",
  "title": "框中旧影",
  "subtitle": "在雨水堆积的倒影中，她看见了熟悉的故人。",
  "trails": [],
  "segments": [
    {
      "script_id": "100802",
      "internal_title": "第八章8-02",
      "items": [
        {
          "kind": "title_card",
          "text": "框中旧影"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "基地"
        },
        {
          "kind": "title_card",
          "text": "芝诺基地"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "柱廊阴影下，少女咬着冷饮吸管，无所事事地晃腿踢打空气。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "庭院荒芜，石缝之间的杂草顽强生长着，骄傲地对抗着圣保罗的烈日。\n甲虫从一处草丛爬向另一处草丛，而这一切都被少女看在眼里。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "一个人待这儿？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "女士沿着破落的大理石柱慢慢走来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "凉荫下的少女抬手遮住刺眼的阳光，看向来客——"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "嗯？姐姐！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "和她在同一位“父亲”身边长大的莫莉德尔姐姐。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她扔掉饮料，像只摇着尾巴的小狼犬，藏不住笑脸，跑向姐姐。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "跑步音效"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "噢——慢点，慢点，扑上来这一下……真有劲儿，哈哈。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "副官女士摸着妹妹的脑袋，将她搂紧。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "你长高了。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "那你肯定长胖了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“礼尚往来”，她也伸手探进姐姐衣服里，摸到对方柔软的肚腩。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "洛佩拉——！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "会痒的，别闹。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一个小小的恶作剧。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "这次过来待多久？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "不多久，很快，很快就要走。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "父亲对圣保罗的事情很生气，向总部要求临时调来这儿。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "作为老将军最信任的副官和孩子，她随老将军一同来到圣保罗的基地。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "等下一任长官过来，或许到时候你可以跟我们一起走……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "副官女士有些迟疑。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "只有伊戈尔将军能决定所有人的去留——无论她，还是洛佩拉，抑或是其他任何人。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "是吗？喔……我其实还挺喜欢这边，荣军院的老头儿和老奶奶都是些有意思的人。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "很高兴看到你有新朋友，老人的智慧向来值得尊重。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "哎呀……你说教的样子跟老爹越来越像了。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "他人呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消氛围图"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她左右张望，而老将军显然不在附近。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "父亲和基金会的司辰去办公室谈话了。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "喔～所以你是偷偷溜出来的喽？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "偷偷溜出来找我对不对！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "不，我是想来……锄草，基地里荒了很多地方，到处都得打扫。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "锄草。一个荒唐的理由，走过一个又一个庭院，绕过一片片荒地，就为了寻找一株活蹦乱跳的“杂草”。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "撒谎。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "姐姐你耳根红了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这是她的顽疾，是她的羞赧和她的诚实，正如嘴会说谎，但梦永远诚实。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "好了，一起去会客室吧，基金会来的客人还在等我，可不能让父亲知道我们偷偷跑出来了……"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "哇我跟你讲，我们突袭上校庄园的时候，还抓回一个很难搞的俘虏……"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "圣保罗城里还有一艘装在瓶子里的小船……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "草丛间，彩羽毛的蜂鸟望着有说有笑远去的两人背影，又转而看向基地南边的棕色高塔……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "转场"
        },
        {
          "kind": "title_card",
          "text": "会客室"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "屋内简单、硬朗、整洁，满是军队做派。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "苏芙比和她的飞行员伙伴无所事事地打量着这间会客室。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "退伍军人们的合照按照年份排布，光荣地悬挂在墙上。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "嗯……1968年，一座古老的城市。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "士兵们看上去表情阴沉，不愿面对镜头，那是一场没有鲜花与荣誉的胜利。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "这个地方叫做……伊兹、密尔。嗯……伊兹密尔是什么地方？会有阿邦·阿库吗？我还从来没有去过这里呢。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "枣椰树下，结队的士兵远眺向古老而富庶的地中海海岸，留下了一张宝贵的影像。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "1986年，里约热内卢……唔……里约热……"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "——咦，等、等等？！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "里约热内卢。海岸边，她隐约看到了一张熟悉得不能再熟悉的脸。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "卡森先生为什么会在那儿！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她接连蹦起，试图取下那副沉重的木相框。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一张熟悉的脸出现在相片上，但那位先生早已消失在了1929年的“暴雨”中。"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "怎么，连这儿你都有熟人？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飞行员为矮个子的伙伴取下相框。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "天哪！卡森先生！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她绝不会认错。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "尽管改换发色，蓬发让他看起来比从前热情不少，但硬朗的五官与她记忆中老人的浮影重合，渐渐合为一人。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "可是“暴雨”不是把他……我亲眼看到卡森先生……消失……"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "“暴雨”？你在说什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "苏芙比连连摇头。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "——不对不对，他和卡森先生就是同一个人！"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "世界上没有长得这么像的人，所以如果一个人长得跟另一个人一样……嗯，那他们……他们肯定就是同一个人！"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "你看，这个鼻子……这个眼睛……嗯，虽然他没有戴眼镜，但是这条皱纹很明显……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她自言自语，甚至有点儿语无伦次。相框中的老人令她感到不可思议——无论是那张与卡森先生几乎完全一致的长相，还是热烈张扬的笑容。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "严肃的老管家绝不会露出这样的笑。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "不行，我、我必须贴近瞧瞧！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "放大浮窗"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "啊，也许是我弄错了？但为什么会有长得一模一样的两个人呢……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一千零一个问号在小淑女的脑子里像魔药试管中的泡泡一样咕噜咕噜冒出。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她瞪大眼睛，举起相框，近得连鼻子都贴上了堆满灰尘的相框玻璃——"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "难道……卡森管家他、他……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她被灰尘呛了个喷嚏。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "阿、阿嚏……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消浮窗"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老将军走进了会客室。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "莫莉德尔呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他环视房间各处，但这儿没有一位叫做“莫莉德尔”的人。"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "将军，司辰。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "飞行员看到将军到来，立刻挺直身躯，行礼致敬。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "维尔汀！快来看看！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "苏芙比握着一个相框，激动地挥手——"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "卡森先生……他好像、好像还活着——！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "嗯？！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他还活着？！从众人眼前消失，被1929年的“暴雨”回溯的卡森先生，竟然还活着？！"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "苏芙比在退伍老兵们的合照里看到了她的家人。维尔汀，你也认识这位卡森先生？"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "你看这里——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消人"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浮窗"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他曾消失在1929年的雨幕中，如同一位从舞台上被抹去的演员。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "他长得……确实和卡森管家非常相似，如果我没有记错的话。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "可现在却出现在另一张照片上……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "消浮窗"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老将军走过来，看着苏芙比手中的旧照片，看向她手指指向的老人。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "有很多了不起的战士永远留在了亚马孙河的急流里，但也有更多的侥幸得生。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "他就是其中一位勇敢的幸运儿。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "不过，我不太明白你们聊的话题。你们以前曾经见过这位士兵？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我们有一位朋友被1929年的“暴雨”回溯，他和这位先生很像。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "事实上，将军，他们……几乎长得一模一样。这简直不可思议。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏芙比",
          "text": "虽然换了衣服……虽然……但他肯定就是卡森先生！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这位老先生让她想念起了自己的老管家。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "那这真是件有意思的事情，嗯……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "这位老先生，他现在还在世吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "如果他活着，现在也该在圣保罗的荣军院。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "圣保罗，荣军院。\n像河流交汇的小岛，秘密和答案都聚在那儿的沙滩上，等着水鸟叼走。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "开门声"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "大～家好～！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "抱歉让各位久等……了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "行刑场上的少女和另一位女士来到会客厅，却迎面遇上老将军冷铁一样的脸。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "将、将军……"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}