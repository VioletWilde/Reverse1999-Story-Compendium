{
  "episode_id": 10820,
  "chapter_id": 108,
  "chapter_title": "忧郁的热带",
  "display_label": "",
  "title": "亲爱的你",
  "subtitle": "别忘了送走明天，也别忘了向昨天致敬。",
  "trails": [
    {
      "element_id": 1082001,
      "owner_episode_id": 10820,
      "trigger_episode_id": null,
      "title": "往日的分径-洛佩拉",
      "description": "",
      "action": "往日的分径",
      "unlock_condition": "EpisodeFinish=820",
      "content_hints": [
        "fragment"
      ],
      "content": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一对长管左轮枪，曾经陪伴姊妹度过了无数个靶场的午后——或者说，曾经的姊妹。"
        }
      ],
      "link_source": "supplement_episode_id"
    }
  ],
  "segments": [
    {
      "script_id": "100831",
      "internal_title": "第八章8-20.1",
      "items": [
        {
          "kind": "title_card",
          "text": "亲爱的你"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "上校庄园"
        },
        {
          "kind": "title_card",
          "text": "上校庄园"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "地标"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "肃清敌人。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "找到洛佩拉和德洛丝医生！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "按照将军的安排，副官女士来到庄园，根据定位纽扣的指引寻找着定位对象。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但她来晚一步，残余的敌人没有交火欲望，见到芝诺军人，纷纷逃开，枪声很快平息。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "染血的甘蔗林燃起火焰，在浓烟与血地里，副官女士寻找着医生与她的妹妹。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑幕转场"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "上校庄园"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在教堂倒塌前，洛佩拉顺利带着盲眼医生来到教堂外。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "天使兄弟会呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "找上她的，不是邓肯老头儿，也不是兄弟会的守卫……"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "——啊，姐姐！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "还好定位纽扣没出问题，总算找到你了。里面怎么回事？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "跟桑托斯打了一架。他溜了，没办法……但……你不是该去荣军院？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她为自己小小的失败露出苦笑——这仍是胜利，尽管不够完美。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "救出医生最要紧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "盲眼女士护着打字机，正坐在庄园的泥地上。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "看到您没事真是太好了，医生。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "干得不错，洛佩拉，现在跟我回基地。带上这位女士一起。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "司辰呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "她……她有基金会的新任务，那和我们没关系。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "父亲要我立刻带你和医生回基地去。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "什么意思？为什么变成了……到底怎么回事？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这不是计划中的安排。事情很突然。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "一起走吧，我们要撤出圣保罗了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "撤离？她没听说过有这个安排。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "撤去哪里？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "洛佩拉，服从命令。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "父亲让我来接你走。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "那为什么他没有亲口告诉我？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "父亲有自己的考虑！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "情急之中，她用一个无法反驳的理由驳斥了妹妹的质问。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "像是意识到了自己的错误，副官女士泄了气。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "……唉，好吧，我们去南方。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "火地岛，那儿已经做好接应我们的准备了。走吧，洛佩拉，跟我们一起走。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "你、我、父亲、托勒密，还有大家……大家都准备好了。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "大家？为什么没人跟我说过这件事？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "因为……别问了，赶紧行动，我们时间不多。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "洛佩拉甩开了姐姐伸来的手，退后两步。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "为什么是火地岛？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "为什么时间不多？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "你们想做什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "谁在火地岛接应你们？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她握紧枪，枪口对准雨水浇洗过的土地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她的动摇、惊恐和疑惧在冰冷的枪管中犹豫着。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "枪是安全的。枪是可靠的。握紧枪的自己是不会被伤害的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "接下来，枪口会颤栗着对准眼前之人，正如雨水从天而下。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "谁在怂恿父亲？托勒密那混账吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "不……这是父亲的命令。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "面对枪口，莫莉德尔解开枪套，将手伸向自己的枪。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "别动！"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "别这样，洛佩拉，把枪放下。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑色手枪从枪套中滑落，跌到地上。枪主人摊开手，以示友善。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "父亲需要她，我们需要这位医生。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "带上她，回到基地，和我们一起去火地岛。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "火地岛上有什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "……未来，属于神秘学家的未来。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "父亲接受了传道者的承诺。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "重塑之手。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一个无法想象的背叛。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "我的家人没有叛徒。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "过去没有，现在没有，未来也不会有。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "追猎者绝不甘愿沦为自己曾经追猎的叛徒。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "洛佩拉，你可以什么都不做，不为他们做任何事。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "副官女士慌忙解释，但她甚至不敢看着妹妹的眼睛。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "回家吧，跟我一起回家，跟我们一起走。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "回家。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "收氛围图"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一个让洛佩拉短暂动摇的词——短暂而遗憾的动摇。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "抱歉，洛佩拉……"
        }
      ]
    },
    {
      "script_id": "100832",
      "internal_title": "第八章8-20.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "靠近"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "打"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "副官女士抓住她陷入动摇的间歇，一步上前，发起攻击。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "枪响"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "情急之下，洛佩拉扣动扳机。子弹射向天空，惊走结群的飞鸟，左轮手枪落入了它曾对准的副官女士手中。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "打"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "倒"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "洛佩拉被打倒在地，疼痛让她无法动弹，抱腿捂住胸腹，发出一阵阵痛苦的呻吟。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "老爹……为什么……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她不理解。她无暇思考疼痛。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "慢靠近"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "为了我们所有人，妹妹。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "你圆满完成了任务，德洛丝女士安然无恙，护送就交给我吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "洛佩拉同志。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "脚步声"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "几名穿着芝诺军装的士兵解决了庄园别处的战斗，赶来副官女士身旁。"
        },
        {
          "kind": "dialogue",
          "speaker": "芝诺士兵",
          "text": "这是……"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "这里我来处理。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "带那位盲眼女士离开，保证她的安全，撤退。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "抓走"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "虚弱的医生无力反抗，只能任由命运再一次将她掳走。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "副官女士望向倒地的妹妹，眼神冷漠。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "很遗憾以这种方式和你告别。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "副官女士举起枪，对准往日的亲人。"
        },
        {
          "kind": "dialogue",
          "speaker": "莫莉德尔",
          "text": "永别了，妹妹。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "渐黑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雨滴像艳红的蟹爪兰般，在洛佩拉被浸湿的胸口盛开。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "恢复"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "坏了！难道洛佩拉那边出问题了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "混乱枪声"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "蹲下"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "等等，等等，怎么回事！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "听到枪声，老邓肯停下来，观察着庄园里的状况。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "芝诺？"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "他们怎么来庄园了？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "出于直觉，也出于当年打仗遗留下的习惯，他没有鲁莽行事。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "远处，一位年轻的女军官指挥着士兵与德洛丝医生离开，但队伍中没有洛佩拉的身影。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "医生？"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "洛佩拉怎么不在？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "起来"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "往前跑"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "等到陌生的军人离开后，谨慎的老邓肯才跑向教堂方向，找寻同伴。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "下雨"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雨水忽来忽往。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "麻醉弹。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "氛围图"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "啊……我明白了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "麻醉的药效退去，雨水从天上淋向少女的脸庞。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她捡起碎掉的定位纽扣，莫莉德尔射出的子弹将这枚小东西打成了碎块。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "碎掉了吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "姐姐的枪法一向很准——和她一样。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她攥紧纽扣碎片，在手心一点点地、徒劳地将碎片拼成一块。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但雨水冲散了一切。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "父亲……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "无论生父，还是养父。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "无论背叛，或是拒绝。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "那父亲呢，你又是从什么时候开始谋划的这件事？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "没有人回答她，除了从天而降的雨水。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "所有人都离开了，除了她。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "除了我，你们都知道吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老将军收养的其他孩子都知道吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "除了她，其他的家人都知道。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "我从来没有被你们接纳过吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一个苦涩的想法，呛得她胸中一阵火烧般的灼痛。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "退出氛围图"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她翻身起来，靠手肘强撑住失去力气的身体，一阵一阵地干呕着。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "眼泪融入雨水，她的头发湿透了。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "得联系上司辰……"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "该死的！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她捶向雨后湿软的土地，双手沾满泥浆。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "大雨洗过庄园。树影之下，一个熟悉的身影钻了出来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "老朋友找到她，急匆匆地朝她跑来。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "洛佩拉！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这是仅有的好消息。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "邓肯！你没事真是太好了，我们得赶紧——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "起来"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "倒下"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她撑着身子站起来，但腿脚一闪，又跌下去。"
        },
        {
          "kind": "dialogue",
          "speaker": "邓肯先生",
          "text": "发生了什么？那些芝诺的人怎么把你一个人丢在这儿？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他扶住虚弱的洛佩拉，而洛佩拉却对他露出一个悲哀的苦笑。"
        },
        {
          "kind": "dialogue",
          "speaker": "洛佩拉",
          "text": "回荣军院，伊戈尔……他……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她说不出口。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "大雨过后，湛蓝的天穹上日光热烈——太阳就如人心，不可直视。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}