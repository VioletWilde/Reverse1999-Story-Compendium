{
  "episode_id": 11320,
  "chapter_id": 113,
  "chapter_title": "他者的悲哀",
  "display_label": "",
  "title": "命运的一截",
  "subtitle": "不可触碰之物亦有其触感。",
  "trails": [],
  "segments": [
    {
      "script_id": "101333",
      "internal_title": "第十三章13-20.1",
      "items": [
        {
          "kind": "title_card",
          "text": "命运的一截"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "重塑之手袭击学校，只是为了将部分有经验的队伍调离，削弱基金会总部防御。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "现在阿尔卡纳出现在基金会总部，第一防线学校正在受到“暴雨”的威胁……"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……而我们被困在这个奇怪的空间里。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "十四行诗的低声自语让空无一人的走廊显得更为沉寂。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "手指抚过从眼前流过的黯淡金线，它们在黑暗中缠绕出的结因这轻柔的抚摸震颤了一瞬。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在身体内的某个地方，一种神秘而久远的本能正在悄然复苏。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我好像……找到了一些新的方向感。我有办法在这里做些什么。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "十四行诗，我们现在要继续前进——向这个方向。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "可这是……窗外。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "双眼接收到的信息刺激着十四行诗的杏仁核。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "没错，我们需要准备好接受一场坠落。我们不会有事的。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "……我明白。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她踮脚推开被指定的那扇窗户。委员会大楼之下，被职员精心养护的花园抬头与她对视。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "信念与信任压过了基因中对高处的原始恐惧。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她率先爬上窗台，蹲在窗沿上，向着伙伴伸出了手。"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "请握住我的手，司辰，小心脚下。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "跳吧！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "由“奇迹”缔造的迷宫静如死地，没有给任何生命的流动留下余地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但自由落体仍让风呼啸着灌进了耳道。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "十四行诗……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "紧握的手不知不觉间松开，两具身躯一同坠入了黑暗。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……嗯？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "下坠停止了，身体翻转，双脚向下站立在虚空中，感官却向大脑传递着稳定感。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我的视力恢复了……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "不，不对……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "这些线，我见过它们……无数次……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "指腹悬停在线条之上，近得能清晰感觉到线的紧绷与颤抖——它们像能奏出音律的琴弦。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "它们是什么？我为什么能看见它们、触碰它们……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "为什么是我？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“你理应了解时间与命运的秘密。”"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "手掌按在了几乎要被黑色洪流淹没的沙盘上。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑色潮汐飞速坍缩，留下一枚不稳定的种子。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "这是你留给我的谜题吗，阿尔卡纳？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "线的高塔被啃食得千疮百孔，在退潮的滩涂上摇晃。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在崩塌前一刻抬起手，接住了摇摇欲坠的命运——如同本能一般。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "终有一天，我会得到谜题背后的真相。"
        },
        {
          "kind": "dialogue",
          "speaker": "卢卡斯",
          "text": "门……又打开了。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "我们要找的东西，就在门的后面。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "梅蕾尔将手按上不知为何解锁的门，轻轻推开一条缝，谨慎地向内张望。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不由分说，梅蕾尔把孩子们推到一步之外，随后飞快地钻进打开了一条缝的门内。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她猛地把门关上。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "别进来！"
        },
        {
          "kind": "dialogue",
          "speaker": "卢卡斯",
          "text": "怎么了？里面有什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "你们别进来，这……不适合你们看。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她转身，锁上门，把孩子拦在混乱的世界外。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她终于知道学校里消失的教师和警卫都去了哪里。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "老……老师——校长……"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "唔——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她把涌上喉头的呕吐感咽了回去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这份冷静让她自己也吓了一跳。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "我……才不要在这种时候掉链子。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "第一防线学校在“暴雨”中最后的倚仗脱离了基座，血迹和伤痕将洁白的鸽子斜斜切分成两截。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "中央塔的气象鸽果然也已经……没关系，还有备用的……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她蹲下身，推开一具尸体，试图在基座下找到一些完好的备用气象鸽。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "不，不至于……我不会害怕……"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "我和卡戎一起去过更可怕的地方……这样的场面我早就有经验了……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她眨了眨眼，像一台机械般运转起来，将教员失去生气的躯体轻轻翻了过来。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "教员女士的身下压着几只完好的备用气象鸽。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "福格尔女士……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "回忆一股脑涌进毕业生的脑子里，可当年被福格尔女士关禁闭的那些懊恼，却无论如何都回忆不起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她颤抖着抬手擦掉了险些夺眶而出的眼泪，抱出了仅存的气象鸽。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "梅蕾尔姐姐，你找到要找的东西了吗？外面的天越来越黑了……"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "找到了！我马上出来，你们在外面等我。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她郑重地合上了瞭望塔顶层的防爆门，如同为伟大者的坟茔添上最后一把土。"
        },
        {
          "kind": "dialogue",
          "speaker": "卢卡斯",
          "text": "里面……"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "老师和警卫们一起为我们留下了希望。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "学生们似乎从她的脸上读到了一出壮烈的悲剧。他们嗫嚅着，不知道该如何开口。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“暴雨”前的阴云遮蔽了天光，失去电力供应的校园宛如炼狱。怀中的“鸽子”似乎成了唯一的光源。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "你们拿好这些。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "几只气象鸽落进了小鸽子们的手里，而梅蕾尔也让一只气象鸽栖息在了自己怀里。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "……发光的鸽子？"
        },
        {
          "kind": "dialogue",
          "speaker": "卢卡斯",
          "text": "这就是你要找的东西吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "没错，我们成功了。只要能把它们带回去，图书馆的同学就都能从这场“暴雨”中活下来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "事已至此，她已经顾不上那些针对学生的“暴雨”禁令。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "可……万一那些怪物还堵在一楼呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "别担心，我会想办法让你们出去的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "梅蕾尔领着学生们回到二层，通向一层大厅的防爆门依旧如他们上楼时那般紧锁着。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "毕业生将耳朵贴在门上，门后纷乱的脚步声让她皱起了眉。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "听好了，你们先钻进通风管道躲起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "我会把门打开，把怪物都引进二楼，然后你们就从一楼的通风管口钻出去，往图书馆跑。"
        },
        {
          "kind": "dialogue",
          "speaker": "卢卡斯",
          "text": "图书馆……可是学校中庭也还有怪物游荡。我和艾米莉亚能活着跑回去吗……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "恐惧让曾嚷嚷着“我也很厉害”的孩子露了怯。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "不需要你指挥，我的耳朵能听得比你更清楚。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "我和卢卡斯会在跳下来之前用手雷里的神秘术隐身，然后一口气冲回图书馆。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "擅长做计划的艾米莉亚一口气说出了自己的计划。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "这就对了，这样你们就能先带着重要的“鸽子”回图书馆，从“暴雨”中保护同学们。拉文德一定会称赞你们是无与伦比的大英雄。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚&卢卡斯",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "防爆门被神秘术能量猛击，金属门板破开了一道缺口。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "这个术式是……"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "糟了，难道那种家伙不止一个……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "又一道毁灭性的能量束从破开的洞口中射入，直直地击中通风管道入口上方的墙面。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "坠落的残骸堵住了通风管入口。与此同时，神秘术冲击也让瞭望塔的墙面破开了一个口子。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "艾米莉亚，卢卡斯，你们还好吗？！"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "我……我们没有事。"
        },
        {
          "kind": "dialogue",
          "speaker": "卢卡斯",
          "text": "墙、墙壁被炸出了洞……"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·门徒",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一颗熟悉的、完好的头颅正透过门板上的缺口向内张望。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "——糟了！"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "艾米莉亚，卢卡斯，你们从墙上的洞口跳出去，我会用悬浮咒让你们平稳落地。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "那你呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "你们直接往图书馆的方向跑，我会跟在你们后面回——躲开！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "就在同一时间，防爆门终于无法支撑，被切开一个缺口的门板沉重地砸向地面。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "快走！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "梅蕾尔使劲托着他们，将他们从炸开的缺口推了出去。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚&卢卡斯",
          "text": "呜啊！"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "悬浮定止！"
        },
        {
          "kind": "dialogue",
          "speaker": "艾米莉亚",
          "text": "梅蕾尔姐姐——！"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "去图书馆！"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她翻身躲过。能量束从先前被炸开的缺口中射向“暴雨”肆虐的天空。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人形物放下手，缓缓走向墙上的缺口。它探出头向外张望，想从墙壁的缺口中钻出。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·门徒",
          "text": "……？！"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "别想走，你的敌人在这里！"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑·门徒",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "怪物的头颅左右摇摆着，仿佛在做出一项抉择——终于，它回过头，面对留在塔里的敌人。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "梅蕾尔换上最后一匣子弹，深吸一口气。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "我知道你不是杀不死的，怪物，我知道你的弱点在哪里。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "就算这次……只有我一个人在，没有人会来帮我——"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "——我也能干掉你！"
        }
      ]
    },
    {
      "script_id": "101334",
      "internal_title": "第十三章13-20.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "重塑·门徒",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "内藏的软体组织流出破碎的颅腔。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "你……你也别想活着离开……呃——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "下肢传来一阵剧痛。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "梅蕾尔放下手枪，瞥了一眼落在角落里的，在战斗中破损的气象鸽。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "这不难，玛尔纱教过我的……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "梅蕾尔靠墙坐下，撕下一截衣摆，开始为撕裂的伤口包扎。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "布料压迫伤口，疼痛感正逼近峰值。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "要是她看到我这样……嘶——肯定会吓一跳的……唔！"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "不……呃，所有人都会吓一跳的。卡戎，我的队友，维尔汀……我会告诉他们——呃，好了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "包扎完毕，她试着站起来。双腿还能活动——只要她能忍住随着心跳起伏的疼痛感。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "我会告诉他们，这回我真的没有逃……他们一定想不到。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "梅蕾尔也不知道自己什么时候就来到了瞭望塔的底层。她靠在门边，看着瞭望塔外的世界正在以一种怪异的方式“燃烧”。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "雨水在学校中庭被炸开的坑洞中聚集，成了一个个小水洼。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "爆炸……干得不错，艾米莉亚，卢卡斯……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "话音未落，雨滴从地面升起。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "……“暴雨”。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "回图书馆去——和维尔汀还有十四行诗约好了的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她扔下已经无法再击发的手枪及身上其他的负担，只剩怀中黯淡的气象鸽。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "……希望这真的是最后一场战斗了。"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "过去那么多次我都活下来了，这一次——"
        },
        {
          "kind": "dialogue",
          "speaker": "梅蕾尔",
          "text": "我也可以活下来！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她跑入雨中。"
        }
      ]
    }
  ],
  "fallback_fields": []
}