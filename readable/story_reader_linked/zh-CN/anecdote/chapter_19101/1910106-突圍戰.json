{
  "episode_id": 1910106,
  "chapter_id": 19101,
  "chapter_title": "chapter_19101",
  "display_label": "",
  "title": "突圍戰",
  "subtitle": "",
  "trails": [],
  "segments": [
    {
      "script_id": "100732",
      "internal_title": "第七章7-21.2",
      "items": [
        {
          "kind": "title_card",
          "text": "？？？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "剧场场景-游轮。可以考虑一下用通用的渡轮，还是1.7阿尔卡纳在船上那张氛围图把人抠掉。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "浪花击打着船舷。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这是一艘前往新世界的船，也是一艘注定不会返航的船。"
        },
        {
          "kind": "dialogue",
          "speaker": "苏菲亚",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "红发女孩自上船后，一言未发。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一切都已成定局的现在，她唯有沉默。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑教众Ⅰ",
          "text": "……苏菲亚小姐。"
        },
        {
          "kind": "dialogue",
          "speaker": "重塑教众Ⅰ",
          "text": "引导之人真的不和我们一起离开吗？她……"
        },
        {
          "kind": "dialogue",
          "speaker": "苏菲亚",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "传令人没有应答，只是不断摩挲着手中小小的圣像。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "获得它的一幕依然清晰。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "剧场场景-岛屿-炮火轰炸的沙滩-闪回滤镜"
        },
        {
          "kind": "dialogue",
          "speaker": "苏菲亚",
          "text": "您是说，您……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "不用慌张，我的孩子。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "你没有听错。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "——我将于今日死去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "剧场场景-黑屏-闪回结束"
        },
        {
          "kind": "dialogue",
          "speaker": "十四行诗",
          "text": "司辰，术式α点位准备完毕！"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "β点位就位！"
        },
        {
          "kind": "dialogue",
          "speaker": "星锑",
          "text": "我和APPLe先生这边也好了！"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "很好！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这场战斗的目的，自一开始就并非攻击。或者说，至少不是一场在此地发生的攻击。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我申请使用大型神秘术收录号000262603100008，“心向往之”——"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "传送一名极其危险的犯罪者前往巴门尼德基地！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "巨大术式的辉光亮起，笼罩了居于中心的阿尔卡纳。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔卡纳",
          "text": "……噢？"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "别慌张，这只是个长距离旅途邀请。"
        },
        {
          "kind": "dialogue",
          "speaker": "红弩箭",
          "text": "——一路顺风，伙计。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "芝诺的军事基地观察室内，伊戈尔将军（原索姆将军）以及一行人正在紧张的注视着屏幕。在云爆弹发射的倒计时里，阿尔卡纳被传送到了指定地点，云爆弹落下，白光照在伊戈尔将军的脸上。芝诺报告生命反应消失，作战计划成功，阿尔卡纳死亡，以室内一片最后的狂欢结束。"
        },
        {
          "kind": "title_card",
          "text": "芝诺·巴门尼德基地"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "引爆器准备就绪。发射倒计时，30、29、28……"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "目标尚未抵达指定地点。警告，目标尚未抵达——"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "15、14、13……"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "检测到大型神秘术式能量，校验通过，“心向往之”。生命信号出现，目标已监测就位，启动引爆器——"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "6、5、4、3、2……"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "1——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "画面3-爆炸特效。一个持续的白光。"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "真空弹引爆成功。"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "无法监听到任何神秘学能量信号，无生命反应迹象。"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "目标，阿尔卡纳女士，已被剿灭……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "画面4-画面1的差分，操作员兴奋地转头，伊戈尔将军摘下护目镜，观察员望向他们。"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "太好了，我们做到了？我们做到了！"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "上将，汉斯……我们九九年没有做到的事情……"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "这是，这是胜利……？"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "不要放松警惕。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "……但为了那场战役所失去的一切，这一刻将永远铭记在世界历史上。"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "稍等，汉斯！"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "……那是什么声音？你的监听耳机里……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "所有人都听到了它。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一阵刺耳的沙沙声，毫无缘由地在理应隔音的室内再次响起。"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "报、报告，我好像听到了一些生命信号，但是音质受到干扰，我不确定那是……"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "耳机给我。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "画面6-伊戈尔将军凝重地、紧张地监听着耳机，但情绪没有特别外露。其他的员工紧张地望着他。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这次的作战计划是临时提出的，观察室的选址也并不完备。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "至少室内古怪的杂音已经消失了。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "不，并不是。那不是生命的声音。"
        },
        {
          "kind": "dialogue",
          "speaker": "伊戈尔将军",
          "text": "那是……风在呼啸。"
        },
        {
          "kind": "dialogue",
          "speaker": "众",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "……！也就是说……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "同志们，我们做到了。"
        },
        {
          "kind": "dialogue",
          "speaker": "操作员Ⅰ",
          "text": "——祝贺伟大的胜利日！向您致敬，向司辰小队致敬——！"
        },
        {
          "kind": "dialogue",
          "speaker": "观察员Ⅰ",
          "text": "上将，今日，我们终于捍卫了和平。荣耀归于这英勇的一日！"
        },
        {
          "kind": "dialogue",
          "speaker": "众",
          "text": "荣耀归于为这一刻奋战的所有人！"
        },
        {
          "kind": "dialogue",
          "speaker": "众",
          "text": "我们做到了！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "缓慢的淡出，黑屏。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "观察室内迎来了最终胜利的欢呼。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "阿尔卡纳，死亡。"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": [
    "title(zh-TW)"
  ]
}