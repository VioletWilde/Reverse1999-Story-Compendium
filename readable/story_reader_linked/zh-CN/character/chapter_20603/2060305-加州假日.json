{
  "episode_id": 2060305,
  "chapter_id": 20603,
  "chapter_title": "第一千夜",
  "display_label": "",
  "title": "加州假日",
  "subtitle": "",
  "trails": [],
  "segments": [
    {
      "script_id": "309505",
      "internal_title": "【2.0】环状水星玩法剧情05",
      "items": [
        {
          "kind": "title_card",
          "text": "索萨利托，街道"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "街道-索萨利托"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "刚从自行车租赁店中出来，环状水星站在马路边上，看着面前来往的车辆。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她的脸颊上还留有着一丝薄汗，手指在身侧轻轻拍打着乐章。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星时刻倾听着，在万物的交响能量场中关注着属于项链的弱小声部。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "身后四步。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她看着来往的车辆，嘴中念念有词。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "太亮了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一辆车开了过去。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "有点辛辣。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她看向下一辆车。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "听起来像爵士乐……但不是我想要的那种。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她摇摇头，在绿灯的时候开始穿过马路。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "东北方，像是浮在海浪之上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星伸出手去感受着能量的流动，脚下的步伐也逐渐加快了。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "快跟过来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "车水马龙的街道上，每一个人都知道自己的去路。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "快跟过来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星从不期待，她只等待着接受一切事物的降临。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "突然，她的脚步停了下来。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "搭车——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星像是突然抓到什么一样，在街边拦下了一辆白色的轿车。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这是一个能让项链的能量更清晰的渐强符，以及——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "第一乐段应该与第二乐段在这里相遇。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "可以免费送我们一程吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星弯腰趴在车窗上，衣服上的流苏反射着太阳的余辉。"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "你要去哪里？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "弗雷斯诺。"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "上车吧，幸运的女孩，我能带你到圣卢卡斯。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "谢谢。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但她却并不急着上车，反而回过头去寻找着什么。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "比安卡，快来，你只有这一次机会。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星向人群中招呼着。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不远处，一名用头巾伪装自己的女性从公交站牌后不情愿地走了出来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "车里"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "车里远比比安卡想的要热闹得多。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "三只棕色的母鸡和两只白色的公鸡在车的后厢昂首阔步，时不时还会直接飞到比安卡和环状水星的头上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "头部臃肿的白色斗牛梗犬悠闲地趴在副驾驶的车窗上吹着风。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在白色公鸡第三次上下翻飞过后，比安卡终于按捺不住自己的烦躁。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "为什么不把它们关在笼子里？"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "嗯——为了让它们产出我们县里最好的鸡蛋。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "你们县鸡蛋的评判标准难道还包括鸡会不会系安全带？"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "哈哈哈，哈哈哈哈……当然是为了让它们保持心情的舒畅。"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "你可以把它抱在怀里，比安卡小姐，亚历山大是一只非常听话的鸡。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "它的名字甚至叫亚历山大——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡绝望地哀嚎着，这只鸡第四次跳到了她的头上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星轻轻地抱住鸡的翅膀，将它放到了比安卡的腿上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "亚历山大马上乖巧地坐了下来。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "哦！真不错。我忘记了，你有着安抚情绪的能力。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "这是他自己的选择，他喜欢你。"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "很不错嘛！比安卡！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡只能尴尬地应和着，车里很快就安静了下来。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "呃——"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "所以……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡决定问出存于心中已久的疑问。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "你是从什么时候开始发现我的？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "你昨晚坐在车顶的时候。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "这么早？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "我能感受到你的能量。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "那你租了一辆自行车从旧金山骑到索萨利托是故意整我吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "不，我在追寻项链的能量。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "项链的能量。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "环状水星点点头。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "是项链的能量告诉你，如果要从旧金山去弗雷斯诺的话，就要先从旧金山骑自行车骑到索萨利托，然后再从索萨利托搭车，去圣卢卡斯？"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "到了圣卢卡斯之后呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "到了自然会知道。"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "哦……哦——"
        },
        {
          "kind": "dialogue",
          "speaker": "司机Ⅰ",
          "text": "那你们有没有打算去华盛顿看看？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "华盛顿？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡拿过环状水星的地图，在大陆的另一侧找到了华盛顿。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "不不不，我们不可能去那儿。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "脾气急躁又古板的塔罗师从心底里拒绝这个念头。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "这样，环状水星，我们到了圣卢卡斯之后，我来买票，我们乘公共交通直达弗雷斯诺，好吗？总共也用不上几个小时。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "为什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "为什么？因为……这总比漫无目的要好。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "你的目的是什么？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "去弗雷斯诺。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "那是我的目的。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡欲言又止，最终只能烦躁地揉了揉自己的头发。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "随你。随你行了吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "比安卡。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星向前倾了倾身体，让自己能够看到比安卡的正脸。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "你不是对此心生向往吗？要不然你为何会跟上我？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星澄清的眼眸里看不见任何情感，宛如一枚玻璃珠，在其中只能映出比安卡自己。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "你永远都是一眼就把别人看透。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡无奈地摆摆手。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "好，好，我试试就是了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "黑屏"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "我知道一个自由如风的女孩。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "她会在任何一个地方降落，也会随时在那里起航。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "新纪元集市-夜"
        },
        {
          "kind": "dialogue",
          "speaker": "商贩梅克卢",
          "text": "但在这里的并不是我们所有人，有个人一直没有跟德克斯特说过话。"
        },
        {
          "kind": "dialogue",
          "speaker": "疗愈师库伯",
          "text": "谁？"
        },
        {
          "kind": "dialogue",
          "speaker": "商贩梅克卢",
          "text": "比安卡！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "正准备撬开瓶盖的手停了一下，似乎是没想到会提到她的名字。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但随后，她仍旧完成了这个动作。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "那是一个我从来都不会去参加的聚会，我只要在远处看着就好，就像一开始那样。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡随意地一弹，瓶盖便落到了一个塑料桶里，那里面已经积攒了不少各个品牌的金属瓶盖。"
        },
        {
          "kind": "dialogue",
          "speaker": "芳香师丽雅",
          "text": "你是说……那个一边敲着她的房车油箱，一边喊着要钱喝酒的人？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "是啊，是啊，这就是我爸。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡仰头喝了一口酒，她现在还不知道明天能躲去哪里。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "如果被自己的父亲找到的话，免不了又是一顿祈求与强夺。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "早知道就该和索拉亚一起走，也不会还为这种事烦心。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但是当时我为什么没选择离开呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "明天一早，我就会出发。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "嗯？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡喃喃念道。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "明天一早，我就会出发。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "为什么她可以这么自由呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡支起了下巴，看着他们畅聊过后，熄灭篝火，有的人就这么回到自己的帐篷里，有的人径直离开，准备回家。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "新纪元集市就这么安静了下来。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "我能不能也这么自由呢？"
        },
        {
          "kind": "title_card",
          "text": "圣卢卡斯，郊外"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "原野"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "你的心情看上去很低落，你的能量，它们萎靡不振。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "任谁在石子路上徒步一个小时都会萎靡不振的，你难道不累吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "可少女的脚步依旧轻快。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "我们到哪里了？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星拿出了地图，却迟迟没有指出位置。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "环状水星？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "我不知道。我在跟着你走。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡停下来，她向四周望去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "道路蜿蜒向上，穿过了群山，柏油路的尽头浮着浓雾。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "那现在要怎么办？是原路返回，在那个镇子里搭车，还是继续走下去？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "嗯——这是你的选择，你来决定。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "回忆特效"
        },
        {
          "kind": "title_card",
          "text": "圣卢卡斯，街道"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "街道"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "50分钟前。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "带着一身鸡毛，环状水星和比安卡终于在圣卢卡斯下了车。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "他还送了个鸡蛋给我。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡将鸡蛋对准阳光，白皙的蛋壳下看不清是否存在胚胎。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "接下来要怎么办？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "你想去哪里？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "先去找个地方看看这枚蛋是死是活吧。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "那个店就可以。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星随手一指，一个屋顶上带有公鸡风向标的屋子映入比安卡眼帘。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "不，我来决定。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "为了履行刚才在车上做出的诺言，比安卡跃跃欲试了起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但她实在摸不到头脑，只能闭上眼睛转圈，在即将失去平衡要摔倒的时候，比安卡睁开了眼睛。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "那里！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "指尖指着的是一条被砂石掩盖的土路，它看上去是一条坦途。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡将鸡蛋放回掌心，再次宣告了自己的决定。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "就往那边走，让我们遇到的第一家店的店主告诉我们答案。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "回忆特效结束"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "原野"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "我就不该搞这种一时兴起的东西。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡痛苦地蹲了下去。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "你以前遇见这种情况的时候会怎么办？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "跟随能量……"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "能量、能量、能量！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡索性直接坐在了地上。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "那你的能量让你去哪里？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "跟着你走。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "噢！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "事情陷入一个死循环中，比安卡索性直接躺在了路旁。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "休息一下也是好的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星躺到了比安卡的身边，银灰色的发丝散入青草之中。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她闭着眼睛，一只草蛉跳到了她的鼻尖上，她似乎感觉到了瘙痒，用食指轻轻搓弄几下后，便转身到另一边去了。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "你就要这么睡着了？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "风把青草的气息送到了比安卡的鼻子里。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "要出发吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "不。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "那为何不睡呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星给自己换了一个更舒服的姿势，她仿佛真得要在这里好好睡上一觉了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而比安卡也不知道到底该做什么选择。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "所以她只能闭上眼睛，紧紧地闭上眼睛。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "比安卡。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "嗯？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "你在焦急地睡觉。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "天呐，你明明背对着我！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡索性转过身去，也开始背对着环状水星。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "我并没有在睡觉，我在思考。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "二人无言，过了一阵，比安卡像是要挣破什么一般扑腾了起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "哎呀！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "塔罗师站起身来，拿出了自己随身携带的塔罗，但在摸到的那刻，她又放了回去。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "我们这样真的能到弗雷斯诺吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "嗯。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "路线不会不对吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "不管怎么样，我们最后都会到达。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "天——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这句话令比安卡感到无比抓狂。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "真的能吗？怎么到达？何时到达？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这句话可以引发的疑问太多了。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "你也可以选择回去，这并不意味着你是一个不自由的人。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "不自由……"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "唉。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡吹了吹额前的碎发。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "如果是你的话，你会一直走下去吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星睁开了眼睛，看着比安卡。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "我不会选这条路，这是你的旅途。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "但如果是我的话，我会去追寻眼外的未知——直到有什么让我停留。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "绝望的塔罗师只能眺望着远处，道路随着地势向上，望不见山的那头。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "如果，如果山后面什么都没有的话。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡指着那条穿过山隘的路，那是他们能看到的最远的地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "如果那里什么都没有的话，我们就回到镇子里。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "好。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡拉着环状水星站了起来，二人重新回到了柏油路上。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "原野"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一段看似漫长的时间后。"
        },
        {
          "kind": "title_card",
          "text": "圣卢卡斯，郊外"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "呼……呼……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡的每一步都好像深陷进泥里。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她艰难地把脚抬起来，沉重地将脚落下去，但自己却没有前进多少。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "呃……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "比安卡抬起头来，自己离道路的最高点还有不少距离。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "但环状水星却不似她那样疲惫，她如山羊般早早跃到了最高处，开始眺望起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "比安卡，快来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一阵远望过后，她向比安卡伸出了手，帮助她迈出了最后一步。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "看。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "葱绿的山坡下，黝黑的道路旁，一座小房子伫立在平原处，让它成为了这一幕里最吸睛的小红点。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "那不像个普通住房，它的院子前面立着一个招牌……没有想到，这里居然真的会有一家店。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "你能看清楚那上面写的什么吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "环状水星摇摇头。"
        },
        {
          "kind": "dialogue",
          "speaker": "环状水星",
          "text": "但我们马上就会知道你会不会有一只宠物鸡了。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "我更希望它能给我们提供一个歇脚的地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "塔罗师比安卡",
          "text": "不然我会走出一条血路。"
        }
      ]
    }
  ],
  "fallback_fields": [
    "title(zh-TW)"
  ]
}