  "segments": [
    {
      "script_id": "200310",
      "internal_title": "【1.3】印度观星-9.1",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人们聚在院子里的大陶缸前。"
        },
        {
          "kind": "dialogue",
          "speaker": "鬃毛沙砾",
          "text": "你确定……你要用这个东西吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "怎么了吗？这罐子里的水刚刚好……我也正好能够进去。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鬃毛沙砾看着破败的陶缸与其中混沌成一片的落叶与脏污，沉默了片刻。"
        },
        {
          "kind": "dialogue",
          "speaker": "鬃毛沙砾",
          "text": "唔，你对实用性的追求比我想象的高。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "对了，还有……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伽菈波那将那枚毗湿奴神像交给了玛蒂尔达。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "咦？伽菈波那小姐，你不带着它吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "不……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她摇了摇头。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "鬃毛沙砾先生说过的话……不无道理。这是我们的底牌，它离库玛尔越远越好。"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "唔……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "那伽菈波那小姐，你带上这个！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "递过来的矿石晶莹剔透，仿佛一颗刚摘下来的星星。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……这不是你的……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "我的灵摆！我珍藏的、纯度极高的珍品！这样好的水晶，我自己总共都没有几颗……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "我发现你所说的冥想理论，一定程度上和水晶占卜的某些理论根源非常相似～所以如果有水晶帮助你平衡磁场、引导灵知的走向……想必一切都会顺利很多——"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "你……"
        },
        {
          "kind": "dialogue",
          "speaker": "玛蒂尔达",
          "text": "哼哼，不用惊讶，这是天才基本的反应速度！"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……谢谢。"
        },
        {
          "kind": "dialogue",
          "speaker": "鬃毛沙砾",
          "text": "很好，看来不能理解“在水里冥想”这个行为的人只有我一个——但没办法，山岩就是多姿多样……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伽菈波那迅速地将腿探入陶缸内，如同感觉不到冰冷一般。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "好的……灵摆，还有足够多的液体……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "现在，只需要……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "——想着库玛尔。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "卸掉双腿支撑的力，伽菈波那放任自己的身体滑入水中。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "声音迅速地远离了她的世界。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "寒意没过头顶，自四面八方侵袭而来。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "哈啊……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "或真或假，亦虚亦实，世界重新浮现于眼前。"
        },
        {
          "kind": "title_card",
          "text": "？？？"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……果然，会是这里。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "我们第一次见面的地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "眼前熟悉的石阶比记忆中的要长得多。粗砺的红色砖瓦，精心计算的圆弧，简塔·曼塔天文台每一处都有着独属于它的美感。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "呵，看来库玛尔为这场会面下足了心思。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "竟然在幻境里还原出了这些……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "在顶端终点静立的身影就像一个黑色的奇点。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她知道那是谁。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "我心中的幻影，罢了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "左脚踏上了第一层台阶。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "意料之中的困难出现在眼前。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "看来她把我小时候的样子记得很清楚。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "拦在面前的身影，与她小时候的模样相差无几，总是紧攥着拳头，脸上的表情永远像是在对抗着什么。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "而现在，“她”的愤怒或许来自于这场不请自来的入侵。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“她”朝伽菈波那奔去，灵活地挥动着拳头。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "唔，好疼……！"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "我小时候的拳头，有这么坚硬吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "出去，这不是你该来的地方！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "“她”驱赶着伽菈波那，体态明显受过严格的训练。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "啊……是的。妈妈曾教过我……对付那些坏小子的招数。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "离开！"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……呃唔，真是……好奇怪的感觉。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "是库玛尔让你在这里的吗？让你保护着……这段时间的回忆？"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "看来必须过了你这一关，才能前往我想要到达的地方。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "直面过去的幻影吧。"
        }
      ]
    },
    {
      "script_id": "200311",
      "internal_title": "【1.3】印度观星-9.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "啊……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "幻影消散了，又重新在远处聚拢。与此不同的是，“她”这次不再带有那样强烈的愤慨。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "呵呵……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "天文台的光影使“她”逐渐模糊，声音也愈发飘远。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "从过去，到现在，到未来……"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "你所要执着的，追逐的，面对的……是什么……"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伽菈波那低下头，看了看自己的手掌。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "你还是像以前一样，总是问一些没有答案的问题。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "你认为我追逐的“应该”是什么呢？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她收起手指，将手轻轻握起。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "别想误导我，库玛尔。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "天文学这条路，从那天之后我就没有放弃过。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空旷的空间里，除了回音，什么也没有留下。幻影已经离开了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "她抬起头，看着几乎望不到顶的天阶。"
        },
        {
          "kind": "dialogue",
          "speaker": "伽菈波那",
          "text": "……继续前进吧。"
        },
        {
          "kind": "title_card",
          "text": "3#8"
        }
      ]
    }
  ],
  "fallback_fields": []
}