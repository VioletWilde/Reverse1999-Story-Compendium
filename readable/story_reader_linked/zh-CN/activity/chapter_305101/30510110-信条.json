  "segments": [
    {
      "script_id": "2030517",
      "internal_title": "【S01】翡冷翠之春10.1",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "血。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人们说，佛罗伦萨是一片浸润荣耀与鲜血的土地。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这里流淌着罗马人的血，圣徒的血，圭尔夫与吉贝林的血，美第奇与帕齐的血……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "以及那些为自由而战的人的血。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "圣殿骑士Ⅵ",
          "text": "别做无意义的抵抗了，这次我们几乎投入了全城的兵力。"
        },
        {
          "kind": "dialogue",
          "speaker": "圣殿骑士Ⅵ",
          "text": "教皇下达的指令除了带回遗物与金苹果以外，还有一条同等重要的……"
        },
        {
          "kind": "dialogue",
          "speaker": "圣殿骑士Ⅵ",
          "text": "那就是杀死刺客艾吉奥·奥迪托雷。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我们可以配合你打开密室。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "维尔汀！我们不应该——等等，你怎么会知道如何开启密室？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "阿尔贝托满意地鼓起掌来。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "很好。是时候让你的小小秘密从尘封中解脱了～"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "维尔汀……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "没关系，我们先看看画。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "笃定的语气稍稍抑止了不安情绪的蔓延。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "还记得那句拉丁文谜语吗？"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "当然。它是一切故事的起点。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "消隐的终点啊！它们在夕光中交融。"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "我和莱昂纳多他们认为“消隐的终点”就是消失点的意思。而“交融”则是指将消失点都连接起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "连接起来，然后得到交点？那么下一句“在夕光中交融”……"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "在黄昏的时候，将我，也就是滤光器放在它们的交点上？"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "没错。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "很好，我顺从的羔羊们……你们已经完成了自己的使命。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "接下来就是一些乏味的收尾工作了。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "香炉吐出缕缕白色的薄雾。它们延展、侵占，漫无边际地流淌着。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "APPLe某这是入了天堂吗？似乎有些头晕……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "烟里有毒，快屏住呼吸！"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "屏住……屏住……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "时间仿佛停止了流动。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空气里弥漫着莨菪碱与阿托品的快活气息。它们篡改颜色，扭曲线条，毫无芥蒂地将一切物理法则抛诸脑后。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "嗯哼……上如其下，下如其上～"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "天真的孩子，你以为你是在为你的同伴们争取时间……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "眼前的身影不断倾斜、弯曲，只剩唇部一张一合，是无比聒噪的黑色乌鸦。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "一切都无济于事。当你们背离了秩序，世界也会将你们遗弃在无尽的荒芜之中……"
        },
        {
          "kind": "dialogue",
          "speaker": "维尔汀",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "老鹰……？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "杳远的鹰鸣声将意识略微拉回。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "像是突然想到了什么，神父快步走到窗前，神色也变得和缓。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "噢，我的记性还是这样差。已经临近黄昏，他们一定解决了……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "蒙尘的彩色玻璃与鲜血交织成一片动人的弧光海洋。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "阿尔贝托跪倒在薄暮的光中，从另一双眼中窥见自己将死的面容。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "艾吉奥？这怎么可能……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "空气中弥漫着淡淡的腥气，血与尘土将灰白色的衣袍层层浸染。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他刚从另一个战场奔赴而来。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "你想让世界屈服于你，但很遗憾……"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "世界有它自己的规则。"
        }
      ]
    },
    {
      "script_id": "2030518",
      "internal_title": "【S01】翡冷翠之春10.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一场以少胜多的战役。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "落败的神父仰躺在地，苍白衰老的面容在血泊中逐渐模糊。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "咳咳。艾吉奥……你可真是条阴魂不散的恶犬。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "刺客从不会跟丢他的目标。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "我们部署了那么多兵力……你是怎么逃出来的？"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "圣殿骑士Ⅵ",
          "text": "我们部署了这么多兵力，你早已无路可逃。"
        },
        {
          "kind": "dialogue",
          "speaker": "圣殿骑士Ⅵ",
          "text": "跪下迎接你的命运吧——秩序的意志不可违抗。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "街旁的门窗早已紧紧关闭。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "四下寂静无声，就连风也屏息着，似在等待一场残酷的处刑表演。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "你们认为可以通过数目来扭转一切。但请记住——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "伴随话语落下，更多同伴悄然走出阴影。"
        },
        {
          "kind": "dialogue",
          "speaker": "圣殿骑士Ⅵ",
          "text": "——！！"
        },
        {
          "kind": "dialogue",
          "speaker": "圣殿骑士Ⅵ",
          "text": "你们是什么时候……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "人群不断围拢在艾吉奥身后。他们身手如影，幽灵一般出现，有的从屋顶跃下，有的从巷弄里潜行而来。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "每个人都沉默着，眼神却很透亮，仿佛说尽了一切——"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "行于黑暗，侍奉光明。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "我们是刺客。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "人们向我伸出了援手——情况就是这样。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "不……这不可能……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "艾吉奥半跪下身体，望向神父因痛苦而不断颤动的双眼。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "或许你们能调动全城的兵力。但刺客拥有的，可远不止于此。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "锋刃干脆利落地贯穿心脏。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "不……这不该是终结……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他不断咳嗽着，又神经质地笑了起来。"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "呵……刺客，一群被虚妄理想驱使的傀儡。我诅咒你们……"
        },
        {
          "kind": "dialogue",
          "speaker": "阿尔贝托",
          "text": "你们的每一次刺杀，都将离黑暗更近一步……"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "如你所愿。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "离黑暗近一步，更近一步——这并非诅咒，而是所有刺客命定的归途。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "刺客从不畏惧黑暗，正如鹰从不畏惧天空。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "信仰应带来自由，而非仇恨。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他轻轻阖上阿尔贝托的双眼。"
        },
        {
          "kind": "dialogue",
          "speaker": "艾吉奥",
          "text": "安息吧。"
        }
      ]
    }
  ],
  "fallback_fields": []
}