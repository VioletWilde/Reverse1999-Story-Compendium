{
  "episode_id": 1110110,
  "chapter_id": 11101,
  "chapter_title": "雷米特杯失窃案",
  "display_label": "",
  "title": "小礼物",
  "subtitle": "一份小小的心意，一点微不足道的帮助。",
  "trails": [],
  "segments": [
    {
      "script_id": "200116",
      "internal_title": "【1.1】雷米特杯-10",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "查尔顿先生与小狗们抵达了雷米特杯展览。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "这理应是一次和谐的家庭聚会，大家都这么想。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "除了皮克勒斯。"
        },
        {
          "kind": "dialogue",
          "speaker": "温迪",
          "text": "汪汪——！"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪……汪汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "温迪",
          "text": "汪、汪汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "皮克勒斯瞥了瞥正在售票处忙活的查尔顿先生。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪，汪汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪……汪汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "温迪",
          "text": "汪！汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小斗牛犬努力地拱着皮克勒斯的身体，示意对方向前。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪汪，汪……"
        },
        {
          "kind": "dialogue",
          "speaker": "温迪",
          "text": "汪！汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "有更多的小狗从查尔顿身旁钻出来，把皮克勒斯围在了中间。他一向是最受欢迎的小狗。"
        },
        {
          "kind": "dialogue",
          "speaker": "爱丽丝",
          "text": "汪——!"
        },
        {
          "kind": "dialogue",
          "speaker": "纳尔森",
          "text": "汪汪！汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "嗯——？呜呜？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小狗们整齐地点了点头。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "呜……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "皮克勒斯还想再说些什么，旁边查尔顿先生愤慨的抱怨声打断了他。"
        },
        {
          "kind": "dialogue",
          "speaker": "查尔顿",
          "text": "你们的宣传单上明明写的是“我们欢迎每一位热爱足球运动的观众”！"
        },
        {
          "kind": "dialogue",
          "speaker": "安保员",
          "text": "是的，先生。"
        },
        {
          "kind": "dialogue",
          "speaker": "查尔顿",
          "text": "那你就应该让我们进去！"
        },
        {
          "kind": "dialogue",
          "speaker": "查尔顿",
          "text": "我、温迪、爱丽丝、纳尔森，还有小皮克勒斯，我们都热爱足球！"
        },
        {
          "kind": "dialogue",
          "speaker": "安保员",
          "text": "很抱歉，宠物禁止入内。"
        },
        {
          "kind": "dialogue",
          "speaker": "安保员",
          "text": "我们准备了“宠物留存区”，甚至提供了专业的警犬看护。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "安保员指了指旁边巨大的笼子，里面堆满了各色的小型足球和小狗玩具。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一只黝黑的警犬懒洋洋地趴在门口。"
        },
        {
          "kind": "dialogue",
          "speaker": "查尔顿",
          "text": "呃……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "查尔顿迟疑地拾起里面的一个柠檬黄色的足球玩具，用力捏了捏。"
        },
        {
          "kind": "dialogue",
          "speaker": "温迪",
          "text": "汪——！"
        },
        {
          "kind": "dialogue",
          "speaker": "纳尔森",
          "text": "汪汪——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小斗牛犬跳起来叼走了查尔顿手里的球，积极地冲进了它的新乐园，其他小狗们也紧随其后。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "玩具就是玩具，令人快乐的玩具。大家显然并不像人类那么在乎足球的大小与颜色。"
        },
        {
          "kind": "dialogue",
          "speaker": "查尔顿",
          "text": "噢……别磕到头，温迪～"
        },
        {
          "kind": "dialogue",
          "speaker": "查尔顿",
          "text": "看样子我们都能有个不错的去处。"
        },
        {
          "kind": "dialogue",
          "speaker": "查尔顿",
          "text": "祝你们在小狗乐园里玩得开心～"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "查尔顿朝着笼子的方向用力地挥了挥手，转身没入了游客队伍的人流之中。"
        },
        {
          "kind": "dialogue",
          "speaker": "温迪",
          "text": "汪——！汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "爱丽丝",
          "text": "汪～"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪汪，汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "爱丽丝",
          "text": "汪、嗯……？"
        },
        {
          "kind": "dialogue",
          "speaker": "纳尔森",
          "text": "汪汪……嗯！"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "趴在门口的警犬拍了拍皮克勒斯的肩膀。"
        },
        {
          "kind": "dialogue",
          "speaker": "安保犬",
          "text": "汪——呜！"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪……吽吽。"
        },
        {
          "kind": "dialogue",
          "speaker": "安保犬",
          "text": "吽、吽吽……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "吽、吽吽……汪？"
        },
        {
          "kind": "dialogue",
          "speaker": "安保犬",
          "text": "汪——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "对方重重地点了点头。"
        },
        {
          "kind": "dialogue",
          "speaker": "温迪",
          "text": "汪、汪汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "爱丽丝",
          "text": "呜呜……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪，汪汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "安保犬",
          "text": "獒、獒獒……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "吽吽，吽？！"
        },
        {
          "kind": "dialogue",
          "speaker": "安保犬",
          "text": "獒！獒！……汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪汪，呜……"
        },
        {
          "kind": "dialogue",
          "speaker": "爱丽丝",
          "text": "呜呜……？！"
        },
        {
          "kind": "dialogue",
          "speaker": "纳尔森",
          "text": "汪——！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小狗们听得很入神，它们七嘴八舌地展开了讨论。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "狺狺……狺。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "狺狺——！"
        },
        {
          "kind": "dialogue",
          "speaker": "安保犬",
          "text": "汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "皮克勒斯像是突然想起了什么，他转头看向门口那条正在缓缓进入场馆的队伍。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "查尔顿先生的身影已经不在其中了。"
        },
        {
          "kind": "dialogue",
          "speaker": "安保犬",
          "text": "呜……呜呜～"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪……汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "皮克勒斯展现出了作为边境牧羊犬的优良素质。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "他身手矫健地避开了所有的荆棘与护栏，像一个真正的英雄。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "狺……狺狺。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "狺狺。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "狺狺，狺……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "皮克勒斯的目光落到了那个破开的小洞上。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "狺～"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "树上偶尔会有苹果落下，这应该属于常识。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "我们又见面了……有着忧郁眼神的小狗。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪——？"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "APPLe某受船长之托，先行进入场馆调查情况。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "呜——？汪汪！"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "对了……"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "自从上次分开之后，APPLe某就一直在思考与你交流的方法。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "我制作了这个。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "一个简易的翻译器——“Doggie”。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "它仍处于测试阶段，功能并不完善，时有故障。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "对犬类语言的理解也存在一定偏差……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "APPLe把翻译器递给了皮克勒斯，短暂的犹豫之后，皮克勒斯接过了它。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪……汪。"
        },
        {
          "kind": "dialogue",
          "speaker": "\"Doggie\"",
          "text": "小狗表达了他的感谢。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "不用谢。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "但可惜的是，APPLe某现在并没有多余的时间来测试它的效果。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "你最好尽快离开，这儿随时可能出现滥用暴力的安保机器人。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "呜。"
        },
        {
          "kind": "dialogue",
          "speaker": "\"Doggie\"",
          "text": "小狗拒绝了你的建议。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "嗯？"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪、汪……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "狺……狺狺……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪……汪汪……"
        },
        {
          "kind": "dialogue",
          "speaker": "\"Doggie\"",
          "text": "里面有着对小狗来说非常重要的东西。"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "…………"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小狗陷入了沉默。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "原来如此，这是一个合理的理由。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "让我们一同前进吧，在出现危险的时候APPLe某会尽可能帮助你的。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "APPLe落在皮克勒斯的背上，他们都做好了准备。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "简单地助跑之后，皮克勒斯在空中划出一个完美的弧线，轻松地穿过了破损的防盗网。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "唔——！"
        },
        {
          "kind": "dialogue",
          "speaker": "皮克勒斯",
          "text": "汪汪……"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED ..."
        }
      ]
    }
  ],
  "fallback_fields": []
}