            {
              "kind": "dialogue",
              "speaker": "",
              "text": "是的，一本益于融入社会的书。"
            }
          ]
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "《北非的兽群》",
          "edge_label": "",
          "branch": [
            {
              "kind": "dialogue",
              "speaker": "",
              "text": "是的，一本能够唤醒野性的书。"
            }
          ]
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "《手持百合的爱人》",
          "edge_label": "",
          "branch": [
            {
              "kind": "dialogue",
              "speaker": "",
              "text": "是的，一本点亮彼此灵魂的书。"
            }
          ]
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "《几何原本》",
          "edge_label": "",
          "branch": [
            {
              "kind": "dialogue",
              "speaker": "",
              "text": "是的，一本追问世界本质的书。"
            }
          ]
        }
      ],
      "link_source": "supplement_episode_id"
    },
    {
      "element_id": 3210407,
      "owner_episode_id": 3210119,
      "trigger_episode_id": null,
      "title": "虽然并非皆大欢喜",
      "description": "",
      "action": "类型3203",
      "unlock_condition": "EpisodeFinish=3210119",
