  "chapter_title": "悲しき熱帯",
  "display_label": "",
  "title": "台風の目",
  "subtitle": "過去に向かって放たれた弾丸。",
  "trails": [
    {
      "element_id": 1081801,
      "owner_episode_id": 10818,
      "trigger_episode_id": null,
      "title": "在りし日の分れ道・アンジョナナ",
      "description": "",
