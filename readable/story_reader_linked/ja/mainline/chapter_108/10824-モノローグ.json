  "segments": [
    {
      "script_id": "100837",
      "internal_title": "第八章8-24",
      "items": [
        {
          "kind": "title_card",
          "text": "モノローグ"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は銃を手に取り、弾を込める。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "一、二、三…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "ここには敵もライバルもいない。つまり当然、ターゲットもいない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "これほど呆然とした状態で銃を手に取ったことはない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "まるで荒野に佇むハンターの如く、彼女は方向と家を失った。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "当たり。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "弾が全て撃たれ、的に穴が一つ残る。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "一、二、三…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "薬莢が外され、再び弾が込められる。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "一、二、三…"
        },
        {
          "kind": "title_card",
          "text": "財団の客間"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "部屋が「穴だらけ」になる。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "指は既に麻痺をしていたが、少女は機械的に引き金を引いていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "反応はない。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "嘘つき。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "偽善者。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "裏切り者。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "力を緩めた手から、銃が滑り落ちる。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "初めからわたしを追い出す気だったんだな？"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "初めから、彼女を含まない計画だった。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "つまり、初めからわたしを信用してなかったってことだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "全部ただの演技だったのか、姉さん？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "銃を手放した「ハンター」は、果てしない荒野を見つめる。ここにはイチジクを揺らす風以外、何もない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は壁にもたれかかり、自分を強く抱きしめた。"
        },
        {
          "kind": "dialogue",
          "speaker": "ロペラ",
          "text": "どうして…"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪同じ道"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪秋の境"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪枯れ葉舞い 落ちる"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪火は過去を"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪燃やすことは"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪できない"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪悲しき熱に さよなら"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪潤む瞳"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪悲しき熱に お別れ"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪私はひとり"
        },
        {
          "kind": "dialogue",
          "speaker": "アンジョナナ",
          "text": "♪あなただけを 想う"
        },
        {
          "kind": "title_card",
          "text": "THE END"
        }
      ]
    }
  ],
  "fallback_fields": []
}