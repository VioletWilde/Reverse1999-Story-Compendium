  "segments": [
    {
      "script_id": "100741",
      "internal_title": "第七章7-28",
      "items": [
        {
          "kind": "title_card",
          "text": "数直線の両端"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "どうして…"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "本質に還った者たちを祝福するべきなのに…どうしてこんなにも悲しいの？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "ソフィアが自身の数字を知った時も…喜ぶべきなのに、わたしは悲しいと感じてしまった。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "砂浜はかつての清潔な姿に戻った。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "「ストーム」は戦争の残がい、歓声をあげる人々、交わされた盃――その全てを洗い流した。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "そこは在りし日の完璧な姿に戻り、なに一つ塵埃を残さなかった。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "たった今、一つの時代が終わりを告げた。最後の余韻をも連れて。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "どうして…みんな離れるの？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "わたしの計算が遅かったから？　それとも、計算過程が良くなかったから？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "あ…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女の身体は小さく震え、やがて、風を失ったかのように砂浜に崩れた。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "うっ…"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "ううっ…"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "うわあああああああああ――！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "涙が頬をつたい、地面の泥と混ざり合う。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "顔が、髪が、金縁のローブが泥によって染まっていった。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "それでも彼女はただ、幼い獣のような泣き声をあげる。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "――現象界における、初めての涙だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "教主も、あの時の質問の答えを得た。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "局外の知恵と、局内の苦痛。彼女は「苦痛」を選んだのだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "別れの時がきた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "島を出なさい、３７。君は外の世界を見るべきだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "……！？"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "ミス・ヴェルティ、あなた方は現象界のぬかるみで模索する道を見つけました。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "どうかそれを、永遠に戦には利用しないでいただきたい。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…はい。それがわたしたちの使命です。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "教主は頷く。互いにあの巻物の重みを理解していた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "そういえば、あなた方が探していた方…「ウルド」という名の伝記作家についてですが、聞き覚えはありません。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "ですが、先代の６の記憶に残る女性の一人が、あなたと同じ特別な数字でした。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "……！　それは…"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "残念ながら、私に継承される「伝承」はあやふやな情報しかありませんが、少しでもお役に立てれば。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "そう言うと彼は既に空き地と化した砂浜に背を向け、歩き始める。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "数名の信者が彼のあとに続いた。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼の動きに気づいた少女は、慌てて涙を拭い立ち上がった。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "待って、６、どこへ行くの――？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "みんな行っちゃった。ソフィアに２１０に８８８…それにあなたまで――行っちゃうの？"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "私は洞窟に戻らねばならない。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "憎しみに抗い、狂乱と激情の道を選ばなかった者もいる。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "聖地への道は既に地震によって崩壊した。だが、信念はまだ崩壊していない。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "我々は書を読み、経を書き、聖堂を修復し――苦行と思考の中、古の者への崇拝を続け、砕けた信仰に再び光を灯そう。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "我々の選択がこの島を、現象界の紛争から遠ざかった浄土を、古典的な秩序の王国を生んだ。ゆえに、我々が従順する限り、それは決して消えることはない。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "わたしも一緒に行く！"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "いや、君は既に選択をした、３７。君はここにいるべきではない。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "君の苦痛や疑問は、外の世界に触れることでしか答えを得られない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "３７の顔から一気に血の気が引く。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "６は軽く頭を振り、海面に映る夕日を見つめた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "数千年前、ローマ帝国の戦火から逃げ延び、ここに辿り着いた最初の信者たちによって教団は設立された。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "五百年前、 アラビア人難民集団が訪れ、その模写本で洞窟を埋め尽くした。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "半世紀前、己の研究が戦争に濫用されたことを恨む学者がここに訪れ、現代数学の知恵を補完した。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "彼らの中にも、３７や６は大勢いた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "――我々と彼らの間に本質的な違いはあるのだろうか？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "たとえ、私たちがいなくなっても、３７と６は消えない。この島が大海原に沈んだとしても、必ず新しい数字が世界のどこかに誕生する。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "整数の列は無限だ、３７。数直線の個別の数字に囚われず、君自身の数式を綴るべきだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…つまり、あなたは局外の知恵を選んだということですね。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "――ですが、なぜ知恵は局外にあると決まっているのですか？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "教主は微笑んだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "あなたは知恵というものを過大評価しすぎています。知恵は万能ではありません。それは人を無知から救うと同時に、虚無へと導くものです。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "虚無の知恵を必要とする者は必ずいます。俗世の苦痛から一時的とはいえ、開放してくれる存在ですから。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "島には必ず誰かが残り、現象の海から漂流してきた者たちに政治とは無関係な避難所を与えねばなりません。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "――道に迷いし者のために、居場所を作らねば。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼はそのまま、その場を立ち去ろうとする。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "待って、６、待っ――！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "３７は慌てて顔を拭き、ローブを引きずったまま砂浜を走った。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "でこぼこな砂利につまずき、彼女は転んだ。だが、そんなことはお構いなしに彼女は全力で追いかける。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "待ってよ、６――"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "――アティクス！"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "――！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "男は歩みを止めた。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼が思ってもみなかった呼び名だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "数字は名前ではなく、魂の本質だ。一方で名前は、現象界における浅はかな音に過ぎない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼の数字は生まれつき決まっていた。その命名よりもずっと前に。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "３７が彼を名前で呼んだことは一度もない。彼女はいつだって本質を見分けるのに長けていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "しかし今、彼女は彼の名を呼び、その目の前に立つ。髪の毛は泥で絡まり、膝からは血を流し…散々な姿だが、それでもしっかりと立っていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "…隠遁部屋に、小さな扉を残してくれる？　子どもの時みたいに…"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "至高なる規律が乱れたのは知ってる。でも、真理が消えたわけじゃない。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "必ず、紊乱の中で新しい道を見つけて、最高の答えを導き出してみせる。現象世界で、見つけてみせる…"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "もし、わたしが解決できない難問にぶつかったら、昔みたいに…あなたのところに行って、真理について語り合ってもいい…？"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "デルフォイの神殿には三つの箴言が彫られている。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "「汝、自身を知れ」、「多くを求むるべからず」、そして…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "「誓いの傍に災いあり」だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "しかし、他に何が言えるだろう？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "皆の疑問を払拭するのは、教主の勤めだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "――君のための扉を残そう、３７。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "君も、君の仲間も、自由に出入りしていい。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "――約束だよ！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は涙を拭き、手を振って教主に別れを告げる。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "とうとうきた別れの時に、先ほどのような残酷さはない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "信者たちが離れ、砂浜には上陸時のメンバーのみが残った。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…ゼノミリタリーの船がきた。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "行こう、３７。ラプラスの研究員たちがきみに会いたがってる。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "素数は軽く肩を震わせた。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…未知の世界は、怖い？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "…少しね。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "そう…でも、がんばって慣れてみせるよ！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は深く息を吸い、心の雑念を抑える。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "やがて、いつも通りの笑みを浮かべた。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "――だって宇宙は均一だもん！"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}