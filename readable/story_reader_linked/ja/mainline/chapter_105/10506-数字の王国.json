  "segments": [
    {
      "script_id": "100508",
      "internal_title": "第五章5-6.1",
      "items": [
        {
          "kind": "title_card",
          "text": "数字の王国"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "２００７…年？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "鼓動が速くなるのを感じる。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一生で一度きりのチャンスかもしれない。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は軽く頷いた。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…「ストーム」って知ってる？"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "あなたたちは、あれを「ストーム」と呼んでるんだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "ここでは「エマネーション」と呼ばれているの。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "プネウマの海水は今なお流れ、集水してゆく。それらはやがて津波をもたらし、闇に満ちた現象界を粉々にするんだよ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…よくわからない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は顔を傾げ、同じく理解しがたいといった表情を浮かべた。"
        },
        {
          "kind": "dialogue",
          "speaker": "？？？",
          "text": "あなたも実数だから、わかるでしょう。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "わたしは３７。あなたの数字は？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "わたしはヴェルティ。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "それじゃなくて、あなたの数字。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "教典によると、己の本質を理解できない者だけが無意味な音声記号で自己を表現してるんだって。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "うーん、そっか。あなたもまだ自分の数字がわからないんだね…じゃあ、ソフィアとおんなじだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女の言葉はなんとも理解しがたいものだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "だが、目下最大の問題は別にあった。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "ソネット、レグルス、リーリャ、ミス・ラジオ、そして「カミソリ」は…どこに？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "わたしの仲間を見なかった？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "もちろん見たよ！"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "あなたが探しているのは整数？　分数？　無理数？　それとも虚数？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…え？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "素晴らしい道徳心を持つ整数、理解経路が必要な分数、束縛なき自由な心の無理数、軸の向こう側に存在する虚数。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "あなたが探してるのはどれ？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…質問を変えよう。ここはどこ？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "島。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…なんていう島？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "ここ以外にも島があるの？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "はぁ…質問を変えるよ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "１９９９年、ウルドって名前の伝記作家がこの島を訪れなかった？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は考え込んだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "１９９９…ああ！"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "可愛い中心つき三角数の１９９９ね。けど、終末論で濫用されすぎじゃない？　ようするに、みんなにおだてられすぎだってこと。１９９１と１９９３に比べれば、１９９９なんて大したことないのに…"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "でも９９９は最高！　カプレカ数であり、回文数である上に、３桁の自然数における最大値なんだから…"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…話を遮るようで悪いけど、ウルドを知ってるか聞きたいだけ。彼女が１９９９年にこの島を訪れた記録が、旅行記『アペイロン漫歩』に載ってたんだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "何か覚えてる？"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "いいえ。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女も同じように首を振った。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "現象界の塵埃については、何も知らないの。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "現象界の…塵埃…？"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "だ…誰か！！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "慌ただしい怒鳴り声が後ろから聞こえた。"
        },
        {
          "kind": "dialogue",
          "speaker": "APPLe",
          "text": "ゴホッ、船長…どうやらこの腕はもう…先に行ってください…"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "いやいや、しっかりしろ！"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "あっちいけ！　この忌ま忌ましいイルカどもめ！　APPLeは食いもんじゃない！　あたしのレコードもな！"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "…あれ、ヴェルティ！？"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "つったってないで、はやく手伝ってくれ！"
        }
      ]
    },
    {
      "script_id": "100509",
      "internal_title": "第五章5-6.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "ふぅ…助かったぜ、ヴェルティ〜！　危うくAPPLeとレコードがスターゲイジー・パイになっちゃうとこだった！"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "ううん。おかげでわたしも助かったよ。"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "…あたし、なんかしたっけ？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "うん。コミュニケーションの自信を取り戻した。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "ソネットたち、見かけなかった？"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "いんや。目を覚ましたら、イルカの背中の上だったからな。"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "礼を言おうとした矢先、あいつら噛むわ叩くわ！"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "それは、あなたが無理数だからだよ！"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "うわっ、びっくりした！　このロングヘアの嬢ちゃんは誰だ？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "遠くから、聞き慣れた声がした。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "タイムキーパー！"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "よかった…皆さんご無事で！"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "ミス・リーリャももうすぐこちらへ来ます。あとは、隊長たちだけです…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "嬉しそうに報告をする彼女の傍らに、見知らぬ姿があった。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "ソネット、そちらの方は…？"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "彼らはアペイロン教団の信者です。沈没事故の後、私たちに救いの手を差し伸べてくれました。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "ローブ姿の者たちは黙って立っている。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "そのうちの一人がようやく口を開いた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "いやはや、整数同士、当然のことをしたまでです。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "ミス・ソネット、お仲間は全員見つかりましたか？"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "はい。あとは「カミソリ」の隊員たちだけ…彼らも私たちと同じ、聖パブロフ財団に属していて…"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "虚数は私たちの救助対象者に含まれません。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "…虚数？"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "お仲間が見つかったのでしたら、あまり長居しない方がよいでしょう。すぐに船を手配します。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "教団は招待客以外は歓迎できないので。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "お待ちください。お聞きしたいことが…"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…「エマネーション」に関する情報を提供すると言ったら？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "男性は一瞬立ちすくんだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "わたしたちは聖パブロフ財団の調査員。「ストーム」の情報を提供しましょう。…ここでは、「エマネーション」と言うべきかな。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "話し合いの場を要請します。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "タイムキーパー…？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…あとで説明するから。今は信じてほしい、ソネット。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "ローブを着た者たちは、コソコソと話し合っている。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "上陸を認めましょう。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "ですが、整数と分数以外は接待いたしません。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "男はその指をレグルスに向けた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "無理数は上陸を禁じます。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "…海に放っておけ！"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "…へ？"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "ちょっ、待っ…おい！"
        },
        {
          "kind": "dialogue",
          "speaker": "レグルス",
          "text": "――！"
        },
        {
          "kind": "title_card",
          "text": "TO BE CONTINUED…"
        }
      ]
    }
  ],
  "fallback_fields": []
}