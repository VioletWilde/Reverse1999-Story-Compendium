  "segments": [
    {
      "script_id": "100518",
      "internal_title": "第五章5-12.1",
      "items": [
        {
          "kind": "title_card",
          "text": "鳥の行く道"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "教団の信者が次々と入場する。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "被告人と弁護人はすでに席についていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "……"
        },
        {
          "kind": "choice",
          "speaker": "",
          "text": "…大丈夫？",
          "edge_label": "…大丈夫？",
          "branch": []
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "…ご安心ください、タイムキーパー。自らの口で弁明します。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女の顔色は青白いが、それでも前を見据えていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "財団での、同じような公開裁判で勝ったことがあります…"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "今回の出来事は私の責任です。決してタイムキーパーにはご迷惑をかけません。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "ソネット…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "ソネットは黙ってうつむき、伝道の間の中央へと向かった。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "――かつてのように。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "裁判官は背筋を伸ばして座っていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "本来ならば、ミス・ソネットには毒酒が与えられ、永久に口を閉ざしていただくのが定め。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "ですが、ソフィアから異議申し立てがあったため、この公開裁判にて民衆に判決を下していただきます。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "死刑に同意する者はその場で待機を、減刑に同意する者は玉石を中央のツボに投げ入れること。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "では、ミス・ソネット、ミス・ヴェルティ。弁護を開始しなさい。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "…制限時間は、この砂時計の砂が尽きるまで。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "そう、決して勝算のない戦いではない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "リラックスして、深呼吸。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "訓練の時と同じだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "私は聖パブロフ財団から来ました、ソネットです。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "人道主義の原則のもと、私の弁護をお聴き…"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "あなたの数字は？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "舞台の下から、鋭い声が響いた。"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "お答えください。あなたの具体的な数字は？"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "え？　…私の？"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "あの、私には数字はなくて…"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "話にならんな。数字なき者が真理の殿堂に足を踏み入れるなど、あってはならん！"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "彼女の発言は無効に等しい！　そのまま死刑を実行しよう！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "群衆から賛同の声が溢れる。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "裁判官は石鎚を叩いた。"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "４２の証明は聞き入れられました。弁護人、何か反論は？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…え、それが通るの！？"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "あ…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "ソネットの顔から血の気がひいた。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "すべての正義、公正、模擬訓練がこの瞬間無効となった。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "ここから先は未知の領域だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "異議あり！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "小柄な少女が立ち上がった。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "記録によると、教団の最後の処刑は１９８０年、豆を食べた異邦人に下された。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "豆を食べたカーバンクルを食べたことで、集合論に基づいて、禁忌に触れたと書いてあります。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "すべての教典において、豆を食べることは、最も重大な罪。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "もし、沈黙を破ることで死刑となるのならば、豆を食した一件が最も重い罪ではなくなってしまう。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "なので、ソネットの減刑を要求します！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "群衆がざわめく。"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅱ",
          "text": "…賢い切り口だな…"
        },
        {
          "kind": "dialogue",
          "speaker": "６",
          "text": "３７の証明は聞き入れられました。弁護を続けてください。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "３７は得意気に座った。すぐに、大柄な姿がのっそりと立ち上がった。"
        },
        {
          "kind": "dialogue",
          "speaker": "２１０",
          "text": "俺は反対だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "２１０",
          "text": "豆を食した罪人は永劫回帰のゴルゴン海流に投げ込まれる。沈黙を破った者は毒酒を与えられ、未来永劫口を閉ざす。"
        },
        {
          "kind": "dialogue",
          "speaker": "２１０",
          "text": "どの処刑においても、前者より恐ろしいものはない。"
        },
        {
          "kind": "dialogue",
          "speaker": "２１０",
          "text": "我々にとって、最も未知なるものは永劫と無限であり、処刑において最も恐ろしいものも永劫と無限だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "２１０",
          "text": "よって、毒酒は決して豆事件を軽くさせることはない。３７の弁護は無効だ。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "石鎚が打たれるより先に、反対の声が響いた。"
        },
        {
          "kind": "dialogue",
          "speaker": "３７",
          "text": "異議あり！　どちらも基準系での落下点は同じ、最終的に「死」に至ることに変わりはない！"
        },
        {
          "kind": "dialogue",
          "speaker": "２１０",
          "text": "異議あり！　その言い方は最も基本的な通約不可能性に反してる！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "裁判は徐々に白熱していく。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "群衆はしきりに動きまわり、ツボの中にたくさんの玉石が貯まった。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "…どういう…"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "ま…まったく理解できません…この裁判…あまりに非理性的で…"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…なるほど。"
        },
        {
          "kind": "dialogue",
          "speaker": "ソネット",
          "text": "…タイムキーパー？"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "あとはわたしに任せて。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "深呼吸をし、右手を上げる。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "これは抽象的な論議戦だ。そこには現実も、正義も、理性もない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "勝利しかないのだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "異議あり！"
        }
      ]
    },
    {
      "script_id": "100519",
      "internal_title": "第五章5-12.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "排中律…すばらしい弁護だ。たった一言でパラドックスにまで行きつくとは。"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "だが、残念ながら、君は致命的な過ちを犯した。"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "君は私の観点を受け入れ、それを弁護の基礎とした。「数字なき者は真理の殿堂に足を踏み入れる資格がない」"
        },
        {
          "kind": "dialogue",
          "speaker": "信者Ⅰ",
          "text": "君にも数字はないね、異邦人のお嬢さん。これを基礎とするならば、先ほどの発言はすべて無効となるだろう！"
        },
        {
          "kind": "dialogue",
          "speaker": "ヴェルティ",
          "text": "…うっ！"
        },
        {
