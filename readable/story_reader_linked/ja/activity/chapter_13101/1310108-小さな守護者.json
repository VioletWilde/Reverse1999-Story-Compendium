  "segments": [
    {
      "script_id": "200310",
      "internal_title": "【1.3】印度观星-9.1",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "一同は庭にある大きな陶器の樽の前に集まった。"
        },
        {
          "kind": "dialogue",
          "speaker": "シャーマィン",
          "text": "本当に…これを使うのか？"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "何か問題でも？　水の量はちょうどいいし…私もすっぽりと入るわ。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "シャーマィンは古ぼけた樽に漂う落ち葉と汚れを見つめ、しばらく沈黙に陥った。"
        },
        {
          "kind": "dialogue",
          "speaker": "シャーマィン",
          "text": "ふむ、実用性に対する追求は俺以上だな。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "そうだ、あと…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "カーラ・ボナーはヴィシュヌの神像をマチルダに渡した。"
        },
        {
          "kind": "dialogue",
          "speaker": "マチルダ",
          "text": "え？　ミス・カーラ・ボナー、これは持っていかないの？"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "ええ、いらないわ…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は首を横に振った。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "ミスター・シャーマィンの話は…確かに正しい。これは私たちにとっての切り札。クマールからは距離を置いた方がいい。"
        },
        {
          "kind": "dialogue",
          "speaker": "マチルダ",
          "text": "ふぅん…"
        },
        {
          "kind": "dialogue",
          "speaker": "マチルダ",
          "text": "じゃあ、これを持っていって！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "差し伸べられた鉱石は透き通っていて、まるで空から摘んできた星屑のようだった。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "…これはあなたの…"
        },
        {
          "kind": "dialogue",
          "speaker": "マチルダ",
          "text": "わたしのペンデュラムよ！　コレクション級の、純度がとっても高い珍しい水晶なの！　こんなにいいもの、わたしだって何個も持ってないんだから…"
        },
        {
          "kind": "dialogue",
          "speaker": "マチルダ",
          "text": "あなたが言っていた瞑想理論、水晶占いの理論根源と一部似てるって気づいたの。だから水晶があなたの磁場を平衡にして、意識の方向を導いてくれたら…きっとうまく行くはず――"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "あなた…"
        },
        {
          "kind": "dialogue",
          "speaker": "マチルダ",
          "text": "ふっふーん。驚かないで、天才にとっちゃ当たり前の反応スピードよ！"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "…ありがとう。"
        },
        {
          "kind": "dialogue",
          "speaker": "シャーマィン",
          "text": "はは。どうやら「水中で瞑想」する行為を理解できないのは俺だけみたいだな――山容はさまざまな姿を持ってるもんだ…そりゃ神秘学家も千差万別ってな。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "カーラ・ボナーは足を陶器の樽に入れた。まるで冷たさを感じていないようだった。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "うん…ペンデュラムと、充分な液体…"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "あと、必要なのは…"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "――クマールを思うこと。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "両足を支える力を抜いて、カーラ・ボナーは体を水中に潜り込ませた。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女の世界から音が遠のく。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "寒気が頭上まで登り、四面八方から襲ってくる。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "はぁ…っ！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "現実と幻想、真実と虚構の境界が曖昧になり――世界が再び目の前に現れた。"
        },
        {
          "kind": "title_card",
          "text": "？？？"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "…やっぱり、ここだった。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "私たちが初めて出会った場所。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "目の前にある見慣れた石階段は記憶にあるものより長かった。粗い赤レンガ、計算された丸い曲線。ジャンタル・マンタルには独特な美しさがあった。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "ふふ。クマールはこの再会に相当思い入れがあったようね。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "瞑想者の領域にここまで再現するなんて…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "頂点の果てで静かに立っている人影はまるで、黒い特異点のようだった。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女が誰なのか、知っている。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "心の幻、でしかない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "左足で石階段の一段目を踏んだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "想定していた困難が目の前に現れた。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "どうやら私の小さい頃の姿をよく覚えてたみたいね。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "目の前を阻む人影は、彼女の小さい頃とよく似ていた。ずっと拳を握っていて、何かに対抗するような表情をしている。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "どうやら今、「彼女」の怒りは招かれざる客の侵入に向けられているようだ。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "「彼女」はカーラ・ボナーの方へ走った。拳を機敏に振り回しながら。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "うっ、痛い…！"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "私って小さい頃、こんなに強かった？"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "出てけ！　ここはあなたが来る場所じゃない！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "「彼女」はカーラ・ボナーを追い出した。明らかに鍛えられていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "ああ…そうだった。お母さんから…近所の悪ガキに対抗する技を教えてもらったんだっけ。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "出てけ！"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "…うう、なんか…変な感覚。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "クマールからここにいろって言われたの？　あなたが…この頃の記憶を守るように？"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "あなたを倒さないと、前には進めないみたいね。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "いいわ、過去の幻影と向き合いましょう。"
        }
      ]
    },
    {
      "script_id": "200311",
      "internal_title": "【1.3】印度观星-9.2",
      "items": [
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "あ…"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "幻影は消えたかと思うと、再び遠くに現れた。前とは違い、「彼女」はもう強烈な怒りに支配されてはいなかった。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "ふふ…"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "……！"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "天文台の人影は「彼女」を徐々に霞ませ、その声の輪郭もぼんやりと遠くなっていった。"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "過去から、現在、そして未来…"
        },
        {
          "kind": "dialogue",
          "speaker": "幻影",
          "text": "あなたが執着、追求、対面しているのは…なに…"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "……"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "カーラ・ボナーは俯き、己の手のひらを見つめた。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "変わらず、答えのない質問をするのね。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "私が追求しているのは「何であるべき」だと思う？"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "彼女は指をしまい、そっと手を握りしめる。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "惑わさないで、クマール。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "天文学の道を、あの日から諦めたことなんてない。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "だだっ広い空間には、やまびこ以外何も残っていない。幻影はすでに去っていた。"
        },
        {
          "kind": "dialogue",
          "speaker": "",
          "text": "カーラ・ボナーは頭を上げ、頂点が見えない天へと伸びる階段を見つめた。"
        },
        {
          "kind": "dialogue",
          "speaker": "カーラ・ボナー",
          "text": "…前へ進もう。"
        },
        {
          "kind": "title_card",
          "text": "3#1"
        }
      ]
    }
  ],
  "fallback_fields": []
}