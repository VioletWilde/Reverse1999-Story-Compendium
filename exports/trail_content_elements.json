    {
      "element_id": 1051202,
      "content": [
        {
          "type": "line",
          "speaker": "",
          "text": "是的，是的，當之無愧的勝利者。",
          "text_key": "language_10004786"
        }
      ]
    },
    {
      "element_id": 1051401,
      "content": []
    },
    {
      "element_id": 1051501,
      "content": [
        {
          "type": "line",
          "speaker": "",
          "text": "他們終會明白數學的美妙。",
          "text_key": "language_10004796"
        }
      ]
    },
    {
